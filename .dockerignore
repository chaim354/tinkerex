# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files, and the install files the image never needs (the compose files
# and the Unraid template describe how to RUN the image; they are not part of it).
/.dockerignore
/Dockerfile*
/docker-compose*.yml
/unraid/

# Rust sync-client workspace — NOT part of the Rails server image. ~15 GB of build
# artifacts (client/*/target) + source that the server never builds or ships (it
# references files only by node_id). Excluding it cuts the build context from ~8 GB
# down to tens of MB.
#
# tools/stl-thumbnailer is deliberately NOT excluded by this: the image DOES compile it
# (see the Dockerfile's stl-thumbnailer stage), because Maker::Previews::Stl execs the
# resulting binary server-side. It used to live under client/stl-thumbnailer, which is why
# this file once carried a re-include exception (`!/client/stl-thumbnailer`) — that crate
# is a server-side tool that was misfiled under client/, not a client dependency, so it
# moved to tools/ instead of needing a permanent carve-out here.
/client/

# Docs, tests, CI runners, and dev scripts aren't needed in the production image.
/docs/
/test/
/ci/
/scripts/

# GPL sidecar images (sidecar/boxes = GPL-3.0, sidecar/openscad = GPL-2.0) are built + pushed
# SEPARATELY, each from its own directory as build context. The Rails Dockerfile does `COPY . .`,
# so without this line the copyleft trees are baked into the PERMISSIVE app image — never imported
# or executed, but shipped, which is exactly what CLAUDE.md §9 exists to prevent.
/sidecar/

# Claude Code session state + agent git worktrees (full repo checkouts, ~700 MB).
/.claude/

# macOS cruft, incl. the "* 2" duplicate-file problem noted in CLAUDE.md §13
# (a stray duplicate once broke a build).
**/.DS_Store
**/* 2.*
**/* 2
/library/
