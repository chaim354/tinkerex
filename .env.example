# Tinkerex, docker compose configuration. Copy this file to .env and fill in the three settings at
# the top; docs/INSTALL.md explains each line here and every other variable the app reads.
#
# docker compose reads .env twice: for the ${...} substitutions in docker-compose.yml, and as the
# web container's environment (env_file). Lines starting with # are ignored. Put a comment on its
# own line, never after a value.

# Signs sessions and cookies. Generate once with: openssl rand -hex 64
# Keep it; changing it signs everyone out.
SECRET_KEY_BASE=

# The folder on this machine that holds (or will hold) your files. It is mounted into the
# container at /library and must be writable by user id 1000, which the container runs as
# (sudo chown -R 1000:1000 /path/to/files if that is not already your own uid). A relative path
# is resolved against this directory.
LIBRARY_HOST_PATH=./library

# The host name or address people type to reach this server, with no scheme, e.g.
# maker.example.net or 192.168.1.20. Links in email point at it.
APP_HOST=

# The host port the web app is published on, so http://<host>:8080 by default.
TINKEREX_PORT=8080

# Puma threads and the database pool. 16 is what the author runs; the Rails default is 3.
RAILS_MAX_THREADS=16

# Background work (scans, thumbnails, trash purge, project intake) runs inside the web container by
# default in production, so SOLID_QUEUE_IN_PUMA needs no line here. Set SOLID_QUEUE_IN_PUMA=false
# only if you run a separate bin/jobs container.

# ---- Reached over HTTPS through a reverse proxy? Then set this; without TLS in front it locks you out.
# FORCE_SSL=1

# ---- Accounts and mail (docs/INSTALL.md section 4) ----
# closed (the default in production) means only the first account, the owner, can sign up. open is
# refused at boot on the share and s3 backends, where every account indexes the same library.
# REGISTRATION=closed
# Mail is off until SMTP_ADDRESS is set; the rest have the common defaults shown.
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USER_NAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=
# SMTP_AUTHENTICATION=plain
# SMTP_STARTTLS=true
# MAIL_FROM=
# A public demo: one click on the sign-in page signs visitors into the shared account named here,
# which is destroyed and re-seeded every night at 04:00 UTC. On share and s3 every account indexes
# the same library, so set it only on a server that holds nothing else. Create the account once with
#   docker compose exec web bin/rails tinkerex:demo:setup
# DEMO_ACCOUNT_EMAIL=
# The largest single file the demo account may upload, in bytes (25 MB).
# DEMO_MAX_UPLOAD_BYTES=26214400

# ---- Days a deleted file stays in .trash/ before the daily purge (0 keeps everything forever) ----
# LIBRARY_TRASH_DAYS=30

# ---- The Tools gallery (docs/INSTALL.md section 3) ----
# Uncomment these three when starting with --profile tools, or put COMPOSE_PROFILES=tools here to
# make the profile the default. The addons image is built from a sibling checkout of
# chaim354/tinkerex-addons; TINKEREX_ADDONS_PATH points elsewhere if yours is not at ../tinkerex-addons.
# BOXES_SIDECAR_URL=http://boxes:8000
# OPENSCAD_SIDECAR_URL=http://openscad:8000
# ADDON_SOURCE_URL=http://addons
# TINKEREX_ADDONS_PATH=../tinkerex-addons
# COMPOSE_PROFILES=tools

# ---- The sync server (docs/INSTALL.md section 5; docker-compose.chunk_remote.yml) ----
# Built from a sibling checkout of chaim354/tinkerex-sync. COMPOSE_FILE saves typing the two -f
# flags on every command.
# TINKEREX_SYNC_PATH=../tinkerex-sync
# TINKEREX_SYNC_PORT=3001
# COMPOSE_FILE=docker-compose.yml:docker-compose.chunk_remote.yml
# The sync server's own session secret: openssl rand -hex 64
# SYNC_SECRET_KEY_BASE=
# Shared by the app and the sync server, one value: openssl rand -hex 32
# SYNC_ADMIN_TOKEN=
# The address your other devices reach the sync server at, scheme included: this host and
# TINKEREX_SYNC_PORT (e.g. http://192.168.1.10:3001), or a reverse proxy's name for that port.
# The desktop app is handed it when it signs in.
# SYNC_PUBLIC_URL=
# Encrypt each account's sync credential in the database: openssl rand -hex 16 each. Keep them
# with your backups; losing them makes every stored sync credential unreadable.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ---- A pre-built image instead of building from this checkout ----
# Once the package is public: set this, then docker compose pull and docker compose up -d (no --build).
# TINKEREX_IMAGE=ghcr.io/chaim354/tinkerex:latest

# Never set RAILS_MASTER_KEY (docs/INSTALL.md section 9).
