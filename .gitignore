# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files -- except the committed template a new install copies to .env.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


# macOS
.DS_Store

# Built/downloaded desktop app artifacts (produced by build-app.yml; never source)
*.dmg
*.app.zip

# Local agent tooling/plans. Everything under .claude/ stays local EXCEPT commands/: those are
# project workflow (they invoke bin/ci, kamal, and this repo's branch conventions), so they belong
# to the repo. They also have to be TRACKED to exist in a git worktree at all — a worktree checks
# out tracked files only, so an ignored .claude/commands/ is invisible from every worktree, which
# is where most agent work on this repo actually happens.
.claude/*
!.claude/commands/
.superpowers/

# The compose file's default library folder, created beside it on the first start (docs/INSTALL.md section 3).
/library/
