<%#
  Filter the library by file type. Clicking a chip switches to a FLAT, whole-library list of that
  type; chips compose, so "all my STLs and 3MFs" is two clicks. Rendered in both modes, so a
  filter can be started from inside a folder (and immediately leaves it — see #index).
%>
<div class="ext-filter">
  <% FilesHelper::EXT_FAMILIES.each do |family, exts| %>
    <span class="ext-family" aria-label="<%= family %>">
      <span class="muted family-label"><%= family %></span>
      <% exts.each do |ext| %>
        <% active = @exts.include?(ext) %>
        <% if active || ext_slots_left?(@exts) %>
          <%# aria-current, NOT aria-pressed. These chips are LINKS (a GET, a shareable URL), and
              aria-pressed is only supported on role=button — on a link it is invalid ARIA that a
              screen reader is free to ignore, which would leave the active state announced by
              nothing but a colour. aria-current is valid here and is what the breadcrumb above
              already uses. %>
          <%= link_to ".#{ext}", ext_toggle_path(ext, @exts),
                      class: "chip#{' active' if active}",
                      "aria-current": (active ? "true" : nil) %>
        <% else %>
          <%# THE SET IS FULL. Linking this would produce a URL that appends a 9th extension the
              controller then drops (resolve_exts keeps the first MAX_EXTS) — the chip would look
              live, navigate, and change nothing. A span with aria-disabled says why instead. %>
          <span class="chip disabled" aria-disabled="true"
                title="Turn one off first — at most <%= FilesController::MAX_EXTS %> types at a time.">.<%= ext %></span>
        <% end %>
      <% end %>
    </span>
  <% end %>

  <%# Anything the curated list has never heard of (.f3d, .scad). One GET field; the controller
      joins add_ext onto ext, so there is still exactly one filter param. `pattern` is a hint to
      the browser, never the guard — FilesController::EXT_RE is, because a GET URL reaches the
      action without ever passing through this form. %>
  <form method="get" action="<%= files_path %>" class="ext-other">
    <% if @exts.any? %><input type="hidden" name="ext" value="<%= @exts.join(',') %>"><% end %>
    <input type="text" name="add_ext" placeholder="or an extension…" size="12"
           aria-label="Filter by another extension" pattern="[A-Za-z0-9]{1,8}">
    <button type="submit" class="linkbtn">Filter</button>
  </form>

  <% if @exts.any? %>
    <%# No sort params, for the reason ext_toggle_path gives: the sort is in a cookie, so pinning
        it here only bakes a stale choice into a URL someone copies. %>
    <%= link_to "Clear filter", files_path, class: "muted clear-filter" %>
  <% end %>
</div>
