<%# LightBurn laser "recipe" panel, shown beside the preview on a .lbrn/.lbrn2 file page.
    `meta` is the parsed Hash from Maker::Previews::LbrnMetadata (string keys). Every field is
    optional — render only what's present. %>
<section class="lbrn-settings">
  <div class="lbrn-head">
    <h2>Laser settings</h2>
    <% if meta["app_version"].present? %><span class="muted">LightBurn <%= meta["app_version"] %></span><% end %>
  </div>

  <% if meta["layers"].present? %>
    <table class="lbrn-layers">
      <thead>
        <tr><th>Layer</th><th>Mode</th><th class="num">Speed</th><th class="num">Power</th><th class="num">Passes</th></tr>
      </thead>
      <tbody>
        <% meta["layers"].each do |layer| %>
          <tr>
            <td>
              <% if layer["color"].to_s.match?(/\A#[0-9a-fA-F]{3,8}\z/) %><span class="lbrn-swatch" style="background: <%= layer["color"] %>"></span><% end %>
              <%# THREE ANSWERS, IN ORDER, AND THE LAST ONE IS NOT DECORATION.
                  1. A name its owner chose ("Score lines") beats everything — substituting a
                     colour over it would destroy information rather than add any.
                  2. Otherwise the colour's name, since LightBurn's default "C01" tells a reader
                     nothing the swatch beside it does not already show.
                  3. Otherwise the file's own name, VERBATIM. This arm is reached when a file
                     overrides a layer's colour, so there IS no palette name — and reconstructing
                     the label as "C#{index}" instead loses LightBurn's zero padding, turning
                     "C00" into "C0". A pre-existing flow test caught exactly that.
                  The index stays reachable as a tooltip, since it is how LightBurn's own UI
                  refers to the layer. %>
              <% file_name = layer["name"].to_s %>
              <% chosen = file_name.present? && !file_name.match?(/\AC\d+\z/) %>
              <span title="Layer C<%= layer["index"] %>"><%=
                chosen ? file_name : (layer["color_name"].presence || file_name.presence || "C#{layer["index"]}")
              %></span>
            </td>
            <td><%= layer["mode"] %></td>
            <%# recipe_num, never `.to_i` — that truncated 6.67 mm/s to "6". See FilesHelper. %>
            <td class="num"><%= "#{recipe_num(layer["speed"])} mm/s" if recipe_num(layer["speed"]) %></td>
            <td class="num">
              <% if recipe_num(layer["power_max"]) %>
                <%= recipe_num(layer["power_max"]) %>%<% if layer["power_min"] && layer["power_min"] != layer["power_max"] %> <span class="muted">/ <%= recipe_num(layer["power_min"]) %>%</span><% end %>
              <% end %>
            </td>
            <td class="num"><%= layer["passes"] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if meta["pages"].present? %>
    <%= render "files/recipe_pages", pages: meta["pages"] %>
  <% end %>

  <dl class="lbrn-summary">
    <%# A multi-page file has a size per page, in the table above, and no single job size. %>
    <% if meta["pages"].blank? && meta.dig("job", "width") %><dt>Job size</dt><dd><%= recipe_num(meta["job"]["width"]) %> × <%= recipe_num(meta["job"]["height"]) %> mm</dd><% end %>
    <% if meta["material_height"] %><dt>Material</dt><dd><%= recipe_num(meta["material_height"]) %> mm</dd><% end %>
    <% if meta["machine"].present? %><dt>Machine</dt><dd><%= meta["machine"] %></dd><% end %>
    <% if meta["shape_count"] %><dt>Layers / shapes</dt><dd><%= Array(meta["layers"]).size %> / <%= meta["shape_count"] %></dd><% end %>
  </dl>

  <% if meta["text"].present? %>
    <p class="lbrn-text muted">Text: <%= meta["text"].map { |t| "“#{t}”" }.join(", ") %></p>
  <% end %>
</section>
