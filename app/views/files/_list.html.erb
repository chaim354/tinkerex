<%#
  List (table) view. Size/Version come from @info_by_node (FileLayer::FileInfo), not Version rows:
  on share and s3 there are none. See show.html.erb's header for why `capabilities` is called
  rather than dereferenced off an ivar with `&.`.
%>
<table class="files" data-controller="thumbs filemenu" data-thumbs-url-value="<%= thumbnails_files_path %>">
  <thead>
    <tr>
      <%= sort_header "Name", "name", @sort, @dir, files_query_base %>
      <%= sort_header "Type", "type", @sort, @dir, files_query_base %>
      <% if @flat %><th>Folder</th><% end %>
      <%# Size is NOT sortable, and that is deliberate: it is the one column whose value does not
          come from `nodes` on every backend (Chunk#stat_all reads it from the versions row), so a
          size sort would be the only inexact one — worse than none in a column of exact-looking
          numbers. See the spec, §5.3. %>
      <th class="num">Size</th>
      <% if capabilities.versioned? %><th>Version</th><% end %>
      <%= sort_header "Modified", "modified", @sort, @dir, files_query_base %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @nodes.each do |node| %>
      <% info = @info_by_node[node.node_id] %>
      <tr>
        <td>
          <% if node.file? %>
            <%# Only a file this deployment can actually thumbnail gets a preview cell. A
                non-renderable file (pdf, txt, image, ...) renders as a plain name link, exactly
                as before — no thumbnail, and crucially no spinner the poll would chase forever. %>
            <% if Maker::Previews::Registry.for_filename(node.name).present? %>
              <% thumb = @thumb_by_node.thumb(node.node_id) %>
              <% ext_label = File.extname(node.name).delete(".").upcase.first(4) %>
              <%# data-download-url puts "Download" in the right-click menu (filemenu#open). The
                  same blob URL the row's own Download link uses, ?download=1 and all, so the two
                  cannot answer differently. Folders get neither — they have no contextmenu action
                  at all, which is what keeps a "Download" off a directory.

                  data-addon-open-url and data-addon-open-label are the same mechanism for "Edit in
                  the addon that made this file". @addon_origins has no key for anything an addon
                  did not produce, so both values are nil, Rails renders NO attribute, and the menu
                  simply has no entry — the way every surface here opts out. The two always travel
                  together (one hash, built once in AddonOrigins), so the label can never go missing
                  from a cell that has the url. %>
              <%= link_to file_path(node.node_id), class: "file-cell",
                          data: { thumbs_target: "cell", node_id: node.node_id, ext: ext_label,
                                  action: "contextmenu->filemenu#open", note_url: file_notes_path(node.node_id),
                                  download_url: blob_file_path(node.node_id, download: 1),
                                  addon_open_url: @addon_origins.dig(node.node_id, :url),
                                  addon_open_label: @addon_origins.dig(node.node_id, :label) } do %>
                <%= render "thumb", thumb:, ext_label: %>
                <span class="file-name"><%= node.name %></span>
              <% end %>
            <% else %>
              <%= link_to node.name, file_path(node.node_id),
                          data: { action: "contextmenu->filemenu#open", note_url: file_notes_path(node.node_id),
                                  download_url: blob_file_path(node.node_id, download: 1),
                                  addon_open_url: @addon_origins.dig(node.node_id, :url),
                                  addon_open_label: @addon_origins.dig(node.node_id, :label) } %>
            <% end %>
            <%= render "note_badge", count: @note_counts[node.node_id] %>
          <% else %>
            <%# A folder row navigates INTO the folder (?folder=<node_id>), it does not open a
                file preview. Same node_id key #index scopes children on. %>
            <%= link_to "📁 #{node.name}", files_path(folder: node.node_id), class: "dir" %>
          <% end %>
        </td>
        <%# The EXTENSION, not node.kind — see FilesHelper#file_type_label for why the cell under
            a "Type" header cannot go on saying "file". %>
        <td class="muted"><%= file_type_label(node) %></td>
        <%# Where this file actually lives — a flat list without it is unnavigable. The link goes
            to that folder, so the flat view doubles as a way to FIND things. A file at the
            library root has no path, so it names the root the breadcrumb already calls "Files". %>
        <% if @flat %>
          <td class="muted">
            <%= link_to(@folder_paths[node.node_id].presence || "Files",
                        files_path(folder: node.parent_node_id)) %>
          </td>
        <% end %>
        <td class="num muted"><%= info.content_token ? number_to_human_size(info.size) : "—" %></td>
        <% if capabilities.versioned? %>
          <td class="muted mono"><%= info.content_token&.first(8) || "—" %></td>
        <% end %>
        <td class="muted"><%= info.mtime ? Time.at(info.mtime / 1_000_000_000).strftime("%Y-%m-%d %H:%M") : "—" %></td>
        <td class="row-actions">
          <% if node.file? %>
            <%= link_to "Download", blob_file_path(node.node_id, download: 1) %>
          <% end %>
          <%= button_to "Delete", file_path(node.node_id), method: :delete,
                form: { data: { turbo_confirm: "Delete #{node.name}?" } }, class: "linkbtn danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
