<%#
  List (table) view. Size/Version come from @info_by_node (FileLayer::FileInfo), not Version rows:
  on share and s3 there are none. See show.html.erb's header for why `capabilities` is called
  rather than dereferenced off an ivar with `&.`.
%>
<table class="files" data-controller="thumbs filemenu stack" data-thumbs-url-value="<%= thumbnails_files_path %>">
  <thead>
    <tr>
      <%= sort_header "Name", "name", @sort, @dir, files_query_base, col: "col-name" %>
      <%= sort_header "Type", "type", @sort, @dir, files_query_base, col: "col-type" %>
      <% if @flat %><th class="col-folder">Folder</th><% end %>
      <%# Size is NOT sortable, and that is deliberate: it is the one column whose value does not
          come from `nodes` on every backend (Chunk#stat_all reads it from the versions row), so a
          size sort would be the only inexact one — worse than none in a column of exact-looking
          numbers. See the spec, §5.3. %>
      <th class="num col-size">Size</th>
      <% if capabilities.versioned? %><th class="col-version">Version</th><% end %>
      <%= sort_header "Modified", "modified", @sort, @dir, files_query_base, col: "col-modified" %>
      <th class="col-actions"></th>
    </tr>
  </thead>
  <%# WHAT THE PAGE DRAWS, IN ORDER (FilesController#index's @figures): a file or folder that
      stands alone is its row, a version stack is its stack row with its members beneath it
      (files/_list_stack). ONE tbody, so the table's rules and the selection read every row. %>
  <tbody>
    <% @figures.each do |figure| %>
      <% if figure.is_a?(Maker::VersionStacks::Stack) %>
        <%= render "files/list_stack", stack: figure %>
      <% else %>
        <%= render "files/list_row", node: @node_by_id[figure], member: nil %>
      <% end %>
    <% end %>
  </tbody>
</table>
