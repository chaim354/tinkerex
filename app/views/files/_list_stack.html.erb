<%# locals: (stack:) %>
<%#
  ONE VERSION STACK IN THE LIBRARY'S LIST (Shop manual spec §9): one row
  that stands for every member, then the members beneath it, hidden until the row is opened.

  THE ROW OPENS IN PLACE, NEVER NAVIGATES. Its name is a button (stack_controller.js#toggle, on the
  table) whose `aria-controls` names every member row, so the stack opens where it stands and a
  screen reader hears it expand. A stack is not a file, so the button is not a selection item and
  carries no file menu; its members are, each the row a file standing alone would be
  (files/_list_row). The row's facts, its picture and its Details and Download are the LATEST
  member's (Maker::VersionStacks: the newest that is not a backup or a copy), and their names say
  which file they act on.
%>
<% latest = @node_by_id[stack.latest.node_id] %>
<% info = @info_by_node[latest.node_id] %>
<% dom = stack_dom_id(stack) %>
<% member_ids = stack.members.each_index.map { |i| "#{dom}-#{i}" } %>
<% thumb = @thumb_by_node.thumb(latest.node_id) %>
<% renderable = thumb_cell?(latest.name, thumb) %>
<% ext_label = File.extname(latest.name).delete(".").upcase.first(4) %>
<tr class="stack-row">
  <td class="col-name">
    <%= tag.button(type: "button", id: "#{dom}-toggle", class: "stack-toggle file-cell",
                   aria: { expanded: "false", controls: member_ids.join(" ") },
                   data: (renderable ? thumb_cell_data(latest.node_id, ext_label) : {}).merge(action: "stack#toggle")) do %>
      <% if renderable %>
        <%= render "thumb", thumb:, ext_label:, url: preview_src(thumb), photo: photo_tile?(latest.name) %>
      <% end %>
      <%# The name and its chip in one box, so a narrow column wraps them as words rather than
          squeezing the name to a letter a line beside a chip that cannot shrink. %>
      <span class="stack-label"><span class="file-name stack-name"><%= stack.name %></span> <span class="badge stack-count"><%= stack_count_label(stack) %></span></span>
    <% end %>
  </td>
  <td class="muted col-type"><%= file_type_label(latest) %></td>
  <% if @flat %>
    <td class="muted col-folder">
      <%= link_to(@folder_paths[latest.node_id].presence || "Library", files_path(folder: latest.parent_node_id)) %>
    </td>
  <% end %>
  <td class="num muted col-size"><%= info.content_token ? number_to_human_size(info.size) : "—" %></td>
  <% if capabilities.versioned? %>
    <td class="muted mono col-version"><%= info.content_token&.first(8) || "—" %></td>
  <% end %>
  <td class="muted col-modified"><%= info.mtime ? time_at(time_from_nanos(info.mtime)) : "—" %></td>
  <td class="row-actions col-actions">
    <%= link_to details_path_for(latest.node_id), class: "row-action", title: "Details",
                aria: { label: "Details for #{latest.name}" },
                data: { action: "selection#details", selection_id: latest.node_id } do %><%= row_action_content(:details, "Details") %><% end %>
    <%= link_to blob_file_path(latest.node_id, download: 1), class: "row-action", title: "Download",
                aria: { label: "Download #{latest.name}" } do %><%= row_action_content(:download, "Download") %><% end %>
  </td>
</tr>
<% stack.members.each_with_index do |member, i| %>
  <%= render "files/list_row", node: @node_by_id[member.node_id],
             member: { id: member_ids[i], role: i.zero? ? "latest" : "older" } %>
<% end %>
