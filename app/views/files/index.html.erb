<% content_for :title, "Files — Tinkerex" %>

<div class="page-head">
  <h1>Files</h1>
</div>

<section class="uploader"
         data-controller="uploader"
         data-uploader-begin-url-value="<%= begin_upload_files_path %>"
         data-uploader-finalize-url-value="<%= finalize_upload_files_path %>">
  <label class="upload-btn">
    <input type="file" data-uploader-target="input" data-action="uploader#upload" hidden>
    <span>Upload a file</span>
  </label>
  <span class="upload-status" data-uploader-target="status"></span>
</section>

<% if @nodes.empty? %>
  <p class="empty muted">No files yet. Upload one to get started.</p>
<% else %>
<%#
  Size/Version come from @info_by_node (FileLayer::FileInfo), not from Version rows: on share and
  s3 there are none, so every Size cell here rendered an em-dash. See show.html.erb's header for
  why `capabilities` is called rather than dereferenced off an ivar with `&.`.
%>
  <table class="files">
    <thead>
      <tr>
        <th>Name</th><th>Kind</th><th class="num">Size</th>
        <% if capabilities.versioned? %><th>Version</th><% end %>
        <th>Modified</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% @nodes.each do |node| %>
        <% info = @info_by_node[node.node_id] %>
        <tr>
          <td>
            <% if node.file? %>
              <%= link_to node.name, file_path(node.node_id) %>
            <% else %>
              <span class="dir">📁 <%= node.name %></span>
            <% end %>
          </td>
          <td class="muted"><%= node.kind %></td>
          <td class="num muted"><%= info.content_token ? number_to_human_size(info.size) : "—" %></td>
          <% if capabilities.versioned? %>
            <td class="muted mono"><%= info.content_token&.first(8) || "—" %></td>
          <% end %>
          <td class="muted"><%= info.mtime ? Time.at(info.mtime / 1_000_000_000).strftime("%Y-%m-%d %H:%M") : "—" %></td>
          <td class="row-actions">
            <% if node.file? %>
              <%= link_to "Download", blob_file_path(node.node_id, download: 1) %>
            <% end %>
            <%= button_to "Delete", file_path(node.node_id), method: :delete,
                  form: { data: { turbo_confirm: "Delete #{node.name}?" } }, class: "linkbtn danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
