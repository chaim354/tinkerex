<% content_for :title, "Files — Tinkerex" %>

<%#
  Breadcrumb: root -> current folder, each segment a link. Root always shows; @crumbs is [] at
  the root, so this collapses to just "Files" there. Segments walk down the path the controller
  built by climbing parent_node_id (already user-scoped), so nothing here re-derives the tree or
  trusts params[:folder] a second time. aria-current marks the leaf for assistive tech.
%>
<% content_for :crumbs do %>
  <nav class="breadcrumb" aria-label="Folder path">
    <%= link_to "Files", files_path %>
    <% @crumbs.each_with_index do |crumb, i| %>
      <span class="sep" aria-hidden="true">/</span>
      <% if i == @crumbs.length - 1 %>
        <%= link_to crumb.name, files_path(folder: crumb.node_id), "aria-current": "page" %>
      <% else %>
        <%= link_to crumb.name, files_path(folder: crumb.node_id) %>
      <% end %>
    <% end %>
    <% if @q %>
      <span class="sep" aria-hidden="true">/</span>
      <span aria-current="page">Search “<%= @q %>”</span>
    <% end %>
  </nav>
<% end %>

<%# THE PAGE'S ONE PRIMARY ACTION IS UPLOAD, AND IT LIVES IN THE TOP BAR (structural redesign
    slice 4; layouts/_topbar_upload.html.erb), which uploads into this folder — FilesController#index
    hands it the validated @folder through FolderDestination, as `primary`. The page head keeps the
    quiet New text file and an overflow menu for the rest of what used to stack above the list —
    rescan, the folder's own actions — rendered only when it would have an item. %>
<% adoptable_folder = @folder && @folder_project.nil? &&
                      Maker::ProjectDiscovery.adoptable_name?(@folder.name) &&
                      !(@folder.parent_node_id.nil? && @folder.name == Maker::ProjectFolders::ROOT) %>
<%# THE MENU RENDERS ONLY WHEN IT WILL HOLD AN ITEM, and the folder arm therefore asks what the
    folder arm actually offers. Until slice 2 of the 2026-10-08 redesign "is there a folder" was
    NOT that question: on a non-scannable backend, a dot-folder or the
    `Projects` root had neither an "Open project" nor an adopt button, so the menu rendered EMPTY --
    the state files_toolbar_test.rb's "no menu renders when it would be empty" pins. Every folder
    view now offers Pin (or Unpin) to the sidebar, so `@folder.present?` is the honest answer and
    the root (no `@folder`) still renders no menu unless another arm has an item. %>
<% menu_items = capabilities.scannable? || @folder_project.present? || adoptable_folder ||
                @folder.present? %>
<div class="page-head">
  <h1>Files</h1>
  <div class="page-actions">
    <%#
      NEW TEXT FILE (2026-09-10). QUIET, NOT ACCENT: this page already spends its accent on the top
      bar's Upload, and decision 3 of the UI-cohesion spec allows exactly one —
      test/system/accent_spend_test.rb pins /files to ["Upload"] and reddens naming this route if
      `primary` appears here.

      NOT GATED ON A CAPABILITY. The write goes through Maker::TextSave to
      Maker::Addons::LibraryOutput.write_bytes!, which is the one place the `port_writable?` branch
      is still written out (§14d), so this one link works on all three backends — unlike the top
      bar's Upload, whose whole branch exists because those two flows are genuinely different doors.

      `@folder` IS THE FOLDER BEING VIEWED, so the file lands where the maker is standing. It is nil
      at the library root and in flat/search mode, and `url_for` drops a nil param.
    %>
    <%= link_to "New text file", new_files_text_file_path(parent_node_id: @folder&.node_id),
                class: "btn" %>
    <% if menu_items %>
      <details class="menu" data-controller="menu">
        <summary class="btn icon" aria-label="More actions" title="More actions">⋯</summary>
        <div class="menu-list">
          <%# PIN TO THE SIDEBAR (structural redesign, slice 2): the folder being viewed, never the
              library root (no @folder there), and never in flat/search mode (also no @folder). %>
          <% if @folder %>
            <% if current_user.maker_pins.exists?(node_id: @folder.node_id) %>
              <%= button_to "Unpin from sidebar", pin_path(@folder.node_id), method: :delete,
                            class: "menu-item", data: { turbo: false } %>
            <% else %>
              <%= button_to "Pin to sidebar", pins_path, params: { node_id: @folder.node_id },
                            class: "menu-item", data: { turbo: false } %>
            <% end %>
          <% end %>
          <% if capabilities.scannable? %>
            <%#
              RESCAN, offered ONLY on a scannable (share/s3) library: the catalog there is
              periodically polled from the store (spec decision 5), so a user who just edited files
              on the NAS can catch the index up now instead of waiting for the 15-minute recurring
              Library::ScanJob. Chunk mode's catalog is the sync engine's changelog -- nothing to
              poll -- so the button is hidden AND FilesController#rescan refuses the POST
              (require_scannable!). `capabilities.scannable?` RAISES if misspelled (the concern's
              helper, not an ivar with &.), so a typo fails at render in a test rather than silently
              vanishing. `folder:` rides along so the redirect lands back in this folder.
            %>
            <%= button_to "Rescan library", rescan_files_path(files_query_base),
                          class: "menu-item", data: { turbo: false } %>
          <% end %>
          <% if @folder_project %>
            <%= link_to "Open project “#{@folder_project.name}”", project_path(@folder_project),
                        class: "menu-item" %>
          <% elsif adoptable_folder %>
            <%#
              ADOPT IN PLACE (stage 4, S4-6; decision D1, stories 1.3 and 4.7). One POST turns the
              folder being viewed into a project that keeps its path — the answer to "a fifth of my
              files live outside Projects/" that does not ask the maker to move anything.

              THE TWO CHEAP REFUSALS ARE ASKED HERE TOO, and only those two: a dot-folder and the
              Projects root are a string test and a nil test on the row this page already holds.
              The expensive ones — an ancestor's claim, a working tree — stay in the controller,
              which is the only place that may be the authority; this just declines to offer a
              button whose answer the page already knows.
            %>
            <%= button_to "Make this folder a project", adopt_projects_path,
                          params: { node_id: @folder.node_id }, class: "menu-item" %>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</div>

<%# THE RESCAN RELOAD (stage 4, S4-3). Same element, same rules and the same controller as the
    project page's (projects/_attachments.html.erb): rendered only on the async path, pointed at
    this page WITHOUT ?scanning=1 so the reloaded page schedules nothing, and carrying the scan
    stamp this render read so the poll can tell "finished" from "still going". `files_query_base`
    is the folder/type/query the user was in, so the reload lands where they were.
    §14d — a data-controller name that resolves to nothing is a SILENT no-op, which is why
    app/javascript/controllers/scanreload_controller.js must exist and stimulus_hygiene_test
    guards that it does. %>
<% if params[:scanning] == "1" && capabilities.scannable? %>
  <span class="muted" data-controller="scanreload"
        data-scanreload-url-value="<%= files_path(files_query_base) %>"
        data-scanreload-status-url-value="<%= scan_status_files_path %>"
        data-scanreload-since-value="<%= current_user.library_scanned_stamp %>"></span>
<% end %>

<%# ONE TOOLBAR ROW: the search box, the type filter and its chips, the dot-file switch, the
    count, the view toggle and the sort — in both views (the list keeps its sortable headers as
    well). %>
<div class="toolbar files-toolbar">
  <%# THE FILES PAGE'S OWN SEARCH (spec S2-5), separate from the top bar's sitewide box (which now
      posts to SearchController). This one stays flat-library-and-files-only, exactly what
      FilesController#index's own ?q= has always answered — a plain GET, its own small form so
      the ext-picker form below keeps its one job (choosing a type). `ext` rides along as a
      hidden field so searching does not silently drop an active type filter (composing with the
      filter is pinned in files_search_test.rb); `folder` does NOT, because a search is flat by
      design (#index ignores it outright — see @flat above). %>
  <%= form_with url: files_path, method: :get, class: "files-search", data: { turbo: false } do %>
    <% if @exts.any? %><%= hidden_field_tag :ext, @exts.join(",") %><% end %>
    <input type="search" name="q" value="<%= @q %>" placeholder="Search files"
           aria-label="Search files" autocomplete="off">
  <% end %>
  <%= render "ext_filter" %>
  <%# HIDDEN-FILE TOGGLE. Dot-prefixed entries are noise in a maker's library — 78 of them on the
      deployed share box, mostly `.gitignore`, `.github` and `.clang-format` sitting between the
      models — but hiding them with no way back is how a file becomes unreachable, so this is a
      toggle rather than a silent filter.

      THE STATE LIVES IN A COOKIE (FilesController#resolve_hidden), not in files_query_base, for the
      same reason `view` and `sort` do: the choice has to survive clicking into a folder, and folder
      links carry only `folder:`. The link therefore sends the value it wants rather than a bare
      flag — `hidden=0` is a real instruction to hide, not an absent parameter.

      `.git` STAYS HIDDEN EITHER WAY and that is not an oversight — Node#visible_entries explains why
      the marker is a different rule from the clutter. %>
  <p class="hidden-toggle muted">
    <% if @show_hidden %>
      <%= link_to "Hide dot-files", files_path(files_query_base.merge(hidden: "0")), class: "chip active" %>
    <% else %>
      <%= link_to "Show dot-files", files_path(files_query_base.merge(hidden: "1")), class: "chip" %>
    <% end %>
  </p>
  <span class="toolbar-spacer"></span>
  <span class="toolbar-count">
    <% if @flat %>
      <%= count_label(@match_count, "match", "matches") %>
    <% else %>
      <%= count_label(@paged ? @child_count : @nodes.size, "item") %>
    <% end %>
  </span>
  <%# List/grid toggle. files_query_base rides along so the choice keeps whatever the user is
      looking at (the folder, and from Task 6 the type filter) instead of dumping them at the
      root; the choice itself is remembered in a cookie (FilesController#resolve_view), so it
      sticks across navigation, and the sort is remembered the same way rather than being pinned
      into these two links. %>
  <div class="view-toggle" role="group" aria-label="View">
    <%= link_to "Grid", files_path(files_query_base.merge(view: "grid")),
                class: "toggle#{' active' if @view == 'grid'}" %>
    <%= link_to "List", files_path(files_query_base.merge(view: "list")),
                class: "toggle#{' active' if @view == 'list'}" %>
  </div>
  <%#
    The grid has no column headers to click, so the sort is a pair of selects — and on the shared
    toolbar the list carries them too, beside its sortable headers. GET, so the result is a plain
    shareable URL exactly like the header links produce. `onchange` submits without JS of our own
    (an inline handler on a native form, not a controller) — the same shape files/models/index.html.erb's
    toolbar already uses.
  %>
  <form method="get" action="<%= files_path %>" class="sort-form">
    <% files_query_base.each do |k, v| %>
      <input type="hidden" name="<%= k %>" value="<%= v %>">
    <% end %>
    <label class="muted" for="sort-key">Sort</label>
    <select name="sort" id="sort-key" onchange="this.form.requestSubmit()">
      <% { "name" => "Name", "type" => "Type", "modified" => "Modified" }.each do |value, label| %>
        <option value="<%= value %>" <%= "selected" if @sort == value %>><%= label %></option>
      <% end %>
    </select>
    <select name="dir" aria-label="Sort direction" onchange="this.form.requestSubmit()">
      <option value="asc"  <%= "selected" if @dir == "asc" %>>Ascending</option>
      <option value="desc" <%= "selected" if @dir == "desc" %>>Descending</option>
    </select>
  </form>
</div>

<%# THE LIBRARY AND ITS INSPECTOR (structural redesign spec §5.1–5.2, slice 3; reworked 2026-10-21).
    A click on a file tile OPENS the file and a double-click opens it in a new tab
    (fileopen_controller.js, on the layout's main). Right-click › Details SELECTS it
    (selection_controller.js#details): `.is-selected` on the tile, `?selected=` in the URL, and the
    inspector frame below loads that one file's panel (FilesController#inspector). Every tile stays
    a link to its page, so the click, Enter, a modifier click, the file menu's Open and
    no-JavaScript all open the page. The server reads `?selected=` too (@selected, a file in THIS
    listing or nil), so a reload, Back or a shared link restores the panel.

    THE ASIDE ALWAYS RENDERS, empty and hidden until something is selected, so the controller always
    has a frame to point at. `src` is absent, not blank, when nothing is selected: turbo_frame_tag
    compacts a nil src away, and a frame with no src fetches nothing. The `__ID__` placeholder is
    the controller's to fill, so the one inspector URL is built here by the route helper and never
    spelled out in JavaScript. %>
<div class="library<%= " has-inspector" if @selected %>" data-controller="selection"
     data-selection-inspector-url-value="<%= inspector_file_path("__ID__") %>">
  <div class="library-main">
    <%# A PROJECT'S FOLDER SAYS WHAT THE SWEEP WILL DO TO IT, BEFORE IT DOES IT (F onboarding,
        2026-10-13). Only the folder a project claims (`@folder_project` is an exact match on
        folder_node_id, so a subfolder carries no line), because only its top level is the sweep's
        inbox. `autofile?` picks the sentence: off, Maker::ProjectIntake attaches and files
        nothing, and a line promising a move would be false. On, the exceptions are named because
        they are the files a maker would worry about: a README is never filed, and nothing inside a
        git working tree is. One line, not a panel: it sits above the files it is about. %>
    <% if @folder_project %>
      <p class="muted project-folder-note">
        This is the folder of the project <%= link_to @folder_project.name, project_path(@folder_project) %>.
        <% if @folder_project.autofile? %>
          Files left loose here are filed into type folders within 15 minutes, except a README and
          anything in a git repository (<%= link_to "Shelves", settings_shelves_path %>).
        <% else %>
          Automatic filing is off for this project, so files here stay where you put them.
        <% end %>
      </p>
    <% end %>
    <%# THE MODEL STRIP (structural redesign §5.4, slice 5): set by FilesController#index only on a
        folder view whose folder a catalogued model names and no project claims. %>
    <% if @folder_model %>
      <%= render "files/model_strip", model: @folder_model, cover_live: @strip_cover_live, covers: @strip_covers,
                 print_runs: @strip_print_runs, printers: @strip_printers, materials: @strip_materials,
                 projects: @strip_projects %>
    <% end %>
<% if @truncated %>
  <p class="truncated">
    Showing the first <%= number_with_delimiter(@nodes.size) %> of
    <%= number_with_delimiter(@match_count) %> matching files — narrow the filter to see the rest.
  </p>
<% end %>

<%#
  FOLDER PAGING. Rendered only when there IS more than one page, so an ordinary folder looks
  exactly as it always did — this bounds huge directories, it is not a new widget on every page.

  The links carry files_query_base (the folder) PLUS sort/dir. sort and dir are deliberately
  omitted from in-page links elsewhere because they are cookie-persisted, but a page link is the
  one place they must be explicit: "page 3" only means anything under the ordering that produced
  it, so a link that dropped them could hand the next request a different sort and therefore a
  different page 3.
%>
<% if @paged && @pages > 1 %>
  <nav class="pager" aria-label="Folder pages">
    <% if @page > 1 %>
      <%= link_to "‹ Previous",
                  files_path(**files_query_base, sort: @sort, dir: @dir, page: @page - 1),
                  rel: "prev", class: "pager-prev" %>
    <% end %>
    <span class="pager-status">
      Page <%= number_with_delimiter(@page) %> of <%= number_with_delimiter(@pages) %>
      (<%= number_with_delimiter(@child_count) %> items)
    </span>
    <% if @page < @pages %>
      <%= link_to "Next ›",
                  files_path(**files_query_base, sort: @sort, dir: @dir, page: @page + 1),
                  rel: "next", class: "pager-next" %>
    <% end %>
  </nav>
<% end %>

<% if @nodes.empty? %>
  <%# Three emptinesses. "How files arrive" is advice for an empty library or folder; said to
      someone who searched or filtered, it reads as "your library is empty" and is a lie.

      THE LAST ONE SAYS WHERE FILES COME FROM (F onboarding, 2026-10-13), through the partial Recent
      and Projects render too, and says which kind of empty it is: no `@folder` is the library root,
      so a new library; a folder is a folder the maker opened. Both are told the same ways in. %>
  <% if @q && @exts.any? %>
    <p class="empty">No files match “<%= @q %>” among <%= @exts.map { |e| ".#{e}" }.to_sentence %>.</p>
  <% elsif @q %>
    <p class="empty">No files match “<%= @q %>”.</p>
  <% elsif @flat %>
    <p class="empty">No files match <%= @exts.map { |e| ".#{e}" }.to_sentence %>.</p>
  <% else %>
    <div class="empty">
      <p><%= @folder ? "This folder is empty." : "Your library is empty." %></p>
      <%= render "shared/where_files_come_from" %>
    </div>
  <% end %>
<% elsif @view == "grid" %>
  <%= render "grid" %>
<% else %>
  <%= render "list" %>
<% end %>
  </div>
  <aside class="inspector" aria-label="Selected file">
    <%# A LINK, NOT A BUTTON: with JavaScript off the frame never loads, and a ?selected= page (the
        file page's folder crumb carries one) would otherwise show an empty panel whose only control
        does nothing — on a phone a sheet over the listing. With the controller, close prevents it. %>
    <%= link_to "×", files_path(request.query_parameters.except("selected")),
                class: "btn small icon inspector-close", data: { action: "selection#close" },
                aria: { label: "Close the inspector" } %>
    <%= turbo_frame_tag "inspector", src: (@selected && inspector_file_path(@selected)),
                        target: "_top", data: { selection_target: "frame" } %>
  </aside>
</div>
