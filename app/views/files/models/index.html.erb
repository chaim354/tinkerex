<% content_for :title, "3D models — Tinkerex" %>

<%# THE LIBRARY'S 3D MODELS VIEW (structural redesign §5.4, slice 5): the old Models index, moved
    here from models/index with its toolbar and grid unchanged. A Library page, so its breadcrumb
    starts at Files; the sidebar lights its own 3D models place (ShellHelper#sidebar_current). %>
<% content_for :crumbs do %>
  <nav class="breadcrumb" aria-label="Library path">
    <%= link_to "Files", files_path %>
    <span class="sep" aria-hidden="true">/</span>
    <span aria-current="page">3D models</span>
  </nav>
<% end %>

<%# `.page-head` IS `justify-content: space-between` AND LAYS OUT EXACTLY TWO SLOTS. These two
    links sat as bare children of it, which made three, and `space-between` put the middle one —
    the primary action "Import model" — in the CENTRE of the page while "Shelves" went hard right.
    The other fourteen pages already wrap their actions; this one did not, and nothing said so.
    Guard: template_hygiene_test.rb, "every .page-head passes exactly the two slots it lays out". %>
<div class="page-head">
  <h1>3D models</h1>
  <div class="page-actions">
    <%= link_to "Import model", new_model_path, class: "btn primary" %>
  </div>
</div>

<form class="toolbar models-toolbar" method="get" action="<%= files_models_path %>">
  <input type="search" name="q" value="<%= @filters[:q] %>" placeholder="Search models…" aria-label="Search models">
  <span class="chips">
    <%# THE LABELS COME FROM Maker::Model::PRINT_STATUS_LABELS, NOT FROM LITERALS HERE. They were
        literals until 2026-09-10, and the badge then on the card below rendered its own spelling of
        the same state — "Wanted" in this row against "Want To Print" 200px away. The card has no
        badge since 2026-10-20; the model page's badge reads the same hash. %>
    <% [["", "All"], *Maker::Model::PRINT_STATUS_LABELS.to_a].each do |val, label| %>
      <%= link_to label, files_models_path(status: val.presence, q: @filters[:q], tag: @filters[:tag], sort: @filters[:sort]),
                  class: "filter chip#{' active' if @status.to_s == val}" %>
    <% end %>
  </span>
  <span class="toolbar-spacer"></span>
  <span class="toolbar-count"><%= count_label(@models.size, "model") %></span>
  <% if @all_tags.any? %>
    <select name="tag" aria-label="Tag" onchange="this.form.requestSubmit()">
      <option value="">All tags</option>
      <% @all_tags.each do |t| %><option value="<%= t %>" <%= "selected" if @filters[:tag] == t %>><%= t %></option><% end %>
    </select>
  <% end %>
  <label class="muted" for="models-sort">Sort</label>
  <select name="sort" id="models-sort" onchange="this.form.requestSubmit()">
    <% [%w[recent Recent], %w[title Title], %w[status Status]].each do |val, label| %>
      <option value="<%= val %>" <%= "selected" if @filters[:sort] == val %>><%= label %></option>
    <% end %>
  </select>
</form>

<%# SORTED INTO PROJECTS (2026-10-20, Maker::ModelProjects): one group per project whose folder holds
    a model, by project name, then "Not in a project" last. When no model is in any project there is
    one group with no project, and it renders as the plain grid with no heading, because a lone "Not
    in a project" heading over every model would tell the maker nothing. ONE thumbs controller
    around every group, never one per grid: each instance polls on its own. %>
<% if @models.empty? %>
  <p class="empty">No models yet. Import your first one.</p>
<% else %>
  <% headed = @groups.any?(&:project) %>
  <div class="models-groups" data-controller="thumbs" data-thumbs-url-value="<%= thumbnails_files_path %>">
    <% @groups.each do |group| %>
      <section class="models-group">
        <% if headed %>
          <h2 class="group-head">
            <% if group.project %>
              <%= link_to group.project.name, project_path(group.project) %>
            <% else %>
              Not in a project
            <% end %>
            <span class="muted">(<%= group.models.size %>)</span>
          </h2>
        <% end %>
        <div class="projects-grid">
          <% group.models.each do |model| %>
            <%= render "models/card", model:, thumb: @covers.thumb(model.cover_node_id) %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
