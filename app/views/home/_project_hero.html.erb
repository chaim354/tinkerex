<section class="panel home-hero">
  <% if @project %>
    <div class="panel-head">
      <h2>Current project · <%= link_to @project.name, project_path(@project) %></h2>
      <%# THE KIND OF THING THE MAKER IS HOLDING (stage 4, S4-7), on the same non-default-only rule
          the index cards follow: `other` is the column default and badging a default is noise. The
          column is already on the row Home loaded, so this costs no query. %>
      <% unless @project.kind == Maker::ProjectKind::DEFAULT %>
        <span class="badge project-kind"><%= Maker::ProjectKind.label(@project.kind) %></span>
      <% end %>
      <div class="panel-actions">
        <%= render "projects/upload_control", upload_url: project_uploads_path(@project),
                   attach_url: project_attachments_path(@project), redirect_url: root_path,
                   parent_node_id: @upload_parent_node_id %>
        <%= link_to "Open", project_path(@project), class: "btn small" %>
      </div>
    </div>
    <% if @project.description.present? %>
      <p class="project-description"><%= @project.description %></p>
    <% end %>
    <p class="project-stats">
      <span><b><%= @hero_stats[:files] %></b> <%= "file".pluralize(@hero_stats[:files]) %></span>
      <span><b><%= @hero_stats[:tasks_done] %> of <%= @hero_stats[:tasks_total] %></b> <%= "task".pluralize(@hero_stats[:tasks_total]) %> done</span>
      <span><b><%= @hero_stats[:entries] %></b> log <%= "entry".pluralize(@hero_stats[:entries]) %></span>
      <span><b><%= @hero_stats[:sheets] %></b> <%= "sheet".pluralize(@hero_stats[:sheets]) %></span>
    </p>
    <div class="home-hero-cols">
      <div class="hero-tasks">
        <h3>Open tasks</h3>
        <% if @hero_tasks.empty? %>
          <p class="muted">No open tasks.</p>
        <% else %>
          <% @hero_tasks.each do |task| %>
            <div class="task-row">
              <span class="task-state task-state--<%= task.status %>" aria-hidden="true"></span>
              <span class="task-title"><%= task.title %></span>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="hero-entry">
        <h3>Latest entry</h3>
        <% if @hero_entry %>
          <time class="entry-time muted"><%= @hero_entry.logged_at.strftime("%Y-%m-%d %H:%M") %></time>
          <div class="entry-body"><%= @hero_entry.body %></div>
        <% else %>
          <p class="muted">No entries yet.</p>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="muted">No current project. Pick one from the rail, or <%= link_to "start a new project", new_project_path %>.</p>
  <% end %>
</section>
