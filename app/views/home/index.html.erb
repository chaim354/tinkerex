<% content_for :title, "Recent — Tinkerex" %>

<%# THE HEADING ALONE (structural redesign §7, slice 6). This head carried "New project" as the page's
    one action; the top bar's New menu already has Project, and Recent's one action is the top bar's
    Upload (HomeController#index calls upload_primary!), so a second accent here would spend it twice. %>
<div class="page-head">
  <h1>Recent</h1>
</div>

<%# RECENTLY CHANGED (structural redesign §7): the newest live files, as tiles that open their folder in
    the Library with the file selected — a link, never a selection item (this page has no selection
    controller). A file at the library root has no parent, and Rails drops the nil `folder`, so its link
    is /files?selected=… (files/show.html.erb relies on the same). A wrapping grid, not a row that
    scrolls sideways: sixteen tiles are a page of their own, and pages/home.css wraps them.

    THE ONE EMPTY STATE ON THIS PAGE. With no files it points at the top bar's Upload rather than
    rendering a second upload control, which would duplicate the input's id and the accent. %>
<section class="panel home-section home-files">
  <div class="panel-head"><h2>Recently changed</h2><%= link_to "Library", files_path, class: "muted" %></div>
  <% if @recent_files.empty? %>
    <p class="empty home-empty">No files yet. Upload, in the top bar, puts your first one in the folder you choose.</p>
  <% else %>
    <div class="recent-grid" data-controller="thumbs filemenu" data-thumbs-url-value="<%= thumbnails_files_path %>">
      <% @recent_files.each do |node| %>
        <% ext_label = File.extname(node.name).delete(".").upcase.first(4) %>
        <% href = library_file_path(node) %>
        <% if Maker::Previews::Registry.for_filename(node.name).present? %>
          <%= link_to href, class: "grid-card file-cell",
                      data: thumb_cell_data(node.node_id, ext_label).merge(file_menu_data(node.node_id, node.name, @addon_origins[node.node_id])) do %>
            <%= render "files/thumb", thumb: @covers.thumb(node.node_id), ext_label: ext_label,
                       url: preview_src(@covers.thumb(node.node_id)), photo: Maker::FileAttachment.photo?(node.name) %>
            <span class="grid-name"><%= node.name %></span>
          <% end %>
        <% else %>
          <%= link_to href, class: "grid-card", data: file_menu_data(node.node_id, node.name, @addon_origins[node.node_id]) do %>
            <span class="thumb generic-thumb" aria-hidden="true"><%= ext_label.presence || "FILE" %></span>
            <span class="grid-name"><%= node.name %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>

<%# ACTIVE PROJECTS, ONLY WHEN THERE ARE ANY: an empty account has one empty state, the files one above. %>
<% if @recent_projects.any? %>
  <section class="panel home-section home-projects">
    <div class="panel-head"><h2>Active projects</h2><%= link_to "All projects", projects_path, class: "muted" %></div>
    <div class="recent-grid" data-controller="thumbs" data-thumbs-url-value="<%= thumbnails_files_path %>">
      <% @recent_projects.each do |project| %>
        <%= render "projects/card", project: project, thumb: @covers.thumb(project.cover_node_id) %>
      <% end %>
    </div>
  </section>
<% end %>

<%# NEEDS ATTENTION, ONLY WHEN SOMETHING DOES. A section reading "Nothing needs attention" is a row of
    reassurance on every visit; absent, the page is shorter by exactly what was not news. %>
<% if @failed_prints.any? || @low_stock.any? %>
  <section class="panel home-section home-attention">
    <div class="panel-head"><h2>Needs attention</h2></div>
    <ul class="attention-list">
      <% @failed_prints.each do |run| %>
        <li class="attention-row attention-row--danger">
          <span class="attention-mark" aria-hidden="true"></span>
          <span class="attention-text"><%= link_to run.model.title, model_path(run.model) %> failed on <%= run.printed_on.strftime("%Y-%m-%d") %><%= " on #{run.printer}" if run.printer.present? %>.</span>
          <%= link_to "Log a print", model_path(run.model), class: "btn small" %>
        </li>
      <% end %>
      <%# LOW STOCK, AFTER THE FAILED PRINTS — a second attention source (stage 2, S2-3), sharing
          the row shape but its own modifier class so it can read as a milder warning rather than
          the danger colour a failed print gets (pages/home.css). %>
      <% @low_stock.each do |item| %>
        <li class="attention-row attention-row--warn">
          <span class="attention-mark" aria-hidden="true"></span>
          <span class="attention-text"><%= item.name %>: <%= number_with_precision(item.quantity_cached, precision: 3, strip_insignificant_zeros: true) %> <%= item.unit %> left, minimum <%= number_with_precision(item.min_quantity, precision: 3, strip_insignificant_zeros: true) %>.</span>
          <%= link_to "Restock", inventory_item_path(item), class: "btn small" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
