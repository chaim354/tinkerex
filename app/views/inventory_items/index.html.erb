<% content_for :title, "Inventory — Tinkerex" %>

<%# SUPPLIERS AND LOCATIONS ARE REACHED FROM HERE (UX audit 2026-11-01, E5): they were linked only
    from the Settings hub, while this page and the item form's dropdowns that name them never said
    where they are kept. Quiet buttons after the one primary, New item, in the screen's order (Shop
    manual slice 7), under a lead counted off the rows this page loaded (InventoryHelper#inventory_lead). %>
<div class="page-head">
  <h1>Inventory</h1>
  <% if (lead = inventory_lead) %><p class="page-lead"><%= lead %></p><% end %>
  <div class="page-actions">
    <%= link_to new_inventory_item_path, class: "btn primary" do %><%= rail_icon(:plus) %>New item<% end %>
    <%= link_to "Locations", locations_path, class: "btn" %>
    <%= link_to "Suppliers", suppliers_path, class: "btn" %>
  </div>
</div>

<%# TO BUY (Shop manual spec §9; the screen's section 1): every item the open projects' current BOMs
    need more of than is on hand, one row per item however many projects ask for it
    (InventoryItemsController#index, Maker::ToBuy). The item, how many to buy, which projects need it
    and why, and the cost where the item has a unit cost. Only when there is something to buy, and
    only on the whole list. The screen's Copy the shopping list and Mark as bought are not here: each
    is a behaviour of its own. Sections are numbered in the order they render, so Stock follows. %>
<% section_num = 0 %>
<% if @to_buy.any? %>
  <section class="panel inventory-to-buy" id="inventory-to-buy">
    <div class="panel-head">
      <h2><span class="panel-num"><%= section_num += 1 %></span> To buy</h2>
      <span class="panel-note"><%= to_buy_note(@to_buy) %></span>
    </div>
    <table class="table to-buy-table">
      <thead>
        <tr>
          <th class="col-name">Item</th>
          <th class="num col-buy">Buy</th>
          <th class="col-why">Why</th>
          <th class="num col-each">Each</th>
          <th class="num col-total">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @to_buy.each do |row| %>
          <tr>
            <td class="col-name"><%= link_to row.item.name, inventory_item_path(row.item) %></td>
            <td class="num col-buy"><%= inventory_quantity(row.short) %> <%= row.item.unit %></td>
            <td class="col-why"><%= to_buy_why(row) %></td>
            <td class="num col-each"><%= row.item.unit_cost ? number_to_currency(row.item.unit_cost) : "—" %></td>
            <td class="num col-total"><%= row.cost ? number_to_currency(row.cost) : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<%# THE STOCK, AS A NUMBERED SECTION (the screen's "Stock"): its head counts the rows and says the sort,
    then the filters and the table. The screen's Recent changes is a later behaviour; it takes a
    number above this one when it lands. %>
<section class="panel inventory-stock" id="inventory-stock">
<div class="panel-head">
  <h2><span class="panel-num"><%= section_num += 1 %></span> Stock</h2>
  <span class="panel-note">sorted by <%= InventoryHelper::SORT_LABELS.fetch(@sort).downcase %></span>
</div>
<form class="toolbar inventory-toolbar" method="get" action="<%= inventory_items_path %>">
  <input type="search" name="q" value="<%= @q %>" placeholder="Name or part number" aria-label="Search inventory">
  <%# EVERY CONTROL BELOW STARTS FROM `filters` (InventoryHelper#inventory_filters, the page's one
      filter state) AND SAYS ONLY WHAT IT CHANGES. A control that rebuilds the set by hand is how
      searching came to drop the category and the tag while a column header kept them. %>
  <% filters = inventory_filters %>
  <span class="chips">
    <%# "All" resets every facet -- it is the one hard reset in this row -- and keeps the search and
        the sort. It is lit exactly when there is nothing to reset. %>
    <%= link_to "All", inventory_items_path(filters.except(*InventoryHelper::INVENTORY_FACETS)),
                class: "filter chip#{' active' if filters.slice(*InventoryHelper::INVENTORY_FACETS).empty?}" %>
    <%# Low stock and a category replace each other, as this row has always had them. %>
    <%= link_to "Low stock (#{@low_count})", inventory_items_path(filters.except(:category).merge(low: 1)),
                class: "filter chip#{' active' if @low}" %>
    <% @categories.each do |cat| %>
      <%= link_to cat, inventory_items_path(filters.except(:low).merge(category: cat)),
                  class: "filter chip#{' active' if @category == cat}" %>
    <% end %>
    <%#
      Tag chips (stage 2, S2-5), after the category chips. Tag is a THIRD, composable facet -- an
      item can carry a category AND tags at once -- unlike category/low, which stay mutually
      exclusive with each other in this row exactly as they always have. So each tag chip carries
      the current category/low forward, and "All" above resets every facet including tag; there is
      no separate "clear tag" control because "All" already is one.
    %>
    <% @item_tags.each do |t| %>
      <%= link_to t, inventory_items_path(filters.merge(tag: t)),
                  class: "filter chip#{' active' if @tag == t}" %>
    <% end %>
    <%# THE SUPPLIER OR LOCATION A COUNT LINK NARROWED TO (E5), shown as the active chip it is, and
        rendered only while it applies. Choosing it again drops that one facet and keeps the rest. %>
    <% { "Supplier" => [ @supplier, :supplier ], "Location" => [ @location, :location ] }.each do |word, (place, key)| %>
      <% next unless place %>
      <%= link_to "#{word}: #{place.name}", inventory_items_path(filters.except(key)),
                  class: "filter chip active", title: "Show every #{word.downcase}" %>
    <% end %>
  </span>
  <span class="toolbar-spacer"></span>
  <%# A SEARCH OR A CHANGE OF SORT KEEPS EVERY FILTER THE PAGE IS SHOWING. The search box and the
      select below are this form's two visible inputs; everything else in `filters` has no control
      here and rides as a hidden field: the direction (set by the column headers, which are plain
      links), the category, low stock, the tag, the supplier and the location. Only the last two
      used to, so a search quietly took the category and the tag away. %>
  <% filters.except(:q, :sort).each do |key, value| %><input type="hidden" name="<%= key %>" value="<%= value %>"><% end %>
  <%# A VISIBLE LABEL, so all four list pages label their sort the same way (UI-cohesion slice 4).
      `aria-label` goes with it rather than staying alongside: a visible <label for> is the
      accessible name, and keeping both leaves two sources for it. %>
  <label class="muted" for="inventory-sort">Sort</label>
  <select name="sort" id="inventory-sort" onchange="this.form.requestSubmit()">
    <% InventoryHelper::SORT_LABELS.each do |val, label| %>
      <option value="<%= val %>" <%= "selected" if @sort == val %>><%= label %></option>
    <% end %>
  </select>
  <span class="toolbar-count"><%= count_label(@items.size, "item") %></span>
</form>

<%# TWO EMPTIES, AND THEY ASK FOR DIFFERENT THINGS (E3): a filter that matches nothing offers the way
    back, an inventory with nothing in it offers the first item. %>
<% if @items.empty? && @filtered %>
  <p class="empty">No items match. <%= link_to "Clear filters", inventory_items_path %></p>
<% elsif @items.empty? %>
  <p class="empty">No inventory yet. <%= link_to "Add your first item", new_inventory_item_path %>.</p>
<% else %>
  <table class="table inventory-table">
    <thead>
      <tr>
        <%= inventory_sort_header "Name", "name", col: "col-name" %>
        <th class="col-part">Part number</th>
        <%= inventory_sort_header "Category", "category", col: "col-category" %>
        <%= inventory_sort_header "On hand", "quantity", col: "col-onhand" %>
        <th class="col-min">Minimum</th>
        <th class="col-location">Location</th>
        <th class="col-supplier">Supplier</th>
        <%= inventory_sort_header "Updated", "updated", col: "col-updated" %>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <% low = item.low_stock? %>
        <tr class="<%= "low-stock" if low %>">
          <td class="col-name">
            <%= link_to item.name, inventory_item_path(item) %>
            <% if low %><span class="badge low-stock">Low stock</span><% end %>
          </td>
          <td class="col-part mono"><%= item.part_number.presence || "—" %></td>
          <td class="col-category"><%= item.category.presence || "—" %></td>
          <td class="num col-onhand"><%= inventory_quantity(item.quantity_cached) %> <%= item.unit %></td>
          <td class="num col-min"><%= item.min_quantity.positive? ? inventory_quantity(item.min_quantity) : "—" %></td>
          <td class="col-location"><%= item.location&.name || "—" %></td>
          <td class="col-supplier"><%= item.supplier&.name || "—" %></td>
          <td class="col-updated muted"><%= time_at(item.updated_at, style: :date) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
</section>
