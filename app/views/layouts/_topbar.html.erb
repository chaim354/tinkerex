<%# The top bar (spec §5.3): the page's breadcrumb when it supplies one via content_for :crumbs,
    else its title; and the search box, which posts to the sitewide SearchController (stage 2,
    S2-5) rather than to the Files page it used to. The Files page keeps its OWN search in its
    own toolbar (files/index.html.erb's .files-search) for the flat, files-only query FilesController
    already answers. %>
<header class="topbar">
  <div class="topbar-crumbs">
    <% if content_for?(:crumbs) %>
      <%= content_for(:crumbs) %>
    <% else %>
      <span class="topbar-title"><%= page_title_text %></span>
    <% end %>
  </div>
  <%# THE PHONE CHIP (spec §5.4). Below 720px shell.css hides the rail, and with it the
      current-project card — so the same form and select render here too, shown only at that
      width. A second id, because the rail's select already owns `project_id` on the same page
      (a label resolving to the wrong one is the bug files/show.html.erb records); the NAME stays
      `project_id` because CurrentProjectController reads it. Capybara sees only the visible one. %>
  <% chip_choices = current_project_choices %>
  <% if chip_choices.any? %>
    <%= form_with url: current_project_path, method: :patch, data: { turbo: false },
                  class: "topbar-project" do %>
      <label class="topbar-project-label" for="topbar_project_id">Project</label>
      <%= select_tag :project_id,
            options_for_select([ [ "— none —", "" ] ] + chip_choices, current_project&.id),
            id: "topbar_project_id", onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>
  <%= form_with url: search_path, method: :get, class: "topbar-search", role: "search",
                data: { turbo: false } do %>
    <%= rail_icon(:search) %>
    <%# ALWAYS BLANK, DELIBERATELY -- @q IS ALSO THE NAME FilesController, InventoryItemsController
        AND SearchController ITSELF GIVE THEIR OWN IVARS, and echoing whichever one the current
        request happens to carry would leak one page's private local filter (Files', Inventory's)
        into a box that now means something else (search EVERYTHING). SearchController's OWN page
        already has its own big, sticky search-toolbar input for that job (search/index.html.erb) —
        this is the entry point, not a second display of the last query. rail_controller.js's
        Ctrl/Cmd-K handler finds this field by `.topbar-search input[type=search]`, unchanged. %>
    <input type="search" name="q" placeholder="Search everything" aria-label="Search everything"
           autocomplete="off">
    <kbd class="topbar-kbd" aria-hidden="true">⌘K</kbd>
  <% end %>
  <%# NEW ▾ (structural redesign spec §4.2): everything here creates where the maker is standing —
      NewMenuHelper#new_menu_folder_node_id. Upload joins it in slice 4 with folder destinations. %>
  <details class="menu topbar-new" data-controller="menu">
    <summary class="btn">New <span aria-hidden="true">▾</span></summary>
    <div class="menu-list">
      <%= form_with url: library_folders_path, method: :post, class: "menu-form", data: { turbo: false } do %>
        <%= hidden_field_tag :parent_node_id, new_menu_folder_node_id, id: nil %>
        <label class="menu-form-label" for="new_folder_name">New folder</label>
        <span class="menu-form-row">
          <%= text_field_tag :name, nil, id: "new_folder_name", placeholder: "Folder name",
                             required: true, autocomplete: "off" %>
          <%= submit_tag "Create", class: "small", name: nil %>
        </span>
      <% end %>
      <div class="menu-sep" role="separator"></div>
      <%= link_to "Text file", new_files_text_file_path(parent_node_id: new_menu_folder_node_id), class: "menu-item" %>
      <%= link_to "Project", new_project_path, class: "menu-item" %>
      <%# THE TOOL ENTRIES ARRIVE ONLY WHEN THE MENU OPENS. A lazy frame inside a closed <details> has
          no box, so Turbo's IntersectionObserver fires on open and not before: the layout itself never
          reads the addon registry (docs/invariants/addons.md), and an addon-source outage costs this
          menu its tool list instead of costing every page its render. `target="_top"` so a tool link
          navigates the page, not the frame. %>
      <turbo-frame id="new-menu-tools" src="<%= tools_new_menu_path %>" loading="lazy" target="_top"></turbo-frame>
      <div class="menu-sep" role="separator"></div>
      <%= link_to "Inventory item", new_inventory_item_path, class: "menu-item" %>
    </div>
  </details>
</header>
