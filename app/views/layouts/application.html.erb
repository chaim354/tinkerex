<!DOCTYPE html>
<html lang="en" data-theme="<%= ui_theme %>">
  <head>
    <title><%= content_for(:title) || "Tinkerex" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tinkerex">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="<%= color_scheme_meta %>">
    <meta name="theme-color" content="<%= theme_color_hex %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "components", "shell",
                            "pages/files", "pages/projects", "pages/models", "pages/tools", "pages/preview", "pages/home", "pages/inventory", "pages/settings", "pages/search", "pages/public",
                            "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "vendor-overrides", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "application", importmap: (@importmap || Rails.application.importmap) %>
  </head>

  <body class="<%= body_classes %>">
    <%# THE FIRST ELEMENT IN BODY ON BOTH BRANCHES: a keyboard user's first Tab lands here and jumps
        past the rail and the top bar to main#main, which both main elements below carry
        (skip_link_test.rb). Hidden above the viewport until focused; positioned absolutely, so it
        never takes a cell of body.app-shell's grid (components.css). %>
    <a href="#main" class="skip-link">Skip to content</a>
    <%# `shell_signed_in?`, not `user_signed_in?` — a PUBLIC page (Public::BaseController, stage 3,
        S3-4) renders the visitor's shell even for its signed-in owner, because what a maker wants
        from their own public URL is an honest preview of what a visitor sees. %>
    <% if shell_signed_in? %>
      <%= render "layouts/rail" %>
      <div class="shell-main">
        <%= render "layouts/topbar" %>
        <%= render "layouts/flash" %>
        <%# Pages that need the full width opt in with content_for :container_class, "container-wide"
            (the addon host page does, from its manifest). Inert everywhere else. %>
        <main id="main" class="container <%= content_for(:container_class) %>">
          <%# Renders nothing unless this request's port call failed (the partial decides). Signed-in
              only: a visitor is never told about the owner's storage, and a Public:: controller
              has no `capabilities` helper to name a cause with. %>
          <%= render "layouts/library_unreachable" %>
          <%= yield %>
        </main>
      </div>
      <%= render "layouts/tabbar" %>
    <% else %>
      <%# STAGE 4, S4-5: THE VISITOR'S ONLY CHROME, ON A PUBLIC SURFACE ALONE. Devise's pages share
          this branch and must not get a site nav under their sign-in card, which is what the guard
          says — and `public_shell?` is the same question `shell_signed_in?` asked one line up. %>
      <%= render "layouts/public_header" if public_shell? %>
      <%= render "layouts/flash" %>
      <%# `auth-main` (a 440px column for the sign-in card) is the DEFAULT here rather than a fixed
          class: a PUBLIC page (stage 3, S3-4) renders on this same anonymous branch and needs the
          full width the signed-in pages get. A page opts out by naming its own container class;
          anything that names none — every Devise page — keeps exactly the auth card's layout. %>
      <main id="main" class="container <%= content_for(:container_class).presence || "auth-main" %>">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
