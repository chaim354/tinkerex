<%# THE PINNED TOOLS (2026-10-22; Maker::ToolPins), in the order they were pinned: Home's Pinned group
    and the Tools column both list them. Read from the user row the request already loaded, so they
    cost no query, and NEVER from the addon registry (an addon's title was copied in when it was
    pinned; docs/invariants/addons.md: the layout never reads the registry). The caller wraps them in
    a `toolmenu` controller, for the right-click Unpin on each row.

    THE CALCULATOR OPENS THE MODAL rather than going anywhere (`data-calculator-open`,
    calculator_controller.js), so it never carries aria-current. AN ADDON is a link to its page, lit
    there (sidebar_current's [:tool, key]).

    Locals: tools (the pins, Maker::ToolPins#to_a). %>
<% tools.each do |pin| %>
  <% if pin.calculator? %>
    <%= column_row "Calculator", tools_path(anchor: "calculator"), note: "tool", class: "column-calculator",
                   title: "Calculator (#{calculator_shortcut})", "aria-haspopup": "dialog",
                   "aria-keyshortcuts": CalculationsHelper::CALCULATOR_KEYS,
                   data: tool_menu_data(pin.key, pin.label, calculator_open: "") %>
  <% else %>
    <%= column_row pin.label, tools_addon_path(pin.key), key: [ :tool, pin.key ], note: "tool",
                   class: "column-tool-pin", data: tool_menu_data(pin.key, pin.label) %>
  <% end %>
<% end %>
