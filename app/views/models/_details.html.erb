<%# THE MODEL PAGE'S DETAILS PANE (2026-10-21): what the page's main and side columns held before the
    model page became files-left, pane-right (models/show), minus two things that moved elsewhere —
    the file tree, which is the page's list now, and the instructions iframes, which are the pane's
    default (ModelsController#stage_for). So: the cover with View in 3D and its switcher, the gallery,
    the notes, designer, licence, source, tags and added date, the print settings and the print log.
    Rendered inside the `model_stage` frame (models/_stage), whose `target="_top"` sends every link
    and form here to the whole page; the gallery's links alone opt back into the frame, so a photo
    opens in the pane. Reads the ivars ModelsController#load_details sets. %>
<div class="model-details">
  <% if @viewable_3d.any? %>
    <%# The hero doubles as the 3D viewer: click "View in 3D" to swap the poster for the live
        canvas in place; a dropdown switches between the model's 3D files. `lazy` means nothing
        is fetched until the click. When there's a single file, no dropdown — the url/format
        are set on the element so load() uses them directly.

        EVERY URL HERE IS THE NAMED BLOB ROUTE (the option data-url attributes too), because
        Online3DViewer picks its importer from the URL's own trailing extension — see the same
        note in files/viewers/_model3d.html.erb. %>
    <div class="model-hero model-viewer"
         data-controller="modelviewer"
         data-modelviewer-lazy-value="true"
         <% if @viewable_3d.one? %>
         data-modelviewer-url-value="<%= named_blob_file_path(@viewable_3d.first[:node_id], filename: @viewable_3d.first[:name]) %>"
         data-modelviewer-format-value="<%= @viewable_3d.first[:format] %>"
         data-modelviewer-colors-value="<%= (@viewable_3d.first[:manifest]&.colors || []).to_json %>"
         data-modelviewer-unit-factor-value="<%= @viewable_3d.first[:manifest]&.unit_factor || 1.0 %>"
         data-modelviewer-preview-url-value="<%= file_preview_path(@viewable_3d.first[:node_id]) %>"
         <% end %>>
      <div class="model-viewer-stage" data-modelviewer-target="canvas"></div>
      <div class="model-viewer-bar">
        <% if @viewable_3d.many? %>
          <select class="model-viewer-source" data-modelviewer-target="source"
                  data-action="change->modelviewer#selectSource" aria-label="Choose a 3D file">
            <% @viewable_3d.each do |f| %>
              <%# The slicer colours, the unit factor and the preview door ride on each OPTION,
                  not on the element: they are facts about one FILE and the switcher swaps files.
                  load() copies them into the controller's values beside url/format. %>
              <option value="<%= f[:node_id] %>"
                      data-url="<%= named_blob_file_path(f[:node_id], filename: f[:name]) %>"
                      data-format="<%= f[:format] %>"
                      data-colors="<%= (f[:manifest]&.colors || []).to_json %>"
                      data-unit-factor="<%= f[:manifest]&.unit_factor || 1.0 %>"
                      data-preview-url="<%= file_preview_path(f[:node_id]) %>"
                      <%= "selected" if f[:node_id] == @viewable_3d_default[:node_id] %>><%= f[:name] %></option>
            <% end %>
          </select>
        <% end %>
        <span class="model-viewer-dims" data-modelviewer-target="dims"></span>
        <span class="mv-launch">
          <button type="button" class="btn small" data-action="modelviewer#load">View in 3D</button>
        </span>
        <span class="mv-actions">
          <button type="button" class="btn small ghost" data-action="modelviewer#reset">Reset view</button>
          <button type="button" class="btn small ghost" data-action="modelviewer#fullscreen">Fullscreen</button>
          <button type="button" class="btn small ghost" data-action="modelviewer#usePreview">Use this view as preview</button>
          <button type="button" class="btn small ghost" aria-label="Return to image" data-action="modelviewer#showPoster">✕ Image</button>
        </span>
        <span class="mv-status muted" data-modelviewer-target="status" role="status"></span>
      </div>
      <div class="model-viewer-fallback" data-modelviewer-target="fallback">
        <%= render "hero_poster" %>
      </div>
    </div>
  <% else %>
    <div class="model-hero">
      <%= render "hero_poster" %>
    </div>
  <% end %>

  <%# @by_role IS BUILT FROM THE LIVE ATTACHMENTS ONLY (ModelsController#show partitions against
      @page_nodes), which is what lets both dereferences below drop their `&.`. The count matters
      as much as the tile: this gallery renders only when there is more than one image, so an
      unfiltered dead entry did not merely paint a broken <img> — it summoned a gallery around a
      single live one.

      A PHOTO OPENS IN THE PANE (2026-10-21): each link targets the `model_stage` frame this sits in,
      overriding the frame's `target="_top"`, and advances the URL to `?file=<id>` like a list entry;
      a double-click opens its file page in a new tab (FilesHelper#file_open_data). %>
  <% images = Array(@by_role["image"]) %>
  <% if images.size > 1 %>
    <div class="image-gallery">
      <% images.each do |a| %>
        <% node = @page_nodes[a.node_id] %>
        <%= link_to model_path(@model, file: a.node_id),
                    data: file_open_data({ turbo_frame: "model_stage", turbo_action: "advance" },
                                         new_tab: file_path(a.node_id)) do %>
          <%# `inline_image?`, NOT the role (tinkerex#285, found in review): a .heic is an image by
              role and a broken picture as raw bytes, so it gets the same thumbnail cell the hero
              poster falls back to — fed by @covers, which ModelsController#load_details widens to these. %>
          <% if Maker::FileAttachment.inline_image?(node.name) %>
            <%= image_tag blob_file_path(a.node_id), alt: node.name, loading: "lazy" %>
          <% else %>
            <% ext = File.extname(node.name).delete(".").upcase.first(4) %>
            <span class="thumb file-cell gallery-thumb" data-controller="thumbs"
                  data-thumbs-url-value="<%= thumbnails_files_path %>" data-thumbs-target="cell"
                  data-node-id="<%= a.node_id %>" data-ext="<%= ext %>">
              <%= render "files/thumb", thumb: @covers.thumb(a.node_id), ext_label: ext,
                         url: preview_src(@covers.thumb(a.node_id)) %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @model.notes.present? %>
    <section class="model-notes"><h2>Notes</h2><%= render_note(@model.notes) %></section>
  <% end %>

  <dl class="meta">
    <% if @model.designer.present? %><dt>Designer</dt><dd><%= @model.designer %></dd><% end %>
    <% if @model.license.present? %><dt>License</dt><dd><%= @model.license %></dd><% end %>
    <% if @model.source_url.present? %>
      <dt>Source</dt>
      <dd>
        <% if @model.source_url.match?(%r{\Ahttps?://}i) %>
          <%= link_to @model.source_url, @model.source_url, target: "_blank", rel: "noopener" %>
        <% else %>
          <%= @model.source_url %>
        <% end %>
      </dd>
    <% end %>
    <% if @model.tags.any? %><dt>Tags</dt><dd><%= @model.tag_list %></dd><% end %>
    <dt>Added</dt><dd><%= @model.created_at.strftime("%Y-%m-%d") %></dd>
  </dl>

  <%= render "models/projects", model: @model, choices: @project_choices %>

  <% if @model.print_settings.present? %>
    <section class="model-print-settings">
      <h2>Print settings</h2>
      <dl class="ps-grid">
        <% @model.print_settings.each do |k, v| %>
          <dt><%= k.tr("_", " ").capitalize %></dt><dd><%= v %></dd>
        <% end %>
      </dl>
    </section>
  <% end %>

  <%= render "models/print_log", model: @model, print_runs: @print_runs, printers: @printers, materials: @materials %>
</div>
