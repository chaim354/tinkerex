<%#
  Recursive folder tree for a model's files. `nodes` is [{dir:, children:[...]}, {file:}, ...] as
  built by ModelsController#build_file_tree. Folders are native <details> (collapsible, no JS);
  files link to the existing /files/:node_id preview page.
%>
<ul class="file-tree">
  <% nodes.each do |item| %>
    <% if item[:dir] %>
      <li class="tree-dir">
        <details open>
          <summary><span class="tree-folder"><%= folder_glyph %><%= item[:dir].name %></span></summary>
          <%= render "file_tree", nodes: item[:children] %>
        </details>
      </li>
    <% else %>
      <% node = item[:file] %>
      <li class="tree-file">
        <%= link_to node.name, file_path(node.node_id), title: node.name, class: "tree-fname" %>
      </li>
    <% end %>
  <% end %>
</ul>
