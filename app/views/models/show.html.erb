<% content_for :title, "#{@model.title} — Tinkerex" %>

<% content_for :crumbs do %>
  <nav class="breadcrumb" aria-label="Model path">
    <%= link_to "Library", files_path %>
    <span class="sep" aria-hidden="true">/</span>
    <%= link_to "3D models", files_models_path %>
    <span class="sep" aria-hidden="true">/</span>
    <span aria-current="page"><%= @model.title %></span>
  </nav>
<% end %>

<%# THE STATUS BADGE ONLY WHEN IT IS NEWS (UX audit 2026-11-01, E2): every model the sweep finds
    starts at the column's default, so "Want to print" sat on all of them. A status somebody, or a
    logged print, set is shown; the word is always Maker::Model::PRINT_STATUS_LABELS'. %>
<div class="page-head">
  <div>
    <h1><%= @model.title %></h1>
    <% unless @model.default_print_status? %>
      <span class="badge mstatus-<%= @model.print_status %>"><%= @model.print_status_label %></span>
    <% end %>
  </div>
  <div class="head-actions">
    <%= link_to "Edit", edit_model_path(@model), class: "btn small" %>
    <% if @model.folder_node_id %>
      <%= link_to "Open in Library", files_path(folder: @model.folder_node_id), class: "btn small" %>
    <% end %>
  </div>
</div>

<%# THE MODEL PAGE, PRINTABLES-STYLE (2026-10-21): the model's files on the left, a pane on the right.
    The list is OUTSIDE the frame so its scroll survives a click; modelstage_controller.js keeps its
    aria-current true across frame loads, and on a phone scrolls the pane into view. %>
<div class="model-layout" data-controller="modelstage" data-action="turbo:frame-load->modelstage#loaded">
  <nav class="model-index" aria-label="Model files">
    <%= link_to "Details", model_path(@model, file: "details"), class: "model-index-details",
                aria: { current: ("true" if @stage == :details) },
                data: { turbo_frame: "model_stage", turbo_action: "advance", modelstage_target: "entry" } %>
    <section class="model-files">
      <h2>Files <span class="muted">(<%= @file_count %>)</span></h2>
      <% if @file_tree.present? %>
        <div class="file-tree-box">
          <%= render "models/file_tree", nodes: @file_tree, model: @model,
                     current: (@stage == :details ? nil : @stage.node_id) %>
        </div>
      <% else %>
        <p class="muted">No files yet.</p>
      <% end %>

      <%# NOT SILENT — the same sentence, class and Trash link the project panel uses, because it is
          the same event: an attachment whose node was tombstoned now disappears from the hero, the
          gallery and the instructions instead of rendering broken, and a user who deleted a file by
          accident otherwise has no thread to pull. It counts ATTACHMENTS, which is a different
          question from the heading above (that one counts what is in Models/<slug>/ on disk); a
          file can be missing here and present there, and vice versa. It clears itself when
          Maker::AttachmentReaper destroys the rows after the undo window. %>
      <% if @missing_attachment_count.positive? %>
        <p class="muted attachments-missing">
          <%= pluralize(@missing_attachment_count, "attached file") %> no longer in your library.
          <%= link_to "Check the trash", trash_index_path %>
        </p>
      <% end %>
    </section>
  </nav>
  <%= render "models/stage", model: @model, stage: @stage, viewer: @viewer %>
</div>

<%# THE DESTROY BUTTON SITS AT THE FOOT, NOT IN THE HEAD (UX audit 2026-11-01, E3): a full danger
    button beside Edit was the loudest thing on the page for the rarest thing done on it. It is a
    danger link with its consequence beside it, the shape of the project's Danger zone line.

    THE BUTTON MUST SAY WHAT THE CONTROLLER WILL ACTUALLY DO. An auto model is DISMISSED, not
    destroyed -- the row survives so Maker::ModelIntake does not recreate it on the next sweep
    -- so a button reading "Delete" over a confirm promising deletion describes the other
    branch of models#destroy. Both halves already keep the files; what differs is the row. The
    Library's model strip (files/_model_strip) carries the same two branches in the same words
    (docs/invariants/model-intake.md). %>
<div class="model-foot">
  <% if @model.auto? %>
    <%= button_to "Remove from catalog", model_path(@model), method: :delete, class: "linkbtn danger small",
                  form: { data: { turbo_confirm: "Remove #{@model.title} from the catalog? " \
                                                 "The files stay, and it won't be re-added by the next scan." } } %>
    <p class="muted">The files stay in your library, and the next scan will not add it again.</p>
  <% else %>
    <%= button_to "Delete", model_path(@model), method: :delete, class: "linkbtn danger small",
                  form: { data: { turbo_confirm: "Delete #{@model.title}? (files are kept)" } } %>
    <p class="muted">Deletes the catalog entry and its print log. The files stay in your library.</p>
  <% end %>
</div>
