<% content_for :title, "#{@model.title} — Tinkerex" %>

<nav class="breadcrumb" aria-label="Model path">
  <%= link_to "Models", models_path %>
  <span class="sep" aria-hidden="true">/</span>
  <span aria-current="page"><%= @model.title %></span>
</nav>

<div class="page-head">
  <div>
    <h1><%= @model.title %></h1>
    <span class="badge mstatus-<%= @model.print_status %>"><%= @model.print_status.tr("_", " ") %></span>
  </div>
  <div class="head-actions">
    <%= link_to "Edit", edit_model_path(@model), class: "linkbtn" %>
    <% if @model.folder_node_id %>
      <%= link_to "Open in Files", files_path(folder: @model.folder_node_id), class: "linkbtn" %>
    <% end %>
    <%# THE BUTTON MUST SAY WHAT THE CONTROLLER WILL ACTUALLY DO. An auto model is DISMISSED, not
        destroyed -- the row survives so Maker::ModelIntake does not recreate it on the next sweep
        -- so a button reading "Delete" over a confirm promising deletion describes the other
        branch of models#destroy. Both halves already keep the files; what differs is the row. %>
    <% if @model.auto? %>
      <%= button_to "Remove from catalog", model_path(@model), method: :delete, class: "linkbtn danger",
                    form: { data: { turbo_confirm: "Remove #{@model.title} from the catalog? " \
                                                   "The files stay, and it won't be re-added by the next scan." } } %>
    <% else %>
      <%= button_to "Delete", model_path(@model), method: :delete, class: "linkbtn danger",
                    form: { data: { turbo_confirm: "Delete #{@model.title}? (files are kept)" } } %>
    <% end %>
  </div>
</div>

<div class="model-layout">
  <%# MAIN column: the cover image, then a gallery, then the instructions PDF UNDER the image
      (Printables-style), then notes. %>
  <div class="model-main">
    <% if @viewable_3d.any? %>
      <%# The hero doubles as the 3D viewer: click "View in 3D" to swap the poster for the live
          canvas in place; a dropdown switches between the model's 3D files. `lazy` means nothing
          is fetched until the click. When there's a single file, no dropdown — the url/format
          are set on the element so load() uses them directly. %>
      <div class="model-hero model-viewer"
           data-controller="modelviewer"
           data-modelviewer-lazy-value="true"
           <% if @viewable_3d.one? %>
           data-modelviewer-url-value="<%= blob_file_path(@viewable_3d.first[:node_id]) %>"
           data-modelviewer-format-value="<%= @viewable_3d.first[:format] %>"
           <% end %>>
        <div class="model-viewer-stage" data-modelviewer-target="canvas"></div>
        <div class="model-viewer-bar">
          <% if @viewable_3d.many? %>
            <select class="model-viewer-source" data-modelviewer-target="source"
                    data-action="change->modelviewer#selectSource" aria-label="Choose a 3D file">
              <% @viewable_3d.each do |f| %>
                <option value="<%= f[:node_id] %>"
                        data-url="<%= blob_file_path(f[:node_id]) %>"
                        data-format="<%= f[:format] %>"
                        <%= "selected" if f[:node_id] == @viewable_3d_default[:node_id] %>><%= f[:name] %></option>
              <% end %>
            </select>
          <% end %>
          <span class="model-viewer-dims" data-modelviewer-target="dims"></span>
          <span class="mv-launch">
            <button type="button" class="btn small" data-action="modelviewer#load">View in 3D</button>
          </span>
          <span class="mv-actions">
            <button type="button" class="btn small ghost" data-action="modelviewer#reset">Reset view</button>
            <button type="button" class="btn small ghost" data-action="modelviewer#fullscreen">Fullscreen</button>
            <button type="button" class="btn small ghost" aria-label="Return to image" data-action="modelviewer#showPoster">✕ Image</button>
          </span>
        </div>
        <div class="model-viewer-fallback" data-modelviewer-target="fallback">
          <%= render "hero_poster" %>
        </div>
      </div>
    <% else %>
      <div class="model-hero">
        <%= render "hero_poster" %>
      </div>
    <% end %>

    <%# @by_role IS BUILT FROM THE LIVE ATTACHMENTS ONLY (ModelsController#show partitions against
        @page_nodes), which is what lets both dereferences below drop their `&.`. The count matters
        as much as the tile: this gallery renders only when there is more than one image, so an
        unfiltered dead entry did not merely paint a broken <img> — it summoned a gallery around a
        single live one. %>
    <% images = Array(@by_role["image"]) %>
    <% if images.size > 1 %>
      <div class="image-gallery">
        <% images.each do |a| %>
          <%= link_to file_path(a.node_id) do %>
            <%= image_tag blob_file_path(a.node_id), alt: @page_nodes[a.node_id].name, loading: "lazy" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% instructions = Array(@by_role["instructions"]) %>
    <% if instructions.present? %>
      <section class="model-instructions">
        <h2>Instructions</h2>
        <% instructions.each do |a| %>
          <iframe class="preview-pdf" src="<%= blob_file_path(a.node_id) %>" title="<%= @page_nodes[a.node_id].name %>"></iframe>
        <% end %>
      </section>
    <% end %>

    <% if @model.notes.present? %>
      <section class="model-notes"><h2>Notes</h2><%= render_note(@model.notes) %></section>
    <% end %>
  </div>

  <%# SIDE column: metadata, the files as a scrollable folder tree, then the print log. %>
  <aside class="model-side">
    <dl class="meta">
      <% if @model.designer.present? %><dt>Designer</dt><dd><%= @model.designer %></dd><% end %>
      <% if @model.license.present? %><dt>License</dt><dd><%= @model.license %></dd><% end %>
      <% if @model.source_url.present? %>
        <dt>Source</dt>
        <dd>
          <% if @model.source_url.match?(%r{\Ahttps?://}i) %>
            <%= link_to @model.source_url, @model.source_url, target: "_blank", rel: "noopener" %>
          <% else %>
            <%= @model.source_url %>
          <% end %>
        </dd>
      <% end %>
      <% if @model.tags.any? %><dt>Tags</dt><dd><%= @model.tag_list %></dd><% end %>
      <dt>Added</dt><dd><%= @model.created_at.strftime("%Y-%m-%d") %></dd>
    </dl>

    <% if @model.print_settings.present? %>
      <section class="model-print-settings">
        <h2>Print settings</h2>
        <dl class="ps-grid">
          <% @model.print_settings.each do |k, v| %>
            <dt><%= k.tr("_", " ").capitalize %></dt><dd><%= v %></dd>
          <% end %>
        </dl>
      </section>
    <% end %>

    <section class="model-files">
      <h2>Files <span class="muted">(<%= @file_count %>)</span></h2>
      <% if @file_tree.present? %>
        <div class="file-tree-box"><%= render "file_tree", nodes: @file_tree %></div>
      <% else %>
        <p class="muted">No files yet.</p>
      <% end %>

      <%# NOT SILENT — the same sentence, class and Trash link the project panel uses, because it is
          the same event: an attachment whose node was tombstoned now disappears from the hero, the
          gallery and the instructions instead of rendering broken, and a user who deleted a file by
          accident otherwise has no thread to pull. It counts ATTACHMENTS, which is a different
          question from the heading above (that one counts what is in Models/<slug>/ on disk); a
          file can be missing here and present there, and vice versa. It clears itself when
          Maker::AttachmentReaper destroys the rows after the undo window. %>
      <% if @missing_attachment_count.positive? %>
        <p class="muted attachments-missing">
          <%= pluralize(@missing_attachment_count, "attached file") %> no longer in your library.
          <%= link_to "Check the trash", trash_index_path %>
        </p>
      <% end %>
    </section>

    <%= render "print_log" %>
  </aside>
</div>
