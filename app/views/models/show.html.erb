<% content_for :title, "#{@model.title} — Tinkerex" %>

<nav class="breadcrumb" aria-label="Model path">
  <%= link_to "Models", models_path %>
  <span class="sep" aria-hidden="true">/</span>
  <span aria-current="page"><%= @model.title %></span>
</nav>

<div class="page-head">
  <div>
    <h1><%= @model.title %></h1>
    <span class="badge mstatus-<%= @model.print_status %>"><%= @model.print_status.tr("_", " ") %></span>
  </div>
  <div class="head-actions">
    <%= link_to "Edit", edit_model_path(@model), class: "linkbtn" %>
    <% if @model.folder_node_id %>
      <%= link_to "Open in Files", files_path(folder: @model.folder_node_id), class: "linkbtn" %>
    <% end %>
    <%= button_to "Delete", model_path(@model), method: :delete, class: "linkbtn danger",
                  form: { data: { turbo_confirm: "Delete #{@model.title}? (files are kept)" } } %>
  </div>
</div>

<div class="model-layout">
  <%# MAIN column: the cover image, then a gallery, then the instructions PDF UNDER the image
      (Printables-style), then notes. %>
  <div class="model-main">
    <div class="model-hero">
      <% if @cover_att&.role == "image" %>
        <%= image_tag blob_file_path(@model.cover_node_id), class: "model-hero-img", alt: @model.title %>
      <% elsif @model.cover_node_id %>
        <span class="thumb file-cell model-hero-thumb"
              data-controller="thumbs" data-thumbs-url-value="<%= thumbnails_files_path %>"
              data-thumbs-target="cell" data-node-id="<%= @model.cover_node_id %>" data-ext="">
          <%= render "files/thumb", thumb: @covers.thumb(@model.cover_node_id), ext_label: "" %>
        </span>
      <% else %>
        <span class="model-hero-empty" aria-hidden="true">🧊</span>
      <% end %>
    </div>

    <% images = Array(@by_role["image"]) %>
    <% if images.size > 1 %>
      <div class="image-gallery">
        <% images.each do |a| %>
          <%= link_to file_path(a.node_id) do %>
            <%= image_tag blob_file_path(a.node_id), alt: @nodes[a.node_id]&.name, loading: "lazy" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% instructions = Array(@by_role["instructions"]) %>
    <% if instructions.present? %>
      <section class="model-instructions">
        <h2>Instructions</h2>
        <% instructions.each do |a| %>
          <iframe class="preview-pdf" src="<%= blob_file_path(a.node_id) %>" title="<%= @nodes[a.node_id]&.name %>"></iframe>
        <% end %>
      </section>
    <% end %>

    <% if @model.notes.present? %>
      <section class="model-notes"><h2>Notes</h2><%= render_note(@model.notes) %></section>
    <% end %>
  </div>

  <%# SIDE column: metadata, the files as a scrollable folder tree, then the print log. %>
  <aside class="model-side">
    <dl class="meta">
      <% if @model.designer.present? %><dt>Designer</dt><dd><%= @model.designer %></dd><% end %>
      <% if @model.license.present? %><dt>License</dt><dd><%= @model.license %></dd><% end %>
      <% if @model.source_url.present? %>
        <dt>Source</dt>
        <dd>
          <% if @model.source_url.match?(%r{\Ahttps?://}i) %>
            <%= link_to @model.source_url, @model.source_url, target: "_blank", rel: "noopener" %>
          <% else %>
            <%= @model.source_url %>
          <% end %>
        </dd>
      <% end %>
      <% if @model.tags.any? %><dt>Tags</dt><dd><%= @model.tag_list %></dd><% end %>
      <dt>Added</dt><dd><%= @model.created_at.strftime("%Y-%m-%d") %></dd>
    </dl>

    <section class="model-files">
      <h2>Files <span class="muted">(<%= @file_count %>)</span></h2>
      <% if @file_tree.present? %>
        <div class="file-tree-box"><%= render "file_tree", nodes: @file_tree %></div>
      <% else %>
        <p class="muted">No files yet.</p>
      <% end %>
    </section>

    <%= render "print_log" %>
  </aside>
</div>
