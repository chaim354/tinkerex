<% content_for :title, "Set a new password — Tinkerex" %>

<div class="auth-card">
  <h1>Set a new password</h1>

  <% if @user&.errors&.any? %>
    <div class="flash flash-alert">
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= form_with url: password_path(token: params[:token]), method: :patch, class: "auth-form" do |f| %>
    <%= f.password_field :password, placeholder: "New password", required: true, autofocus: true %>
    <%= f.password_field :password_confirmation, placeholder: "Confirm new password", required: true %>
    <%= f.submit "Update password" %>
  <% end %>
</div>
