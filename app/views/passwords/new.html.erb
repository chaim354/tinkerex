<% content_for :title, "Reset password — Tinkerex" %>

<div class="auth-card">
  <h1>Reset your password</h1>
  <p class="muted">Enter your email and we'll send reset instructions.</p>

  <%= form_with url: passwords_path, method: :post, class: "auth-form" do |f| %>
    <%= f.email_field :email, placeholder: "you@example.com", required: true, autofocus: true %>
    <%= f.submit "Send reset link" %>
  <% end %>

  <p class="muted"><%= link_to "Back to sign in", login_path %></p>
</div>
