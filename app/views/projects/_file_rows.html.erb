<%#
  A group's files as a table — the list view's rendering for exactly the rows _file_tile.html.erb
  draws as tiles (Maker::ProjectFolderListing::Row), wherever they come from: a folder section,
  Loose or Backups. `.table` is the shared component (components.css);
  `.project-files` carries only this page's column widths/drops (pages/projects.css), the same
  split files/_list.html.erb's `table.files` makes.

  `row.section` is precomputed by whoever built the row (Maker::ProjectFolderListing for a folder
  row) — this partial never walks the tree itself. Blank
  reads as "Loose", the sweep's own name for the folder's root.

  THE ROW CARRIES THE TILE'S RIGHT-CLICK MENU (stage 4, S4-1) — `file_menu_data`, the one builder
  _file_tile.html.erb uses, emitted on the `<tr>` through `tag.tr` so a nil addon origin is DROPPED
  rather than rendered as `data-addon-open-url=""` (FilesHelper's own rule). Switching to List used
  to lose Note, Download and "Edit in <Addon>" silently; filemenu_controller.js#open reads `href`
  off the cell or its first `<a>`, so Open lands where the name links with no controller change.

  THE NAME OPENS THE FILE (file_path), the same target as _file_tile.html.erb's link, so Tiles and
  List agree about where a file opens from the hub — and how: a click opens it, a double-click
  opens it in a new tab (FilesHelper#file_open_data, on the link; the menu stays on the `<tr>`).

  ORIGIN READS @addon_origins, THE SAME HASH EVERY TILE ON THIS PAGE ALREADY READS FOR ITS
  right-click menu (AddonOrigins#addon_origins_for, one Registry lookup for the whole page) — never
  a second resolution here. A row with no addon origin answers nil and the cell reads "—". The
  label is parsed rather than re-derived because nothing renders the bare addon title today outside
  this cell — see AddonOrigins' own comment on why `title` isn't a key in that hash.

  Optional local `notes` ({ node_id => sentence }) puts the tile's one-line note under the name here
  too.
%>
<% notes = local_assigns.fetch(:notes, {}) %>
<%# VERSION STACKS (Shop manual spec §9): `figures` (ProjectsHelper#stack_figures) is what the group
    draws when its panel stacks — a Row, or a StackFigure drawn as one row whose name opens its
    members beneath it (stack_controller.js, on the panel). Without it, every row stands alone. %>
<% figures = local_assigns.fetch(:figures, rows) %>
<table class="table project-files">
  <thead>
    <tr>
      <th class="col-name">Name</th>
      <th class="col-section">Section</th>
      <th class="num col-size">Size</th>
      <th class="col-modified">Modified</th>
      <th class="col-origin">Origin</th>
    </tr>
  </thead>
  <tbody>
    <% figures.each do |figure| %>
      <% if figure.is_a?(ProjectsHelper::StackFigure) %>
        <% stack = figure.stack %>
        <% latest = figure.latest.node %>
        <% dom = stack_dom_id(stack) %>
        <% member_ids = figure.rows.each_index.map { |i| "#{dom}-#{i}" } %>
        <tr class="stack-row">
          <td class="col-name">
            <%= tag.button(type: "button", id: "#{dom}-toggle", class: "stack-toggle",
                           aria: { expanded: "false", controls: member_ids.join(" ") },
                           data: { action: "stack#toggle" }) do %><span class="stack-name"><%= stack.name %></span> <span class="badge stack-count"><%= stack_count_label(stack) %></span><% end %>
          </td>
          <td class="muted col-section"><%= figure.latest.section.presence || "Loose" %></td>
          <td class="num muted col-size"><%= latest.size ? number_to_human_size(latest.size) : "—" %></td>
          <td class="muted col-modified"><%= latest.mtime ? time_at(time_from_nanos(latest.mtime)) : "—" %></td>
          <td class="muted col-origin">—</td>
        </tr>
      <% end %>
      <% (figure.is_a?(ProjectsHelper::StackFigure) ? figure.rows.each_with_index.to_a : [ [ figure, nil ] ]).each do |row, member_index| %>
      <% node = row.node %>
      <% origin = @addon_origins[row.node_id] %>
      <% member = member_index && { id: member_ids[member_index], role: member_index.zero? ? "latest" : "older" } %>
      <%= tag.tr(id: member&.dig(:id), class: ("stack-member" if member), hidden: member.present?, data: file_menu_data(node, origin)) do %>
        <td class="col-name">
          <%= link_to node.name, file_path(row.node_id), data: file_open_data %>
          <% if (note = notes[row.node_id]) %><span class="row-note muted"><%= note %></span><% end %>
          <% if member %>
            <span class="stack-role"><%= member[:role] %></span>
            <%= button_to "Pull out", file_stack_exclusion_path(row.node_id), method: :post, class: "linkbtn stack-pull-out",
                          form_class: "stack-pull-out-form", aria: { label: "Pull #{node.name} out of its stack" } %>
          <% elsif @stacks&.pulled_out?(row.node_id) %>
            <%= button_to "Put back", file_stack_exclusion_path(row.node_id), method: :delete, class: "linkbtn stack-put-back",
                          form_class: "stack-put-back-form", aria: { label: "Put #{node.name} back in its stack" } %>
          <% end %>
        </td>
        <td class="muted col-section"><%= row.section.presence || "Loose" %></td>
        <td class="num muted col-size"><%= node.size ? number_to_human_size(node.size) : "—" %></td>
        <td class="muted col-modified">
          <%= node.mtime ? time_at(time_from_nanos(node.mtime)) : "—" %>
        </td>
        <td class="muted col-origin"><%= origin ? origin[:title] : "—" %></td>
      <% end %>
      <% end %>
    <% end %>
  </tbody>
</table>
