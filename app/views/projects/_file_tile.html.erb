<%#
  ONE ROW'S TILE — thumbnail + name, plus (for a Linked row only) the Detach/Move-into-project
  corner. Extracted from _attachment_group.html.erb (stage 3, S3-1) so _file_tree_section.html.erb
  and _generated_group.html.erb can render the identical tile without a second copy of the
  seven-key thumb_cell_data/file_menu_data wire contract (docs/invariants/files-preview.md).

  Local: row (Maker::ProjectFolderListing::Row). Reads @project, @addon_origins and @page_thumbs
  off the enclosing template — exactly as the block this was extracted from always did — because
  every caller on this page already builds those three the same way, over the same tile_ids union.
%>
<% node = row.node %>
<% ext = File.extname(node.name).delete(".").upcase.first(4) %>
<div class="attachment-tile">
  <%= link_to file_path(row.node_id), class: "grid-card file-cell",
              data: thumb_cell_data(row.node_id, ext)
                      .merge(file_menu_data(row.node_id, @addon_origins[row.node_id])) do %>
    <%= render "files/thumb", thumb: @page_thumbs.thumb(row.node_id), ext_label: ext %>
    <span class="grid-name"><%= node.name %></span>
  <% end %>
  <% if row.linked? %>
    <div class="tile-meta">
      <%= button_to "Detach", attachment_path(row.attachment), method: :delete, class: "btn small danger tile-detach",
                    form: { data: { turbo_confirm: "Detach #{node.name}? (the file itself is kept)" } } %>
      <%= button_to "Move into project", relocate_project_attachments_path(@project),
                    params: { node_id: row.node_id }, class: "btn small tile-move" %>
    </div>
  <% end %>
</div>
