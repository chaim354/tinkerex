<%#
  "AT A GLANCE" (the Shop manual, slice 5): the project's facts as a list beside the head, where the
  stats line under it used to be. It keeps that line's class (`project-stats`) and its rule: EVERY
  VALUE IS SOMETHING ProjectsController#show ALREADY LOADED — @listing, @linked_rows, @tasks,
  @entries, @sheets, @releases and the listing's own tree — so page_query_budget_test.rb's "does not
  grow" holds with no counter cache, and the list adds no query.

  IT COUNTS ONLY WHAT THE PAGE SHOWS (2026-11-02, the UX audit's C1/C7): a panel that is absent
  (empty, on demand) or hidden says nothing here; one the project's type hid while it holds rows is
  named in "Also in this project" instead. The file count is the FOLDER's (@listing.total), not
  maker_file_attachments: an attachment to a node elsewhere in the library (Linked) is counted on its
  own, beside it.
%>
<% done = @tasks.count { |t| t.status == "done" } %>
<% repos = @listing.tree.select(&:repo?).map(&:name) %>
<% release = @releases.first if panel_on_page?(@panel_layout, "releases", @absent_panels) %>
<aside class="project-glance" aria-labelledby="project-glance-head">
  <h2 class="project-glance-head" id="project-glance-head">At a glance</h2>
  <dl class="meta project-stats">
    <dt>Type</dt>
    <dd><%= Maker::ProjectKind.label(@project.kind) %></dd>
    <dt>Files</dt>
    <dd><%= pluralize(@listing.total, "file") %><% if @linked_rows.any? %>, <%= @linked_rows.size %> linked<% end %></dd>
    <% if panel_on_page?(@panel_layout, "tasks", @absent_panels) %>
      <dt>Tasks</dt>
      <dd><%= done %> of <%= @tasks.size %> done</dd>
    <% end %>
    <% if panel_on_page?(@panel_layout, "build_log", @absent_panels) %>
      <dt>Build log</dt>
      <dd><%= pluralize(@entries.size, "entry") %></dd>
    <% end %>
    <% if panel_on_page?(@panel_layout, "sheets", @absent_panels) %>
      <dt>Sheets</dt>
      <dd><%= pluralize(@sheets.size, "sheet") %></dd>
    <% end %>
    <% if @listing.root_repo? || repos.any? %>
      <dt>Repository</dt>
      <dd><%= @listing.root_repo? ? "this folder" : repos.to_sentence %></dd>
    <% end %>
    <% if release %>
      <dt>Latest release</dt>
      <dd><%= release.version %>, <%= time_at(release.published_at, style: :date) %></dd>
    <% end %>
    <% if @listing.available? %>
      <dt>Folder</dt>
      <dd><%= link_to @listing.path, files_path(folder: @listing.folder_id) %></dd>
    <% end %>
  </dl>
</aside>
