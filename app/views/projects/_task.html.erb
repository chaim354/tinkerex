<%# One task row. The state mark is CSS-drawn from the status (todo hollow, doing half, done
    filled with a tick); the buttons are the same status transitions as before, plus delete.
    DELETE IS THE PAGE'S ONE DESTRUCTIVE SHAPE (2026-11-02, the UX audit's C4): `linkbtn danger
    small` with its word, where a bare "✕" and a confirm reading only "Delete task?" named nothing;
    the confirm names the task now (§H). `task-delete` stays for pages/projects.css and the tests. %>
<div class="task-row">
  <span class="task-state task-state--<%= task.status %>" aria-hidden="true"></span>
  <span class="task-title"><%= task.title %></span>
  <div class="task-actions">
    <% (Maker::Task::STATUSES - [ task.status ]).each do |to| %>
      <%= button_to to.capitalize, task_path(task), method: :patch,
                    params: { task: { status: to } }, class: "task-move" %>
    <% end %>
    <%= button_to "Delete", task_path(task), method: :delete, class: "linkbtn danger small task-delete",
                  "aria-label": "Delete the task #{task.title}",
                  form: { data: { turbo_confirm: "Delete the task “#{task.title}”?" } } %>
  </div>
</div>
