<%#
  THE TIDY-UP LIST (the Shop manual's §9, 2026-11-19): a full-width plate of numbered suggestions under
  the project's head (spec §3 and §6: "a plate whose cells are numbered suggestions"). Rendered only
  while one is undismissed. Maker::TidyUp decided every cell; this partial words them and links
  them, and asks nothing of the database.

  Each cell is a number, a title, one sentence naming the files, and its actions: ways to the file or
  page where the maker fixes it (Rename and Move are on a file's own page, the commit box is the
  repository's) and Dismiss. Dismiss posts the kind and the subject only; the server looks the
  suggestion up again and stores its state (Projects::TidyDismissalsController), so a dismissed
  suggestion comes back when what it is about changes.

  `tidy` is the Maker::TidyUp the page computed.
%>
<% shown = tidy.shown %>
<% titles = { "loose" => "Loose file", "uncommitted" => "Not committed", "export_older" => "Out of date" } %>
<section class="plate tidy-up" id="tidy-up" aria-labelledby="tidy-up-head">
  <div class="plate-head">
    <h2 class="tidy-up-head" id="tidy-up-head">Tidy up</h2>
    <span class="plate-count"><%= count_label(tidy.count, "suggestion") %></span>
  </div>
  <ol class="plate-cells">
    <% shown.each_with_index do |suggestion, i| %>
      <% detail = suggestion.detail %>
      <li class="plate-cell tidy-cell tidy-cell--<%= suggestion.kind.dasherize %>">
        <h3 class="plate-cell-head"><span class="plate-cell-num"><%= i + 1 %></span> <%= titles.fetch(suggestion.kind) %></h3>
        <p class="plate-cell-text">
          <% case suggestion.kind %>
          <% when "loose" %>
            <%= detail.node.name %> sits in the project folder, and <%= detail.blocked_by %> already
            exists, so it cannot be filed. Rename one to file it.
          <% when "uncommitted" %>
            <%= detail.root ? "This folder's repository" : "The #{detail.name} repository" %> has
            <%= count_label(detail.count, "changed file") %> that git has not committed.
          <% when "export_older" %>
            <%= detail.derived_name %> was made from <%= detail.source_name %>, which has changed since.
          <% end %>
        </p>
        <div class="plate-cell-actions">
          <% case suggestion.kind %>
          <% when "loose" %>
            <%= link_to "Open it", file_path(detail.node.node_id), class: "linkbtn", data: file_open_data %>
            <%= link_to "Open #{detail.dir.name}", files_path(folder: detail.dir.node_id), class: "linkbtn" %>
          <% when "uncommitted" %>
            <%= link_to "Review", repo_commit_path(detail.root_node_id), class: "linkbtn" %>
          <% when "export_older" %>
            <%= link_to "Open it", file_path(detail.derived_id), class: "linkbtn", data: file_open_data %>
            <%= link_to "Open the source", file_path(detail.source_id), class: "linkbtn", data: file_open_data %>
          <% end %>
          <%= button_to "Dismiss", project_tidy_dismissals_path(@project),
                        params: { kind: suggestion.kind, subject: suggestion.subject },
                        class: "linkbtn muted", form_class: "button_to tidy-dismiss" %>
        </div>
      </li>
    <% end %>
  </ol>
  <% if tidy.count > shown.size %>
    <p class="muted tidy-up-more"><%= shown.size %> of <%= tidy.count %> shown. The rest come in as these are dealt with.</p>
  <% end %>
</section>
