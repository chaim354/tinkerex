<%#
  Inline "upload a new file and attach it" — two flows, one per deployment (spec §2), reusing the
  library upload machinery. Locals: upload_url (share/s3 multipart write-and-attach), attach_url
  (chunk final JSON attach step), redirect_url.

  OPTIONAL LOCAL `primary:` — whether this uploader is THE action of the page it lands on
  (decision 3 of the UI-cohesion spec). It DEFAULTS TO FALSE, which is the load-bearing half: this
  partial has four call sites and three of them are row- or panel-level, so a caller that forgets
  gets the quiet face rather than another accent button. The Files page and the project page's
  Files panel pass true; a build-log entry and Home's hero do not — Home's one action is
  "New project" and a log row's upload is not what either page exists for.
%>
<% upload_btn_class = local_assigns[:primary] ? "upload-btn primary" : "upload-btn" %>
<% if capabilities.port_writable? %>
  <%= form_with url: upload_url, method: :post, class: "uploader",
                data: { turbo: false }, html: { multipart: true } do |f| %>
    <%# Where to send the browser after the upload+attach. OPTIONAL: the project page and a
        build-log entry omit it and the controller defaults to the project page; the Files-page
        (current-project) uploader passes files_path so the user stays in Files. This mirrors the
        chunk branch's data-uploader-redirect-url-value below — the two flows now land in the same
        place. Projects::UploadsController re-validates it with url_from (a relative path only), so
        this field can never become an open redirect. %>
    <% if local_assigns[:redirect_url].present? %>
      <%= hidden_field_tag :redirect_url, redirect_url %>
    <% end %>
    <label class="<%= upload_btn_class %>">
      <%# `include_hidden: false` IS LOAD-BEARING. `f.file_field` with `multiple: true` renders a
          companion `<input name="file[]" type="hidden" value="">` so an empty selection still
          submits the key — which put a bare "" at the head of `params[:file]`, and the server
          called `original_filename` on a String and 500'd. Nothing needs that marker here: the
          field's own `onchange` is the only thing that submits this form, so it never fires with
          an empty selection. Found by uploading four real files through the real form; the
          Rack::Test suites POSTed a Ruby array and never sent the marker at all, which is §14d's
          "assert the rendered field name" with a different attribute. %>
          <%= f.file_field :file, multiple: true, include_hidden: false,
                       onchange: "this.form.requestSubmit()", hidden: true %>
      <span>Upload &amp; attach</span>
    </label>
  <% end %>
<% else %>
  <span class="uploader" data-controller="uploader"
        data-uploader-begin-url-value="<%= begin_upload_files_path %>"
        data-uploader-finalize-url-value="<%= finalize_upload_files_path %>"
        data-uploader-attach-url-value="<%= attach_url %>"
        data-uploader-redirect-url-value="<%= redirect_url %>"
        data-uploader-parent-node-id-value="<%= local_assigns[:parent_node_id] %>">
    <label class="<%= upload_btn_class %>">
      <input type="file" multiple data-uploader-target="input" data-action="uploader#upload" hidden>
      <span>Upload &amp; attach</span>
    </label>
    <span class="upload-status" data-uploader-target="status"></span>
  </span>
<% end %>
