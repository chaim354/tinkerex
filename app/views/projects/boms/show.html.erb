<% content_for :title, "Bill of materials — #{@project.name} — Tinkerex" %>

<% content_for :crumbs do %>
  <nav class="breadcrumb" aria-label="Project path">
    <%= link_to "Projects", projects_path %>
    <span class="sep" aria-hidden="true">/</span>
    <%= link_to @project.name, project_path(@project) %>
    <span class="sep" aria-hidden="true">/</span>
    <span aria-current="page">Bill of materials</span>
  </nav>
<% end %>

<%# NO "Back to PROJECT" BUTTON IN THE HEAD (UX audit A4, design-system.md rule 9): the crumb above
    already names the project and goes there, and a parent-named button beside it was the second
    way of going up a level on one page. %>
<div class="page-head">
  <div class="page-title">
    <h1>Bill of materials</h1>
    <% if @bom %><span class="badge">rev <%= @bom.revision %></span><% end %>
  </div>
</div>

<%# ALL of @lines, both as `lines:` (the rollup's input) and `shown:` (the table renders every
    row) — `more_path: nil` is what tells projects/_bom_lines this is the uncapped surface, so it
    never renders the panel's "Showing N of M" link. %>
<%= render "projects/bom_lines", lines: @lines, shown: @lines, rollup: @rollup, nodes: @line_nodes,
           project: @project, bom: @bom, more_path: nil %>
<%# The panel's composer, under the table here — one partial, so a refusal posted from either
    surface comes back as the same open composer (Projects::ComposerRefusal). %>
<%= render "projects/bom_composer", project: @project, items: @items, suppliers: @suppliers %>
