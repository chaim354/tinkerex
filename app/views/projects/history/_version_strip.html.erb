<%# ONE FILE'S VERSIONS AS TILES. EVERY VERSION IS RENDERED, INCLUDING THE ONES WHOSE BYTES ARE
    GONE. Omitting an unavailable version tells the maker their file has less history than it does,
    and does it quietly; a greyed tile says what actually happened. That is the same choice §14a
    makes for an unmounted share — a recoverable-looking state and a permanent one must never
    render identically — and here they are two different tiles with two different words on them.

    The tile state is resolved in Projects::HistoryController#tile_state, not here: a content
    version has no fetchable bytes at all, and a view that re-derived that rule would eventually
    get it wrong in the direction that shows a text file's history as lost. %>
<section class="version-strip panel">
  <h2>File versions</h2>

  <% if path.blank? %>
    <p class="version-strip-idle muted">
      Open a file from this project and choose History to see every version of it recorded here.
    </p>
  <% elsif tiles.empty? %>
    <p class="version-strip-idle muted">
      No recorded versions of <code><%= path %></code>.
    </p>
  <% else %>
    <p class="version-strip-path muted">Versions of <code><%= path %></code></p>
    <%# THE DOOR ONTO THE COMPARE SURFACE, and it is offered only where there are two versions to
        compare — a link that leads to "there is nothing to compare" is a link that teaches people
        not to click it. `project` is a LOCAL rather than the ivar the rest of this page uses,
        because a partial that reads an ivar can only ever be rendered from one action. %>
    <% if tiles.size > 1 %>
      <p class="version-strip-compare">
        <%= link_to "Compare two versions", project_history_compare_path(project, path: path) %>
      </p>
    <% end %>
    <ol class="version-tiles">
      <% tiles.each do |tile| %>
        <li class="version-tile is-<%= tile.state.dasherize %>">
          <%# EVERY `when` TAG SITS ALONE ON ITS LINE, AND THAT IS A RUBY REQUIREMENT HERE, NOT
              layout taste: text left on the same line as the tag leaves the indentation before it
              as OUTPUT between `case` and its first `when`, which is a template that will not
              compile at all. It fails loudly the first time the page renders. %>
          <div class="version-tile-art">
            <% case tile.state %>
            <% when "ready" %>
              <img src="<%= url_for(tile.preview.asset) %>" loading="lazy"
                   alt="Preview of <%= path %> at <%= tile.version.oid[0, 7] %>">
            <% when "pending" %>
              <span class="version-tile-placeholder" aria-hidden="true">…</span>
            <% when "not_kept" %>
              <span class="version-tile-placeholder" aria-hidden="true">✕</span>
            <% else %>
              <span class="version-tile-placeholder" aria-hidden="true">◻</span>
            <% end %>
          </div>
          <div class="version-tile-meta">
            <code class="version-oid"><%= tile.version.oid[0, 7] %></code>
            <span class="version-message"><%= tile.version.message.strip %></span>
            <time class="version-time muted"
                  datetime="<%= tile.version.time.utc.iso8601 %>"
                  title="<%= tile.version.time.strftime("%Y-%m-%d %H:%M") %>"><%= time_ago_in_words(tile.version.time) %> ago</time>
            <%# THE SENTENCE COMES FROM `Tile#label`, NOT FROM A `case` HERE. The compare panel
                describes the same five states, and two copies of this vocabulary is how "not kept"
                and "failed" — two different facts — come to wear one word (§14a). %>
            <span class="version-state muted"><%= tile.label %></span>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
