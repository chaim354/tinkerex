<% content_for :title, "Compare — #{@project.name} — Tinkerex" %>

<nav class="breadcrumb" aria-label="Project path">
  <%= link_to "Projects", projects_path %>
  <span class="sep" aria-hidden="true">/</span>
  <%= link_to @project.name, project_path(@project) %>
  <span class="sep" aria-hidden="true">/</span>
  <%= link_to "History", project_history_path(@project, path: @path) %>
  <span class="sep" aria-hidden="true">/</span>
  <span aria-current="page">Compare</span>
</nav>

<div class="page-head">
  <h1>Compare versions</h1>
</div>

<%# THE SAME FOUR PAGE STATES AS THE HISTORY PANEL, WEARING THE SAME CLASSES AND THE SAME
    SENTENCES, because they are the same four facts about the same repository — an unmounted share
    must not read as "you have no history" on this page either. The controller resolves them once
    for both actions; what this markup must keep is that the retryable one and the two permanent
    ones never read alike. %>
<% if @state == :unreachable %>
  <p class="history-unreachable notice">
    The library is not reachable right now, so this project's history cannot be read.
    Nothing is lost — check that the share is mounted, then reload.
  </p>
<% elsif @state == :unavailable %>
  <p class="history-unavailable notice">
    This project's library folder is missing, so there is nowhere to read its history from.
    Restore or re-create the folder and the next scan will pick it up.
  </p>
<% elsif @state == :unmanaged %>
  <p class="history-unmanaged notice">
    This project folder holds a git repository that this app did not create, so it is left alone.
    There is nothing here to compare; read its history with git directly.
  </p>
<% elsif @state == :empty %>
  <p class="history-empty muted">
    No history recorded yet. Versions appear here once this project's files have been still long
    enough for a scan to record them.
  </p>
<% elsif @path.blank? %>
  <p class="version-compare-idle muted">
    Open a file from this project and choose Compare to put two of its versions side by side.
  </p>
<% elsif @tiles.size < 2 %>
  <p class="version-compare-idle muted">
    <code><%= @path %></code> has
    <%= @tiles.empty? ? "no recorded versions" : "only one recorded version" %>,
    so there is nothing to compare it against yet.
  </p>
<% else %>
  <%# ONE OPTION PER RECORDED VERSION, newest first, built once and offered to both selects. %>
  <% choices = @tiles.map { |t| [ "#{t.version.oid[0, 7]} — #{t.version.message.strip}", t.version.oid ] } %>
  <%# A GET FORM, so a comparison is a LINK someone can send. `scope: :compare` is what makes the
      two selects post `compare[from]` and `compare[to]`, which is what the controller reads —
      leave it off and the builder emits bare `from` and `to` while the controller goes on reading
      a `compare` hash that is never there, silently comparing the default pair forever (§14d).
      The path rides as its own top-level field rather than inside the scope, because it is the
      same `path` parameter every other door on this feature takes. %>
  <%= form_with url: project_history_compare_path(@project), method: :get, scope: :compare,
                class: "version-compare-form" do |f| %>
    <%= hidden_field_tag :path, @path %>
    <span class="field-inline">
      <%= f.label :from, "Older" %>
      <%= f.select :from, options_for_select(choices, @comparison&.from&.version&.oid) %>
    </span>
    <span class="field-inline">
      <%= f.label :to, "Newer" %>
      <%= f.select :to, options_for_select(choices, @comparison&.to&.version&.oid) %>
    </span>
    <%= f.submit "Compare" %>
  <% end %>

  <% if @comparison.nil? %>
    <p class="version-compare-idle muted">Choose two versions of <code><%= @path %></code>.</p>
  <% elsif @comparison.kind == :text %>
    <%# THE TEXT HALF. Reached only where `Maker::Git::Tracking` calls this file CONTENT, so both
        versions' bytes are in the repository and there is a real diff to show. %>
    <section class="version-compare is-text panel">
      <h2>Changes to <code><%= @path %></code></h2>
      <p class="compare-pair muted">
        <code class="version-oid"><%= @comparison.from.version.oid[0, 7] %></code>
        <span aria-hidden="true">→</span>
        <code class="version-oid"><%= @comparison.to.version.oid[0, 7] %></code>
      </p>

      <% diff = @comparison.diff %>
      <% if diff.refused? %>
        <%# A REFUSAL, NOT A TRUNCATION. A diff cut off at the cap and rendered without saying so is
            the well-formed lie this repo keeps recording, so nothing partial is drawn and the
            measured size is named against the limit it passed. %>
        <p class="diff-refused notice">
          <% case diff.refused %>
          <% when :too_large %>
            One of these versions is too large to diff here —
            <%= number_with_delimiter(diff.before_size.lines) %> and
            <%= number_with_delimiter(diff.after_size.lines) %> lines
            (<%= number_to_human_size(diff.before_size.bytes) %> and
            <%= number_to_human_size(diff.after_size.bytes) %>),
            against a limit of <%= number_with_delimiter(Maker::Git::TextDiff::MAX_LINES) %> lines
            and <%= number_to_human_size(Maker::Git::TextDiff::MAX_BYTES) %> per version.
            Nothing is shown rather than part of a diff that would look complete.
          <% when :binary %>
            These bytes are not text this page can show — the file is tracked by name, and this one
            holds a NUL byte or an invalid UTF-8 sequence. The versions themselves are intact.
          <% when :missing %>
            One of these two commits no longer has this file, so there is nothing to compare.
            Reload the history and pick another pair.
          <% else %>
            This comparison could not be produced.
          <% end %>
        </p>
      <% elsif diff.identical? %>
        <p class="diff-identical muted">These two versions are byte-for-byte identical.</p>
      <% else %>
        <p class="diff-summary muted">
          <%= pluralize(diff.added, "line") %> added,
          <%= pluralize(diff.removed, "line") %> removed.
        </p>
        <%# THE TABLE SCROLLS INSIDE ITS OWN BOX, never the page: a long source line must not push
            the whole layout sideways. %>
        <div class="diff-scroll">
          <table class="diff-table">
            <tbody>
              <% diff.rows.each do |row| %>
                <tr class="diff-row is-<%= row.kind %>">
                  <% if row.kind == :gap %>
                    <%# COUNTED, NEVER A BARE ELLIPSIS. Saying how many lines are hidden is what
                        keeps an elision from being the truncation refused above. %>
                    <td class="diff-gap-note" colspan="3">
                      <%= pluralize(row.skipped, "unchanged line") %> hidden
                    </td>
                  <% else %>
                    <td class="diff-num"><%= row.old_number %></td>
                    <td class="diff-num"><%= row.new_number %></td>
                    <td class="diff-text"><%= row.text %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  <% else %>
    <%# THE VISUAL HALF, AND THE REASON THIS FEATURE IS TWO SURFACES. A pointer version's bytes are
        a mesh or a CAD kernel's serialisation; a line diff of them is noise, and two renders in
        register are the only comparison worth showing.

        `data-controller` IS DECLARED WHENEVER THE COMPARISON IS VISUAL, including while a render
        is still pending or was never kept. Those cases draw no slider, so the controller finds no
        targets and returns — which it is written to tolerate. Declaring it conditionally would put
        the same fact in two places and neither would say so.

        The opening clip is set SERVER-SIDE, inline: with no JavaScript the panel is still a real
        50/50 comparison instead of the newer render covering the older one. %>
    <section class="version-compare is-visual panel"
             data-controller="version-compare" style="--compare-position: 50%">
      <h2>Compare <code><%= @path %></code></h2>
      <p class="compare-pair muted">
        <code class="version-oid"><%= @comparison.from.version.oid[0, 7] %></code>
        <span aria-hidden="true">→</span>
        <code class="version-oid"><%= @comparison.to.version.oid[0, 7] %></code>
      </p>

      <% if @comparison.from.ready? && @comparison.to.ready? %>
        <div class="compare-stage">
          <img class="compare-before" data-version-compare-target="before"
               src="<%= url_for(@comparison.from.preview.asset) %>"
               alt="<%= @path %> at <%= @comparison.from.version.oid[0, 7] %>">
          <img class="compare-after" data-version-compare-target="after"
               style="clip-path: inset(0 0 0 50%)"
               src="<%= url_for(@comparison.to.preview.asset) %>"
               alt="<%= @path %> at <%= @comparison.to.version.oid[0, 7] %>">
          <span class="compare-seam" aria-hidden="true"></span>
        </div>
        <input class="compare-slider" type="range" min="0" max="100" step="1" value="50"
               data-version-compare-target="slider"
               data-action="input->version-compare#update"
               aria-label="How much of the newer version to show">
      <% else %>
        <%# NOT EVERY PAIR HAS TWO PICTURES, and each side says which of the five states it is in
            rather than sharing one "no preview" sentence — "not kept" and "failed" are different
            facts and only one of them is a bug. The wording is Tile#label's, in one place. %>
        <ul class="compare-unready">
          <% [ [ "Older", @comparison.from ], [ "Newer", @comparison.to ] ].each do |side, tile| %>
            <li class="compare-side is-<%= tile.state.dasherize %>">
              <span class="compare-side-label"><%= side %></span>
              <code class="version-oid"><%= tile.version.oid[0, 7] %></code>
              <span class="version-state muted"><%= tile.label %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
<% end %>
