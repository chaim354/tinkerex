<% content_for :title, "Projects — Tinkerex" %>

<div class="page-head">
  <h1><%= @archived_view ? "Archived projects" : "Projects" %></h1>
  <%= link_to "New project", new_project_path, class: "btn primary" unless @archived_view %>
</div>

<%# Tag filter chips (stage 2, S2-5) -- only when the user has at least one tagged project, same
    "only when there's something to filter by" rule models/index.html.erb's own tag select
    follows. "All" keeps the current archived view (its own toggle is the note/link below, not
    this row) and simply drops the tag param.

    TYPE CHIPS BESIDE THEM (stage 4, S4-7; story 6.5), on the same "only when there is something to
    filter by" rule and in their OWN row rather than mixed into the tags: a tag is the maker's own
    word and a kind is one of six the app knows, and a single "All" that cleared both would make
    each filter unreachable while the other was on. For the same reason every link in either row
    carries the OTHER filter -- a tag click that silently dropped the type is the kind of quiet
    change this stage keeps removing. `other` is absent from @project_kinds by construction
    (ProjectsController#index): it is the column default, and a chip for "everything nobody typed"
    filters nothing. %>
<% if @project_tags.any? || @project_kinds.any? %>
  <div class="toolbar projects-toolbar">
    <% if @project_kinds.any? %>
      <span class="chips">
        <%= link_to "All types", projects_path(tag: @tag, archived: (@archived_view ? 1 : nil)),
                    class: "filter chip#{' active' if @kind.blank?}" %>
        <% @project_kinds.each do |k| %>
          <%= link_to Maker::ProjectKind.label(k),
                      projects_path(kind: k, tag: @tag, archived: (@archived_view ? 1 : nil)),
                      class: "filter chip#{' active' if @kind == k}" %>
        <% end %>
      </span>
    <% end %>
    <% if @project_tags.any? %>
      <span class="chips">
        <%= link_to "All", projects_path(kind: @kind, archived: (@archived_view ? 1 : nil)),
                    class: "filter chip#{' active' if @tag.blank?}" %>
        <% @project_tags.each do |t| %>
          <%= link_to t, projects_path(tag: t, kind: @kind, archived: (@archived_view ? 1 : nil)),
                      class: "filter chip#{' active' if @tag == t}" %>
        <% end %>
      </span>
    <% end %>
  </div>
<% end %>

<% if @projects.empty? %>
  <p class="projects-empty muted">
    <%= @archived_view ? "No archived projects." : "No projects yet. Create your first build." %>
  </p>
<% else %>
  <div class="projects-grid" data-controller="thumbs" data-thumbs-url-value="<%= thumbnails_files_path %>">
    <% @projects.each do |project| %>
      <%= render "card", project:, thumb: @covers.thumb(project.cover_node_id) %>
    <% end %>
  </div>
<% end %>

<% if @archived_view || @archived_count.positive? %>
  <p class="archived-note muted">
    <% if @archived_view %>
      <%= link_to "← Back to projects", projects_path %>
    <% else %>
      <%= link_to pluralize(@archived_count, "archived project"), projects_path(archived: 1) %>
    <% end %>
  </p>
<% end %>
