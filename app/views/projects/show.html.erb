<% content_for :title, "#{@project.name} — Tinkerex" %>

<% content_for :crumbs do %>
  <nav class="breadcrumb" aria-label="Project path">
    <%= link_to "Projects", projects_path %>
    <span class="sep" aria-hidden="true">/</span>
    <span aria-current="page"><%= @project.name %></span>
  </nav>
<% end %>

<div class="page-head project-head">
  <div class="page-title">
    <h1><%= @project.name %></h1>
    <% if @project.status == "archived" %>
      <span class="badge status-archived">Archived</span>
    <% end %>
    <% if @project.published? %>
      <span class="badge visibility-<%= @project.visibility %>"><%= @project.visibility.humanize %></span>
      <%# An unlisted project's link carries ?k=<token>, which IS the credential for that page --
          a public one needs none. %>
      <%= link_to "Public page",
                  public_project_path(@project.user.handle, @project.slug,
                                      **(@project.unlisted? ? { k: @project.unlisted_token } : {})),
                  class: "linkbtn small public-link" %>
    <% end %>
  </div>
  <div class="head-actions">
    <% if current_project == @project %>
      <span class="badge current-project-badge">★ Current project</span>
      <%= button_to "Clear", current_project_path, method: :delete, class: "btn small ghost" %>
    <% elsif @project.status != "archived" %>
      <%# An archived project cannot be the current project — CurrentProject scopes its lookup
          with `where.not(status: "archived")`, so this button would post successfully and change
          nothing, with no flash to say so. %>
      <%= button_to "Set as current", current_project_path, method: :patch,
                    params: { project_id: @project.id }, class: "btn small outline" %>
    <% end %>
    <%= link_to "Edit", edit_project_path(@project), class: "btn small" %>
    <% if @project.status == "archived" %>
      <%= button_to "Unarchive", unarchive_project_path(@project), method: :patch, class: "btn small" %>
    <% else %>
      <%= button_to "Archive", project_path(@project), method: :delete, class: "btn small danger",
                    form: { data: { turbo_confirm: "Archive #{@project.name}?" } } %>
    <% end %>
  </div>
</div>

<%= render "projects/move_conflict" %>

<% if @project.description.present? %>
  <p class="project-description"><%= @project.description %></p>
<% end %>
<%= tag_chips(@project) %>

<%# THE STATS LINE reads collections ProjectsController#show already loaded — @listing, @tasks,
    @entries, @sheets, @linked_rows — and nothing else, so page_query_budget_test.rb's "does not
    grow with attachments, tasks or build-log entries" holds without a counter cache. The file
    count is the FOLDER's (@listing.total), not maker_file_attachments — an attachment to a node
    living elsewhere in the library (Linked) is counted separately, right here, rather than folded
    into the first number. %>
<% done = @tasks.count { |t| t.status == "done" } %>
<p class="project-stats">
  <span><b><%= @listing.total %></b> <%= "file".pluralize(@listing.total) %></span>
  <% if @linked_rows.any? %>
    <span><b><%= @linked_rows.size %></b> linked</span>
  <% end %>
  <span><b><%= done %> of <%= @tasks.size %></b> <%= "task".pluralize(@tasks.size) %> done</span>
  <span><b><%= @entries.size %></b> log <%= "entry".pluralize(@entries.size) %></span>
  <span><b><%= @sheets.size %></b> <%= "sheet".pluralize(@sheets.size) %></span>
</p>

<div class="project-panels">
  <%= render "attachments" %>
  <%# Stage 3, S3-2: KiCad schematics/boards anywhere in the folder. The partial itself decides
      whether there is anything to show — see its own header comment. %>
  <%= render "schematics" %>
  <%# The board's fabrication outputs, rendered by tracespace. Beside Schematics because they are
      the same subject one stage further along — the design, then what goes to the board house —
      and the partial decides for itself whether the folder holds any. %>
  <%= render "fabrication" %>
  <%= render "build_log" %>
  <%= render "tasks" %>
  <%= render "bom" %>
  <%# Stage 3, S3-3: the wiring table. Locals, not @project/@connections -- the same partial is
      read-only on the public page later (S3-4), which has no reason to alias its own ivars to
      this partial's names. %>
  <%= render "wiring", project: @project, connections: @connections, editable: true %>
  <%# Stage 3, S3-5: releases. Locals for the same reason wiring takes them -- the public page
      renders its own partial over the same records, and neither has any business aliasing the
      other's ivars. %>
  <%= render "releases", project: @project, releases: @releases, current_tokens: @release_tokens,
             repos: @release_repos, editable: true %>
  <%= render "sheets" %>
</div>
