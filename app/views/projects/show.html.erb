<% content_for :title, "#{@project.name} — Tinkerex" %>

<% content_for :crumbs do %>
  <nav class="breadcrumb" aria-label="Project path">
    <%= link_to "Projects", projects_path %>
    <span class="sep" aria-hidden="true">/</span>
    <span aria-current="page"><%= @project.name %></span>
  </nav>
<% end %>

<div class="page-head project-head">
  <div>
    <h1><%= @project.name %></h1>
    <% if @project.status == "archived" %>
      <span class="badge status-archived">Archived</span>
    <% end %>
  </div>
  <div class="head-actions">
    <% if current_project == @project %>
      <span class="badge current-project-badge">★ Current project</span>
      <%= button_to "Clear", current_project_path, method: :delete, class: "linkbtn" %>
    <% elsif @project.status != "archived" %>
      <%# An archived project cannot be the current project — CurrentProject scopes its lookup
          with `where.not(status: "archived")`, so this button would post successfully and change
          nothing, with no flash to say so. %>
      <%= button_to "Set as current", current_project_path, method: :patch,
                    params: { project_id: @project.id }, class: "linkbtn" %>
    <% end %>
    <%= link_to "Edit", edit_project_path(@project), class: "linkbtn" %>
    <% if @project.status == "archived" %>
      <%= button_to "Unarchive", unarchive_project_path(@project), method: :patch, class: "linkbtn" %>
    <% else %>
      <%= button_to "Archive", project_path(@project), method: :delete, class: "linkbtn danger",
                    form: { data: { turbo_confirm: "Archive #{@project.name}?" } } %>
    <% end %>
  </div>
</div>

<%= render "projects/move_conflict" %>

<% if @project.description.present? %>
  <p class="project-description"><%= @project.description %></p>
<% end %>

<div class="project-panels">
  <%= render "attachments" %>
  <%= render "build_log" %>
  <%= render "tasks" %>
  <%= render "sheets" %>
</div>
