<%#
  The build log, newest first, read-only: no Delete, no "Add existing photo", no upload control.
  `entry.body` is Action Text and renders its own sanitized HTML — the same rich text the private
  page shows, with the same server-side text-only rule (Maker::TextOnlyRichText, §15).

  A photo is rendered only when its node is still LIVE (`pub.page_nodes`), which is the same check
  projects/_log_entry makes: an attachment whose file was deleted must not become a broken image.

  Local: pub (Maker::PublicProject).
%>
<% if pub.entries.any? %>
  <section class="panel build-log-panel">
    <div class="panel-head">
      <h2><%= panel_title(pub.layout, "build_log") %></h2>
      <span class="mono muted"><%= pluralize(pub.entries.size, "entry") %></span>
    </div>
    <%= panel_intro(pub.layout, "build_log") %>
    <ol class="log-timeline">
      <% pub.entries.each do |entry| %>
        <%# THE ANCHOR THE FEED POINTS AT (stage 3, S3-6). Every feed item's link is this page plus
            a fragment, so a reader that opens an entry lands ON it rather than at the top of a page
            that may hold fifty. public_feed_test.rb asserts the two agree. %>
        <li class="log-entry" id="entry-<%= entry.id %>">
          <time class="entry-time muted"><%= entry.logged_at.strftime("%Y-%m-%d") %></time>
          <%# A div, not a p: Action Text emits block-level markup and a <p> cannot legally contain it. %>
          <div class="entry-body"><%= entry.body %></div>
          <% photos = entry.file_attachments.select { |a| pub.page_nodes.key?(a.node_id) } %>
          <% if photos.any? %>
            <div class="entry-photos">
              <% photos.each do |att| %>
                <%= link_to pub.file_url_for(att.node_id), class: "photo-cell file-cell" do %>
                  <%= render "files/thumb", thumb: pub.thumbs.thumb(att.node_id), ext_label: "IMG",
                             url: pub.preview_url_for(att.node_id) %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
