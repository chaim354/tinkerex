<%#
  ONE PUBLISHED PROJECT, READ-ONLY, FOR ANYONE (stage 3, S3-4; spec §2.5).

  EVERY QUESTION GOES TO `pub` (Maker::PublicProject) — including "where does this file's link
  point", so the page and the file route cannot disagree about what is public. No form, no button,
  no link into a private path anywhere: a visitor is not the person who would change something,
  and public_project_test.rb asserts the absence directly rather than trusting this comment.

  AN EMPTY PANEL IS OMITTED, NOT RENDERED AS AN EMPTY STATE. "No connections yet." is an invitation
  to add one, which is exactly what a visitor cannot do; the private page keeps its empty states.
%>
<% content_for :title, "#{@project.name} — @#{@pub.handle}" %>
<% content_for :container_class, "public-main" %>

<% unless @project.publicly_listed? %>
  <%# UNLISTED MEANS "REACHABLE BY LINK", NOT "INDEXED". The token in the URL is the credential, and
      a crawler that found it once would keep the page in a result set forever. Public projects are
      deliberately indexable — that is the point of /explore. %>
  <% content_for :head do %>
    <meta name="robots" content="noindex">
  <% end %>
<% end %>

<%# STAGE 3, S3-6: THE FEED, DISCOVERABLE THE WAY A READER LOOKS FOR ONE. A second `content_for
    :head` block rather than a branch inside the one above -- content_for APPENDS, and the two say
    unrelated things (that block is about indexing an unlisted page, this one is a subscription).
    The href carries `k` through link_params like every other link on the page: an unlisted feed
    without the token is a 404, and a reader that saved a credential-less URL would poll one
    forever. %>
<% content_for :head do %>
  <link rel="alternate" type="application/atom+xml"
        title="<%= "#{@project.name} — @#{@pub.handle}" %>"
        href="<%= public_feed_path(@pub.handle, @project.slug, **@pub.link_params) %>">
<% end %>

<%# A REAL BREADCRUMB IN THE PAGE, NOT `content_for :crumbs`. The layout renders `layouts/topbar`
    (which is what consumes :crumbs) only on the SIGNED-IN branch, and a public page renders the
    visitor's shell by design — so a content_for here would be markup nothing ever yields. %>
<nav class="breadcrumb" aria-label="Project path">
  <%= link_to "@#{@pub.handle}", public_user_path(@pub.handle) %>
  <span class="sep" aria-hidden="true">/</span>
  <span aria-current="page"><%= @project.name %></span>
</nav>

<div class="page-head public-head">
  <div class="page-title">
    <h1><%= @project.name %></h1>
  </div>
  <p class="public-byline">
    by <%= link_to "@#{@pub.handle}", public_user_path(@pub.handle) %>
    <span class="badge status-<%= @project.status %>"><%= @project.status.humanize %></span>
    <% if @project.license_label %>
      <span class="badge license"><%= @project.license_label %></span>
    <% end %>
    <% if @project.unlisted? %>
      <span class="badge visibility-unlisted">Unlisted link</span>
    <% end %>
    <%= link_to "Feed", public_feed_path(@pub.handle, @project.slug, **@pub.link_params), class: "feed-link" %>
  </p>

  <%# STAGE 3, S3-6: THE BUNDLE, BUILT IN THE VISITOR'S BROWSER. The button hands
      `bundle_controller.js` a manifest URL and nothing else; that controller fetches each file
      through the SAME public route this page links, adds bom.csv, and zips it client-side, so no
      byte passes through Rails that a plain download would not already have moved (§15). The
      status line is where a refused fetch is reported -- on the s3 deployment the public file
      route redirects to a presigned URL and the CSP (`default-src 'self'`, no `connect-src`)
      blocks that fetch, the shared follow-up S3-2 already carries, so the button must SAY it
      failed rather than sit there having done nothing. %>
  <% bundle = @pub.bundle_files %>
  <% if bundle.any? %>
    <div class="bundle" data-controller="bundle"
         data-bundle-manifest-value="<%= public_bundle_path(@pub.handle, @project.slug, **@pub.link_params) %>"
         data-bundle-name-value="<%= @project.slug %>">
      <button type="button" class="btn small" data-action="bundle#build">
        <%# "FIRST N FILES" WHEN THE LISTING HIT ITS CAP, the same fact the manifest carries as
            `truncated`. A button that said "300 files" for a folder holding 900 would be a lie the
            visitor cannot detect until they open the zip. %>
        Download bundle (<%= "first " if @pub.listing.truncated? %><%= pluralize(bundle.size, "file") %>, <%= number_to_human_size(bundle.sum(&:size)) %>)
      </button>
      <span class="muted" data-bundle-target="status"></span>
    </div>
  <% end %>
</div>

<% if @project.description.present? %>
  <p class="project-description"><%= @project.description %></p>
<% end %>

<%# NOT `tag_chips(@project)`: that helper links into /tags/:name, which is the SIGNED-IN owner's
    private tag page. A visitor's tag link belongs on /explore. %>
<% if @project.tags.any? %>
  <div class="tag-chips">
    <% @project.tags.sort_by(&:name).each do |t| %>
      <%= link_to t.name, public_explore_path(tag: t.name), class: "tag-chip" %>
    <% end %>
  </div>
<% end %>

<% readme = @pub.readme %>
<% if readme&.html.present? %>
  <section class="panel readme-panel">
    <div class="markdown"><%= readme.html %></div>
    <% if readme.note %>
      <p class="muted readme-note"><%= readme.note %></p>
    <% end %>
  </section>
<% elsif readme&.note %>
  <p class="muted readme-note"><%= readme.note %></p>
<% end %>

<div class="project-panels">
  <%= render "files", pub: @pub %>
  <%= render "photos", pub: @pub %>
  <%= render "build_log", pub: @pub %>
  <%= render "bom", pub: @pub %>
  <%# The S3-3 wiring partial's read-only branch — its first real caller. `editable: false` is what
      renders plain cells and no composer; drop it and the public page grows text inputs and a
      Remove button posting at a private route. %>
  <% if @pub.connections.any? %>
    <%= render "projects/wiring", project: @project, connections: @pub.connections, editable: false %>
  <% end %>
  <%# Stage 3, S3-5: releases. Its own partial rather than projects/_releases with `editable:
      false` -- the download is a public file URL gated on `permits?`, not /files/:id/blob, which
      is a difference in kind rather than a branch (the partial's own header says so). %>
  <%= render "releases", pub: @pub %>
  <%= render "schematics", pub: @pub %>
  <% @pub.repo_cards.each_value do |card| %>
    <%= render "repo_card", card: card %>
  <% end %>
</div>
