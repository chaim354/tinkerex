<% content_for :title, "Sign up — Tinkerex" %>

<div class="auth-card">
  <h1>Create your account</h1>

  <% if @user&.errors&.any? %>
    <div class="flash flash-alert">
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= form_with url: signup_path, method: :post, class: "auth-form" do |f| %>
    <%= f.email_field :email, placeholder: "you@example.com", value: @user&.email, required: true, autofocus: true %>
    <%= f.password_field :password, placeholder: "Password", required: true %>
    <%= f.password_field :password_confirmation, placeholder: "Confirm password", required: true %>
    <%= f.submit "Sign up" %>
  <% end %>

  <p class="muted"><%= link_to "Already have an account? Sign in", login_path %></p>
</div>
