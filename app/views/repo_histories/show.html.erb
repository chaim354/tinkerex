<h1>History — <%= @root.name %></h1>

<p class="page-sub">
  <%= link_to "Browse files", files_path(folder: @root.node_id), class: "btn ghost small" %>
  <%= link_to "Review and commit", repo_commit_path(@root.node_id), class: "btn ghost small" %>
</p>

<%# HONEST EMPTINESS, AND IT IS THE WHOLE REASON Maker::Git::History CARRIES `stopped`. Only
    `exhausted?` establishes that there is nothing earlier; every other stop means the walk ran out
    of budget, which on a real repository is the ordinary outcome rather than an edge case. A view
    that renders "no history" for both says something it has not been told. Never write a percent
    followed by a greater-than inside one of these comments -- an ERB comment ends at the first one
    and the rest of this prose prints into the page, where no assert_select can see it (§14d). %>
<% if @result.entries.empty? %>
  <% if @result.exhausted? %>
    <p class="muted">No commits here yet.</p>
  <% else %>
    <p class="muted">Stopped after <%= pluralize(@result.walked, "commit") %> without listing anything.</p>
  <% end %>
<% else %>
  <ol class="commit-history">
    <% @result.entries.each do |entry| %>
      <%# ONE ELEMENT PER COMMIT CARRIES data-oid. It is the row's identity for the tests and for
          any later control that acts on a commit; a second element carrying it inside the row
          would silently double every count taken over it. %>
      <li data-oid="<%= entry.oid %>" class="commit-history-row">
        <code class="mono"><%= entry.short_oid %></code>
        <span class="commit-subject"><%= entry.subject %></span>
        <span class="muted">
          <%= entry.author_name %> ·
          <time datetime="<%= entry.time.iso8601 %>"><%= entry.time.strftime("%Y-%m-%d %H:%M") %></time>
        </span>
      </li>
    <% end %>
  </ol>

  <%# WHERE THE WALK STOPPED, SAID OUT LOUD. A list that simply ends looks complete; this one is
      capped by design, so the page has to say when it is showing a window rather than everything. %>
  <% unless @result.exhausted? %>
    <p class="muted">
      Showing the newest <%= pluralize(@result.entries.size, "commit") %>
      from the last <%= pluralize(@result.walked, "commit") %> walked. Older history is in git.
    </p>
  <% end %>
<% end %>
