<% content_for :title, "Sign in — Tinkerex" %>

<div class="auth-card">
  <h1>Tinkerex</h1>
  <p class="muted">Sign in to your file library</p>

  <%= form_with url: login_path, method: :post, class: "auth-form" do |f| %>
    <%= f.email_field :email, placeholder: "you@example.com", required: true, autofocus: true %>
    <%= f.password_field :password, placeholder: "Password", required: true %>
    <%= f.submit "Sign in" %>
  <% end %>

  <p class="muted">
    <%= link_to "Create an account", signup_path %> ·
    <%= link_to "Forgot password?", new_password_path %> ·
    <%= link_to "Resend confirmation", new_confirmation_path %>
  </p>
</div>
