<%#
  ONE GROUPED LIST, RENDERED BY BOTH THE TAG PAGE AND THE SEARCH PAGE (stage 2, S2-5) — the
  contract is fixed here because tags/show.html.erb and search/index.html.erb are two different
  tasks' work landing on the same partial. Its styling (`.result-group`, `.result-list`,
  `.result-row`, `.result-sub`, `.result-more`) lives in `pages/search.css`, linked from the
  shared layout, so it applies here too without this page loading a stylesheet of its own.

  Locals:
    title       String   -- the group's heading ("Projects", "Files", ...)
    kind        Symbol   -- :project | :model | :inventory_item | :file | :folder | :note | :tag
    records     Array    -- the (possibly capped) rows to render
    total       Integer  -- optional, defaults to records.size. May exceed it when capped.
    more_path   String   -- optional, defaults to nil. A link into that kind's own, already
                            tag/query-filterable index.
    more_label  String   -- optional, defaults to "See all".
    node_names  Hash     -- optional, defaults to {}. THE :note ARM ONLY: node_id => file name,
                            built by SearchController#index over the CAPPED rows, because a note
                            has no page of its own and the row is a link to the file it is on.
    folders     Hash     -- optional, defaults to {}. THE :file, :folder AND :model ARMS:
                            record id => [folder node_id, library path] for the rows rendered
                            (FilesHelper#result_folders), drawn under the name so three
                            "tetra.stl" rows can be told apart (UX audit D11, 2026-11-02). An
                            absent key draws nothing; "" is the library root, named "Library".
    number      Integer  -- optional. THE SEARCH PAGE'S SECTION NUMBER (Shop manual slice 7): the
                            group is drawn as a numbered section, its head a `.panel-head`, and
                            `id` is its anchor for the page's left column. The tag page passes
                            neither and keeps its plain heading.
    id          String   -- optional, the section's id.
    files       Integer  -- optional. THE :file ARM ON SEARCH WITH STACKS ON: how many files the
                            group's `total` figures stand for, said beside it ("5 results ·
                            8 files") when stacks fold any (SearchController#add_stacked_files).
                            A :file record may then be a SearchController::StackHit — a stack
                            and its latest node — drawn as one row naming the stack and its
                            count, linking the latest (Shop manual spec §9).
    query       String   -- optional. The search term: a name that holds it marks it (`<mark>`,
                            TextHelper#highlight), as the screen does. Names only — a note's
                            excerpt stays plain text (search_test.rb refuses markup in it).

  A FILE ROW IS A NAME LINK, DELIBERATELY NOT thumb_cell_data — this list has no polling cell to
  seed (docs/invariants/files-preview.md), just a name and an extension label. It and the :note
  arm's link carry FilesHelper#file_open_data (2026-10-21): a click opens the file, a double-click
  opens it in a new tab, as every file link on a signed-in page does.

  Renders nothing at all when records is empty, so a caller may render this unconditionally per
  group (SearchController#add_group never adds an empty one anyway; TagsController's groups can
  be, and this is what makes "per non-empty group" true without the caller filtering).
%>
<% if records.any? %>
  <% total = local_assigns.fetch(:total, records.size) %>
  <% more_path = local_assigns.fetch(:more_path, nil) %>
  <% more_label = local_assigns.fetch(:more_label, "See all") %>
  <% folders = local_assigns.fetch(:folders, {}) %>
  <% number = local_assigns[:number] %>
  <% query = local_assigns[:query].presence %>
  <% name = ->(text) { query ? highlight(text, query) : text } %>
  <%= tag.section class: class_names("result-group", "result-group--#{kind}", "panel": number), id: local_assigns[:id] do %>
    <% if number %>
      <div class="panel-head">
        <h2><span class="panel-num"><%= number %></span> <%= title %></h2>
        <% files = local_assigns[:files] %>
        <span class="panel-note"><%= total > records.size ? "#{records.size} of #{total}" : count_label(total, "result") %><%= " · #{count_label(files, "file")}" if files && files > total %></span>
      </div>
    <% else %>
      <h2><%= title %> <span class="muted"><%= total %></span></h2>
    <% end %>
    <ul class="result-list">
      <% records.each do |record| %>
        <li class="<%= class_names("result-row", "stack-result": record.respond_to?(:stack)) %>">
          <% case kind
             when :project %>
            <%= link_to name.(record.name), project_path(record) %>
            <% if record.description.present? %>
              <span class="result-sub"><%= truncate(record.description, length: 80) %></span>
            <% end %>
          <% when :model %>
            <span class="result-name">
              <%= link_to name.(record.title), model_path(record) %>
              <%= render "shared/result_folder", where: folders[record.id] %>
            </span>
            <%# A badge only for a status that says something — the model page's and the strip's rule
                (UX audit E2): every auto-found model starts at the default. %>
            <% unless record.default_print_status? %>
              <span class="badge mstatus-<%= record.print_status %>"><%= record.print_status_label %></span>
            <% end %>
          <% when :inventory_item %>
            <%= link_to name.(record.name), inventory_item_path(record) %>
            <span class="result-sub"><%= [
              "#{number_with_precision(record.quantity_cached, precision: 3, strip_insignificant_zeros: true)} #{record.unit}",
              record.location&.name
            ].compact.join(" · ") %></span>
          <% when :file %>
            <% if record.respond_to?(:stack) %>
              <%# A VERSION STACK: its name, its count chip and where it is, linking the latest
                  member, which the sub-line names (the screen `search`). %>
              <% stack = record.stack %>
              <% node = record.node %>
              <span class="result-name">
                <span class="stack-result-name"><%= link_to name.(stack.name), file_path(node.node_id), data: file_open_data %> <span class="badge stack-count"><%= stack_count_label(stack) %></span></span>
                <%= render "shared/result_folder", where: folders[record.id] %>
              </span>
              <span class="result-sub">latest <%= node.name %></span>
            <% else %>
            <span class="result-name">
              <%= link_to name.(record.name), file_path(record.node_id), data: file_open_data %>
              <%= render "shared/result_folder", where: folders[record.id] %>
            </span>
            <span class="result-sub"><%= File.extname(record.name).delete(".").upcase.first(4) %></span>
            <% end %>
          <% when :folder %>
            <%#
              A FOLDER IS A DESTINATION, NOT A FILE, so it links into the Files page's folder view
              rather than to a /files/:id page it does not have. No extension label: `.result-sub`
              says what it is instead, since a bare name in a list of files would read as a file
              with no type.
            %>
            <span class="result-name">
              <%= link_to name.(record.name), files_path(folder: record.node_id) %>
              <%= render "shared/result_folder", where: folders[record.id] %>
            </span>
            <span class="result-sub">Folder</span>
          <% when :note %>
            <%#
              THE ROW IS THE FILE THE NOTE IS ON, because that is where the note is readable -- a
              note has no page of its own. `node_names` is this group's own local, built by
              SearchController#index over the CAPPED rows; a missing key cannot happen (the scope
              filters to live nodes) but the fallback is there rather than a nil link text.

              `to_plain_text`, NOT the stored body: an Action Text body is HTML, and rendering it
              raw here would escape every tag into noise in the result row.
            %>
            <% names = local_assigns.fetch(:node_names, {}) %>
            <%= link_to names[record.node_id] || "this file", file_path(record.node_id), data: file_open_data %>
            <span class="result-sub"><%= truncate(record.body.to_plain_text, length: 80) %></span>
          <% when :tag %>
            <%= link_to record.name, tag_path(record.name), class: "tag-chip" %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if more_path && total > records.size %>
      <p class="result-more"><%= link_to "#{more_label} #{total}", more_path %></p>
    <% end %>
  <% end %>
<% end %>
