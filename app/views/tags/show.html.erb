<% content_for :title, "#{@tag.name} — Tinkerex" %>

<%# "Tags" IS A LINK (UX audit D11, 2026-11-02): the tag list lives at Settings › Tags, and a crumb
    that names a place and goes nowhere reads as broken. %>
<% content_for :crumbs do %>
  <nav class="breadcrumb" aria-label="Tag path">
    <%= link_to "Tags", settings_tags_path %>
    <span class="sep" aria-hidden="true">/</span>
    <span aria-current="page"><%= @tag.name %></span>
  </nav>
<% end %>

<%# THE SUBTITLE COUNTS BY KIND (UX audit D11): "2 projects · 1 3D model", from each group's own
    `noun` (TagsController#show). It read "3 things", which told nobody what to look for below. %>
<% counts = @groups.select { |g| g[:total].positive? }.map { |g| pluralize(g[:total], g[:noun]) } %>
<div class="page-head">
  <h1><span class="tag-chip"><%= @tag.name %></span></h1>
  <p class="page-subtitle muted"><%= counts.any? ? counts.join(" · ") : "Nothing yet" %></p>
</div>

<% if @groups.all? { |g| g[:records].empty? } %>
  <%# AN EMPTY TAG OFFERS THE NEXT STEP: a tag is added from a project's, a 3D model's or an inventory
      item's own page, and the Library is where those are found. %>
  <div class="empty">
    <p>Nothing wears this tag yet.</p>
    <p>Add it on the page of a project, a 3D model or an inventory item, or <%= link_to "browse the Library", files_path %>.</p>
  </div>
<% else %>
  <% @groups.each do |group| %>
    <%= render "shared/result_group", **group %>
  <% end %>
<% end %>
