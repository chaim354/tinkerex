<%#
  One parameter field. Locals: param (Hash{name,type,default,help,choices,multiline}), values (Hash
  prefill). Every field posts as params[<name>] regardless of which group it lives in.
%>
<% pname = param["name"] %>
<% val = (values && values[pname]) || param["default"] %>
<% prefilled = values.present? && values.key?(pname) %>
<% help_text, manual_url = box_help(param["help"]) %>
<label class="box-field <%= "box-field-multiline" if param["multiline"] %>">
  <span class="box-field-label">
    <%= pname %>
    <% if help_text.present? %><span class="muted">— <%= help_text %></span><% end %>
    <% if manual_url %><%= link_to "?", manual_url, class: "box-help", target: "_blank",
          rel: "noopener noreferrer", title: "boxes.py manual", aria: { label: "Manual for #{pname}" } %><% end %>
  </span>
  <% if param["choices"].present? %>
    <select name="params[<%= pname %>]">
      <% param["choices"].each do |c| %>
        <option value="<%= c %>" <%= "selected" if c.to_s == val.to_s %>><%= c %></option>
      <% end %>
    </select>
  <% elsif param["type"] == "bool" %>
    <input type="hidden" name="params[<%= pname %>]" value="false">
    <input type="checkbox" name="params[<%= pname %>]" value="true" <%= "checked" if val.to_s == "true" %>>
  <% elsif %w[float int].include?(param["type"]) %>
    <input type="number" step="any" name="params[<%= pname %>]" value="<%= val %>">
  <% elsif param["multiline"] %>
    <%#
      A <input type="text"> is not merely cramped for these — HTML's value sanitization algorithm
      STRIPS line breaks from it, so a multi-line value silently arrived at the sidecar as one line.
      That is what broke TrayLayout ("traylayout requires --layout, …"), FrontPanel and
      NightLightBox, and what quietly dropped the second line of a Desksign.

      Build it with `tag.textarea` and NOT a hand-written <textarea>: an HTML parser swallows one
      newline directly after the opening tag, and Rails' tag builder emits a spare one to be eaten
      (PRE_CONTENT_STRINGS), so a value that opens on a blank line — FrontPanel's layout does —
      keeps it. For the same reason do not prepend a "\n" of your own here: two newlines means one
      SURVIVES, and every layout grows a stray blank first line.

      `wrap: off` and the monospace styling keep a layout's ASCII art column-aligned, which is the
      only way it is editable — and readable back by boxes.py's parser.
    %>
    <% lines = val.to_s.lines %>
    <%= tag.textarea val.to_s, name: "params[#{pname}]",
          rows: (lines.size + 1).clamp(4, 24),
          cols: ((lines.map { |l| l.chomp.length }.max || 0) + 6).clamp(24, 72),
          wrap: "off", spellcheck: "false",
          # Tells the sync controller to keep its hands off a layout loaded from a saved box.
          data: { prefilled: prefilled.presence } %>
  <% else %>
    <input type="text" name="params[<%= pname %>]" value="<%= val %>">
  <% end %>
</label>
