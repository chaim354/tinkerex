<%#
  Grouped param form, mirroring boxes.py's own web UI. Each group from the sidecar becomes a section:
  the generator's own settings and "Default Settings" are open <fieldset>s; the advanced
  "Settings for <edge/part>" groups (Finger Joints, Lid, …) collapse into <details> so the common
  dimensions stay front and centre. Advanced fields are still in the DOM, so they're always submitted.
  Locals: generator (BoxesClient::Generator), values (Hash, optional prefill).
%>
<% generator.param_groups.each do |grp| %>
  <% if grp["advanced"] %>
    <details class="param-group param-group-adv">
      <summary><%= grp["title"] %></summary>
      <div class="box-params">
        <% grp["params"].each do |param| %><%= render "field", param: param, values: values %><% end %>
      </div>
    </details>
  <% else %>
    <fieldset class="param-group">
      <legend><%= grp["title"] %></legend>
      <div class="box-params">
        <% grp["params"].each do |param| %><%= render "field", param: param, values: values %><% end %>
      </div>
    </fieldset>
  <% end %>
<% end %>
