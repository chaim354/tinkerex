<%#
  A dynamic form built from the generator's parameter schema (name/type/default/choices/help).
  Every field posts as params[<name>]; the sidecar validates against the real schema.
  Locals: generator (BoxesClient::Generator), values (Hash, optional prefill).
%>
<div class="box-params">
  <% generator.params.each do |param| %>
    <% pname = param["name"] %>
    <% val = (values && values[pname]) || param["default"] %>
    <label class="box-field">
      <span class="box-field-label">
        <%= pname %>
        <% if param["help"].present? %><span class="muted">— <%= param["help"] %></span><% end %>
      </span>
      <% if param["choices"].present? %>
        <select name="params[<%= pname %>]">
          <% param["choices"].each do |c| %>
            <option value="<%= c %>" <%= "selected" if c.to_s == val.to_s %>><%= c %></option>
          <% end %>
        </select>
      <% elsif param["type"] == "bool" %>
        <input type="hidden" name="params[<%= pname %>]" value="false">
        <input type="checkbox" name="params[<%= pname %>]" value="true" <%= "checked" if val.to_s == "true" %>>
      <% else %>
        <input type="number" step="any" name="params[<%= pname %>]" value="<%= val %>">
      <% end %>
    </label>
  <% end %>
</div>
