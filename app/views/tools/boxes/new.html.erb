<% content_for :title, "#{@generator.key} — Box Generator" %>

<div class="page-head">
  <div>
    <h1><%= @generator.key %></h1>
    <p class="page-subtitle muted"><%= @generator.title %></p>
  </div>
  <%= link_to "Back", tools_boxes_path, class: "btn ghost" %>
</div>

<div class="box-editor" data-controller="boxpreview boxsections topview"
     data-boxpreview-url-value="<%= preview_tools_boxes_path %>">
  <%= form_with url: tools_boxes_path, method: :post,
                data: { boxpreview_target: "form", topview_target: "form",
                        controller: "traylayout" } do %>
    <input type="hidden" name="generator" value="<%= @generator.key %>">

    <%# Name, destination and both buttons ride at the top and stay there: on a generator with sixty
        params, actions parked under the form are a scroll away from every field you are editing. %>
    <div class="box-actions">
      <label class="box-field">
        <span class="box-field-label">Name</span>
        <input type="text" name="name" required>
      </label>
      <label class="box-field">
        <span class="box-field-label">Save to folder</span>
        <%= select_tag :parent_node_id, options_for_select(@folders, @default_parent_node_id) %>
      </label>
      <div class="page-actions">
        <button type="button" data-action="boxpreview#preview" class="btn ghost">Preview</button>
        <button type="submit" class="btn">Save to library</button>
      </div>
    </div>

    <%= render "form", generator: @generator, values: @values %>
  <% end %>

  <aside class="box-side">
    <div class="preview box-preview">
      <img data-boxpreview-target="image" alt="Box preview" class="preview-image">
      <p class="box-preview-status" data-boxpreview-target="status" role="status" aria-live="polite" hidden></p>
    </div>

    <%# A plan of the compartments, drawn in the browser from sx/sy or the layout art. Ships HIDDEN
        and is either revealed or removed by the controller, because whether this generator has any
        compartments at all is a question about its params, not about the page. %>
    <div class="box-topview" data-topview-target="panel" hidden>
      <h3>
        Top view
        <span class="box-topview-summary muted" data-topview-target="summary"
              role="status" aria-live="polite"></span>
      </h3>
      <div class="box-topview-canvas" data-topview-target="canvas"></div>
      <p class="box-topview-hint muted">Compartments only — joinery is on the cut sheet above.</p>
    </div>

    <% if @prior.any? %>
      <div class="box-prior" data-controller="thumbs" data-thumbs-url-value="<%= thumbnails_files_path %>">
        <h3>Made with <%= @generator.key %></h3>
        <div class="box-prior-hint muted"><%= pluralize(@prior.size, "saved box") %></div>
        <ul class="box-prior-list">
          <% @prior.each do |s| %>
            <% out = s.files.find { |f| f.role == "output" } %>
            <%= tag.li class: "box-prior-item",
                       data: (out ? { thumbs_target: "cell", node_id: out.node_id, ext: "SVG" } : {}) do %>
              <% if out %>
                <%= render "files/thumb", thumb: nil, ext_label: "SVG" %>
              <% else %>
                <span class="thumb"><span class="thumb-icon" aria-hidden="true">SVG</span></span>
              <% end %>
              <div class="box-prior-meta">
                <div class="box-prior-name"><%= s.name %></div>
                <div class="box-prior-date"><%= s.updated_at.strftime("%Y-%m-%d") %></div>
              </div>
              <%= link_to "Load", box_prefill_path(@generator.key, s.data["params"]),
                          aria: { label: "Load #{s.name}" } %>
            <% end %>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="box-prior-hint muted">No saved boxes with this generator yet.</p>
    <% end %>
  </aside>
</div>
