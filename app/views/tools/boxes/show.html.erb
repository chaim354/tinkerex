<% content_for :title, "#{@state.name} — Box Generator" %>

<div class="page-head">
  <h1><%= @state.name %></h1>
  <%= link_to "Back", tools_boxes_path, class: "btn ghost" %>
</div>

<dl class="meta">
  <dt>Generator</dt><dd><%= @state.data["generator"] %></dd>
  <dt>Saved</dt><dd><%= @state.created_at.strftime("%Y-%m-%d %H:%M") %></dd>
</dl>

<h2>Bundle</h2>
<%# The tied files: the SVG output (plus any future formats). The parameters that made it are below, from the DB. %>
<ul class="bundle-files">
  <% @state.files.each do |af| %>
    <li><%= link_to "#{af.role}", file_path(af.node_id) %> <span class="muted mono"><%= af.content_type %></span></li>
  <% end %>
</ul>

<%= render "tools/shared/params", state: @state %>

<%= link_to "Duplicate & tweak",
      box_prefill_path(@state.data["generator"], @state.data["params"]),
      class: "btn ghost" %>
