<%# The New ▾ menu's tool entries (layouts/_topbar.html.erb's lazy frame). The registry is read HERE,
    on demand, never by the layout. NO TRAILING "…" (UX audit G3): a tool entry opens the tool's page,
    as Text file, Project and Inventory item open theirs; the ellipsis is the phone's Upload…, which
    asks for files before anything happens. %>
<turbo-frame id="new-menu-tools">
  <% if @addons.any? %>
    <div class="menu-sep" role="separator"></div>
    <% @addons.each do |addon| %>
      <%= link_to addon.title, tools_addon_path(addon.key, in: @in), class: "menu-item" %>
    <% end %>
  <% end %>
</turbo-frame>
