<%#
  THE ACCOUNT PAGE IS A SETTINGS PAGE (UX audit F1). Devise's registrations#edit, rendered in the
  shell like every settings/* sibling: a title, the Settings breadcrumb, one h1, and each part a
  `.panel` with its own h2 at the settings width. The rail lights Settings for it (ShellHelper's
  SECTIONS names users/registrations). Saving lands back here with a notice
  (Users::RegistrationsController#after_update_path_for).

  THREE FORMS, THREE ERROR PLACES. Devise's update form shows the resource's errors in its own panel;
  the delete form shows @delete_error in the Delete panel and nowhere else (UX audit F2), which is
  why #destroy no longer writes its refusal onto the resource; the handle form refuses by redirect
  with a flash (Settings::HandlesController says why). "Save changes" is the page's one accent;
  Claim handle is quiet and Delete is the danger button (design-system.md rule 13).
%>
<% content_for :title, "Account — Tinkerex" %>
<%= render "settings/crumbs", current: "Account" %>

<div class="page-head">
  <h1>Account</h1>
</div>

<div class="account-page">
  <section class="panel account-login" aria-labelledby="account-login-heading">
    <h2 id="account-login-heading">Email and password</h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: "email" %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <span class="field-hint">Waiting for you to confirm <%= resource.unconfirmed_email %> with the
            link sent to it. Until you do, you sign in with this address.</span>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password, "New password" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <%# User#revoke_devices_after_password_change (pentest H1b). %>
        <span class="field-hint">Leave blank to keep your current password. At least
          <%= @minimum_password_length || Devise.password_length.min %> characters. A new password
          signs out every connected app (Settings → Devices).</span>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirm new password" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= f.label :current_password %>
        <%= f.password_field :current_password, autocomplete: "current-password" %>
        <span class="field-hint">Needed to save any change in this section.</span>
      </div>

      <div class="form-actions">
        <%= f.submit "Save changes", class: "btn primary" %>
      </div>
    <% end %>
  </section>

  <section class="panel handle-panel" aria-labelledby="account-handle-heading">
    <h2 id="account-handle-heading">Handle</h2>
    <p class="muted">Public projects live at <code>/u/&lt;handle&gt;/&lt;project&gt;</code>. Lowercase letters, digits and hyphens.</p>
    <%# scope: :user -- form_with url: with no model has a blank object_name, so the field would be
        named "handle" and the controller's require(:user) would reject it (CLAUDE.md §14d). The value
        is stated: under that scope the field would otherwise read @user, Devise's resource. %>
    <%= form_with url: settings_handle_path, method: :patch, scope: :user, class: "handle-form" do |f| %>
      <label class="field">
        <span>Handle</span>
        <%= f.text_field :handle, value: current_user.handle, placeholder: "e.g. chaim",
                         pattern: User::HANDLE_PATTERN, autocomplete: "off",
                         disabled: current_user.handle_locked? %>
      </label>
      <% if current_user.handle_locked? %>
        <p class="muted">Locked while a project is unlisted or public.</p>
      <% else %>
        <%= f.submit current_user.handle ? "Change handle" : "Claim handle", class: "btn small" %>
      <% end %>
    <% end %>
  </section>

  <%#
    Devise's default here is a bare button_to with no password field.
    Users::RegistrationsController#destroy requires user[current_password], so without this
    field deletion would be impossible through the UI. Pinned by account_settings_test's
    "the rendered delete form carries the field the controller requires", which is scoped to
    div.account-delete -- the update form above ALSO has a current_password field, so an unscoped
    assertion passes even when this one is renamed. A div with role="region" rather than a section
    for that reason: demo_guards_test.rb pins the same selector.
  %>
  <div class="panel account-delete" role="region" aria-labelledby="account-delete-heading">
    <h2 id="account-delete-heading">Delete this account</h2>
    <p>
      This removes your account and everything in it — projects, the file catalog, tasks, the
      build log, sheets, previews and paired devices. It cannot be undone.
    </p>

    <% if @delete_error %>
      <div class="form-errors" role="alert"><%= @delete_error %></div>
    <% end %>

    <%= form_with url: registration_path(resource_name), method: :delete do |f| %>
      <div class="field">
        <%= f.label :current_password, "Confirm your password to delete this account" %>
        <%# name: is explicit because this form has no model to scope from — form_with would
            otherwise emit a bare `current_password`, which #destroy does not read. Passing the
            symbol keeps the id as `current_password` so the label's `for` actually matches. %>
        <%= f.password_field :current_password, name: "user[current_password]",
                             autocomplete: "current-password", required: true %>
      </div>
      <div class="form-actions">
        <%= f.submit "Delete my account", class: "btn danger", data: {
              turbo_confirm: "Permanently delete your account and all of its data? " \
                             "This cannot be undone."
            } %>
      </div>
    <% end %>
  </div>
</div>
