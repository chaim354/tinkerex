<%# A SERVER WITH NO ACCOUNT HAS NOBODY TO SIGN IN (UX audit F5), so the sign-in page -- which is `/`
    on every self-hosted box -- shows the card that makes the first one instead of a form for nobody.
    It is the sign-up page's own first-account card (Tinkerex::Registration.first_owner?, the same
    question that page asks), posting to the same door, so the two can never tell a fresh install
    different things. %>
<% if Tinkerex::Registration.first_owner? %>
  <%= render "users/registrations/owner_card" %>
<% else %>
  <% content_for :title, "Sign in — Tinkerex" %>
  <div class="auth-card">
    <div class="brand"><span class="brand-mark" aria-hidden="true"></span><span class="brand-name">Tinkerex</span></div>
    <h1>Sign in</h1>

    <%# THE PUBLIC DEMO'S DOOR (Tinkerex::Demo): one click into the shared account, above the form a
        stranger cannot use, and only while there is an account to sign into -- a button that answered
        404 would be a broken page. A plain .btn: the card's accent stays on Sign in, the way every auth
        card spends it on its own form's submit, and this one is found by coming first. %>
    <% if Tinkerex::Demo.available? %>
      <div class="demo-entry">
        <%= button_to "Try the demo", demo_session_path, class: "btn" %>
        <p class="auth-hint">A shared account that resets every night; nothing you do here is private.</p>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <%# THE LABEL NAMES ITS CHECKBOX BY `for` AS WELL AS BY WRAPPING IT (UX audit F4): the wrap
          alone left the box's accessible name as "1", its value. f.label derives the same id
          f.check_box gives the box, user_remember_me. %>
      <% if devise_mapping.rememberable? %>
        <%= f.label :remember_me, class: "field-inline" do %>
          <%= f.check_box :remember_me %>
          <span>Remember me</span>
        <% end %>
      <% end %>

      <div class="actions">
        <%= f.submit "Sign in", class: "primary" %>
      </div>
    <% end %>

    <%= render "users/shared/links" %>
  </div>
<% end %>
