<%# ONE ERROR STYLE FOR EVERY FORM (UX audit F3): the `.form-errors` box the Settings pages use, with
    the errors as one sentence, not Devise's "N errors prohibited this user from being saved" list.
    data-turbo-cache="false" keeps a refusal out of Turbo's snapshot, so Back never shows it again. %>
<% if resource.errors.any? %>
  <div class="form-errors" role="alert" data-turbo-cache="false"><%= resource.errors.full_messages.to_sentence.chomp(".") %>.</div>
<% end %>
