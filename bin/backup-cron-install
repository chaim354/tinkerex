#!/usr/bin/env bash
# Install (or refresh) the nightly backup on the Unraid VM. Idempotent — run it again after any
# change to ops/backup-db.sh and it re-pushes the script and rewrites the crontab entry.
#
#   bin/backup-cron-install                       # 03:30 nightly, chunk+share+s3+sync, keep 14
#   BACKUP_KEEP=30 bin/backup-cron-install        # keep 30
#   BACKUP_AT="0 4" bin/backup-cron-install       # 04:00  (crontab "minute hour")
#   bin/backup-cron-install --uninstall
#
# WHERE THE ARCHIVES GO, AND WHY NOT THE VM. Backups land on the Unraid host's `backups` share
# over CIFS, using the same Docker-CIFS-volume mechanism deploy.share.yml already uses for the
# library — so no host-level `sudo mount`, no fstab, no cifs-utils. It sits on the array (5.8 TB
# free when this was measured, against ~0.6 GB for a full 14-day history). The VM's own disk would
# have been simpler and is the wrong answer: it is 31 GB with 12 GB free, and it is the SAME
# virtual disk the live databases sit on, so it protects against a bad migration or a bad deploy
# and not against losing the VM. A backup that shares a failure domain with its source is half a
# backup.
#
# NOT `appdata`, THOUGH THAT IS THE CONVENTIONAL UNRAID CHOICE AND WAS THIS SCRIPT'S DEFAULT UNTIL
# A REVIEW CAUGHT IT. It is READ-ONLY TO GUEST on this host, so the bootstrap `mkdir` below cannot
# even create the subdirectory; the `backups` share was created for this instead. docs/DEPLOY.md §6
# recorded that in the same commit that shipped `appdata` as the default here — so the rule and the
# code contradicted each other from the first day, and the default is the half nobody reads.
#
# THE CIFS VOLUME IS CREATED OUT-OF-BAND AND MUST NOT BE `docker volume rm`'d. Kamal only ensures
# a volume EXISTS; if this one were removed, the next thing to reference it would recreate it as a
# PLAIN EMPTY LOCAL volume on the VM — the nightly would keep reporting success while writing
# 34 MB a night into the very disk this arrangement exists to avoid, and the real archives on the
# array would simply stop being visible. Same warning, same reason, as the library volume's.

set -euo pipefail

HOST="${DEPLOY_HOST:-kamal1@192.168.1.95}"
NAS="${BACKUP_NAS:-//192.168.1.146/backups}"
SUBDIR="${BACKUP_SUBDIR:-tinkerex-backups}"
VOLUME="${BACKUP_VOLUME:-tinkerex_backups}"
KEEP="${BACKUP_KEEP:-14}"
AT="${BACKUP_AT:-30 3}"
# `sync` IS THE SYNC SERVER'S DATABASE (the `sync` accessory, config/deploy.yml) AND BELONGS IN
# THE DEFAULT, not left to an operator to remember. It is a SECOND database on this box, holding
# the chunk catalog the `remote` deployment resolves every file through; a nightly that backs up
# the maker databases and not this one produces a restore that brings the app back pointing at
# nothing. Adding it here rather than documenting it is the §14i rule that these scripts have no
# gate behind them — the failure mode is that you find out when you need a restore.
DESTS="${BACKUP_DESTS:-chunk share s3 sync}"
OPS_DIR="tinkerex-ops"
MARKER="# tinkerex-nightly-backup"
TZ_EXPECT="${BACKUP_TZ:-America/New_York}"
TZ_DECLARED=false; [ -n "${BACKUP_TZ:-}" ] && TZ_DECLARED=true
# BACKUP_AT is crontab's "minute hour", so render it back as a clock time for the messages below
# rather than hard-coding 03:30 — which stops being true the moment anyone sets BACKUP_AT.
AT_CLOCK=$(printf '%02d:%02d' "${AT##* }" "${AT%% *}" 2>/dev/null || echo "'$AT'")

if [ "${1:-}" = --uninstall ]; then
  echo "==> removing the crontab entry (archives and the volume are left alone)"
  ssh "$HOST" "crontab -l 2>/dev/null | grep -v '$MARKER' | crontab - || true; crontab -l"
  exit 0
fi

# ---- the schedule is a LOCAL time, so the box's clock is part of the contract -------------------
# `30 3` means 03:30 in whatever zone the cron daemon is running in, and docs/DEPLOY.md §6 states
# that as 03:30 America/New_York. Nothing made that true: a stock Ubuntu server VM is Etc/UTC, in
# which case the same crontab line fires at 23:30 or 22:30 Eastern depending on the season, and
# the only symptom is archives with unexpected timestamps that nobody reads closely.
#
# ASSERTED RATHER THAN PINNED, deliberately. Emitting `CRON_TZ=America/New_York` above the entry
# looks like the stronger move, but a cron that does not implement CRON_TZ — busybox, and it is
# not required by POSIX — parses that line as an ordinary environment assignment and ignores it.
# That is a guard that silently does nothing, which is this repo's dominant failure shape (§15).
# Reading the zone back and refusing to install on a mismatch cannot fail that way: it either
# confirms the documented claim or stops.
#
# This check runs FIRST, before the volume bootstrap and the crontab write, so a refusal leaves
# the box exactly as it found it.
echo "==> checking the box's clock"
BOX_TZ=$(ssh "$HOST" bash -s <<'REMOTE'
set -uo pipefail
tz=""
# if-blocks, not `[ x ] && y`: a bare test-and-assign returns the TEST's status, which under
# `set -e` exits the script the moment a probe does not apply. Same trap as bin/backup-status:62.
if command -v timedatectl >/dev/null 2>&1; then
  tz=$(timedatectl show -p Timezone --value 2>/dev/null || true)
fi
if [ -z "$tz" ] && [ -r /etc/timezone ]; then
  tz=$(cat /etc/timezone)
fi
if [ -z "$tz" ] && [ -L /etc/localtime ]; then
  tz=$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')
fi
echo "${tz:-UNKNOWN}"
REMOTE
)
if [ "$BOX_TZ" = UNKNOWN ]; then
  if ! $TZ_DECLARED; then
    echo "!! cannot read the timezone on $HOST, so the schedule cannot be verified." >&2
    echo "   $AT_CLOCK is a LOCAL time and docs/DEPLOY.md §6 claims $TZ_EXPECT; unverified, that is" >&2
    echo "   a doc claim rather than a fact. Re-run with BACKUP_TZ=<zone> to state it deliberately." >&2
    exit 1
  fi
  echo "    timezone unreadable — proceeding on your BACKUP_TZ=$TZ_EXPECT"
elif [ "$BOX_TZ" != "$TZ_EXPECT" ]; then
  echo "!! $HOST is on $BOX_TZ, but this schedule is written for $TZ_EXPECT." >&2
  echo "   '$AT * * *' is a LOCAL time, so the nightly would fire at $AT_CLOCK $BOX_TZ while" >&2
  echo "   docs/DEPLOY.md §6 goes on claiming $TZ_EXPECT. Nothing would look broken." >&2
  echo >&2
  echo "   Either point the box's clock at the documented zone:" >&2
  echo "     ssh $HOST 'sudo timedatectl set-timezone $TZ_EXPECT'" >&2
  echo "   or accept the box's zone and say so, which is then what gets asserted from now on:" >&2
  echo "     BACKUP_TZ=$BOX_TZ bin/backup-cron-install" >&2
  echo "   (update docs/DEPLOY.md §6 to match if you take the second route.)" >&2
  exit 1
else
  echo "    $HOST is on $BOX_TZ — the nightly fires at $AT_CLOCK there, as documented"
fi

echo "==> ensuring $NAS/$SUBDIR exists"
# ssh FLATTENS its arguments into a single command string the remote shell then re-splits, so an
# unquoted share name containing a space — `//host/3D Printing`, which this very box has — would
# arrive as two arguments and mount something else, or nothing. printf %q is the quoting.
printf -v Q_NAS '%q' "$NAS"; printf -v Q_SUBDIR '%q' "$SUBDIR"; printf -v Q_VOLUME '%q' "$VOLUME"
# Mounting the whole share ONCE, only to mkdir the subdirectory, then mounting the subdirectory
# itself for real: cifs can mount a path below a share, but the path has to exist first, and the
# narrower mount is what keeps a backup job from having the rest of the share in reach.
ssh "$HOST" bash -s -- "$Q_NAS" "$Q_SUBDIR" "$Q_VOLUME" <<'REMOTE'
set -euo pipefail
nas=$1; subdir=$2; volume=$3
image=$(docker inspect --format '{{.Config.Image}}' "$(docker ps -a -qf name='^tinkerex-web-share-' | head -1)")
opts="guest,uid=1000,gid=1000,vers=3.0,file_mode=0664,dir_mode=0775"

tmp="tinkerex-bootstrap-$$"
docker volume create --driver local --opt type=cifs --opt device="$nas" --opt o="$opts" "$tmp" >/dev/null
trap 'docker volume rm "$tmp" >/dev/null 2>&1 || true' EXIT
docker run --rm -v "$tmp:/m" --user 0 "$image" mkdir -p "/m/$subdir"

if docker volume inspect "$volume" >/dev/null 2>&1; then
  current=$(docker volume inspect --format '{{.Options.device}}' "$volume")
  if [ "$current" != "$nas/$subdir" ]; then
    # THE ADVICE HERE USED TO BE `docker volume rm`, WHICH IS THE ONE MOVE THIS FILE'S OWN HEADER
    # AND docs/DEPLOY.md §6 BOTH FORBID. It is also most likely to be aimed at the RIGHT volume:
    # the commonest way to reach this branch is a run whose BACKUP_NAS/BACKUP_SUBDIR are wrong,
    # in which case the volume is correct and deleting it is what loses the archives.
    cat >&2 <<EOF
!! refusing to repoint volume $volume. It points at
!!     $current
!! but this run composed
!!     $nas/$subdir
!!
!! DO NOT 'docker volume rm $volume'. Per docs/DEPLOY.md §6, Kamal only ensures a volume
!! EXISTS, so the next reference recreates the name as a plain EMPTY LOCAL volume on the VM.
!! The nightly then goes on reporting success while writing into the very disk this whole
!! arrangement exists to avoid, and the real archives on the array simply stop being visible.
!! Every other step here can be undone by re-running this installer. That one cannot.
!!
!! Find out which volume you are actually looking at, on the box:
!!   docker volume inspect $volume
!!   docker run --rm --user 0 -v $volume:/m $image ls -la /m
!!
!! Then, whichever it turns out to be:
!!   * it is the real backups volume and THIS RUN is what is wrong (the usual case) — re-run with
!!     BACKUP_NAS and BACKUP_SUBDIR set so they compose to the path it already points at. The
!!     volume itself is then never touched.
!!   * you are deliberately moving to a different share — re-run with BACKUP_VOLUME=<new-name> to
!!     build the new one alongside the old, then copy the archives across and retire the old
!!     volume only once a nightly has been seen writing into the new one.
EOF
    exit 1
  fi
  echo "    volume $volume already present"
else
  docker volume create --driver local --opt type=cifs \
    --opt device="$nas/$subdir" --opt o="$opts" "$volume" >/dev/null
  echo "    created volume $volume -> $nas/$subdir"
fi
docker run --rm -v "$volume:/m" --user 0 "$image" sh -c 'touch /m/.writable && rm /m/.writable' \
  || { echo "!! $volume is not writable" >&2; exit 1; }
echo "    write probe ok"
REMOTE

echo "==> installing ops/backup-db.sh"
ssh "$HOST" "mkdir -p $OPS_DIR"
scp -q "$(dirname "$0")/../ops/backup-db.sh" "$HOST:$OPS_DIR/backup-db.sh"
ssh "$HOST" "chmod +x $OPS_DIR/backup-db.sh"

# ---- Uptime Kuma push URLs -------------------------------------------------------------------
# Supply as environment variables, once:
#   PING_CHUNK=http://192.168.1.146:3001/api/push/aB1 PING_SHARE=... PING_S3=... PING_SYNC=... bin/backup-cron-install
#
# VALUES NOT SUPPLIED ARE PRESERVED, not cleared. This installer is the thing you re-run to push a
# script change, so a merge that dropped unmentioned keys would quietly unwire every monitor the
# next time anyone fixed a typo — and the monitors would then sit green, because a push monitor
# that is never pinged is indistinguishable from one that was never configured until its heartbeat
# window lapses. Tokens live only on the box, chmod 600, never in git.
echo "==> Uptime Kuma push URLs"
# THIS WRITING HALF IS DERIVED FROM $DESTS, NOT ENUMERATED — BUT THE READING HALF IS NOT, AND
# CLAIMING OTHERWISE IS WHAT LET THE LAST BUG SIT. This comment used to say ping_kuma's generic
# `PING_$(upper dest)` made ops/backup-db.sh generalize to a new destination for free. It does not:
# that script reads ping.env through an ENUMERATED whitelist (ops/backup-db.sh's `case "$_k"`),
# deliberately, so no value in that file is ever executable shell — and a destination with no arm
# there simply never has its variable set, so `[ -n "$url" ] || return 0` skips it silently and for
# ever. `sync` shipped like that: written into ping.env by the loop below, warned about by nothing,
# and unreadable by the nightly, so its monitor could not be pinged in EITHER direction.
# A NEW DESTINATION THEREFORE MOVES THREE THINGS BY HAND, and nothing in bin/ci can go red for any
# of them (§14i): the `case` arm in ops/backup-db.sh, the `chunk|share|s3|sync` argument case above
# it, and docs/DEPLOY.md §6's list of push monitors an operator must create in Uptime Kuma.
UPDATES=""
for d in $DESTS; do
  k="PING_$(printf '%s' "$d" | tr '[:lower:]' '[:upper:]')"
  v="${!k:-}"
  [ -n "$v" ] && UPDATES="${UPDATES}${k}=${v}"$'\n'
done
printf '%s' "$UPDATES" | ssh "$HOST" "cat > $OPS_DIR/ping.updates"
ssh "$HOST" bash -s -- "$DESTS" <<'REMOTE'
set -euo pipefail
# `$*`, NOT `$1`. The argument crosses ssh as part of a COMMAND STRING, so the REMOTE shell word-
# splits it before bash ever sees it: `ssh host bash -s -- "chunk share s3 sync"` arrives as four
# separate arguments, and `$1` is the single word `chunk`. That is not a hypothetical — it is what
# this line said when first written, and the unmonitored-destination check below silently found
# nothing missing because `chunk` happens to be the one destination that HAS a heartbeat. A guard
# reporting all-clear while looking at a quarter of its input is worse than no guard; caught by
# re-running the installer and noticing the warning did not appear, not by reading it.
dests="$*"
cd "$HOME/tinkerex-ops"
touch ping.env
while IFS='=' read -r k v; do
  [ -n "${k:-}" ] || continue
  { grep -v "^$k=" ping.env || true; echo "$k=$v"; } > ping.env.tmp
  mv ping.env.tmp ping.env
done < ping.updates
rm -f ping.updates
chmod 600 ping.env
if [ -s ping.env ]; then
  sed -E 's#(/api/push/).*#\1********#' ping.env | sed 's/^/    /'
else
  echo "    none configured — the nightly will run but nothing will notice if it stops."
fi
# AN UNMONITORED DESTINATION IS NAMED HERE, BECAUSE NOTHING ELSE WILL EVER MENTION IT.
# ops/backup-db.sh's ping_kuma does `[ -n "$url" ] || return 0` — a destination with no push URL is
# skipped SILENTLY and correctly (an operator may deliberately not monitor one), so the only moment
# this gap can be surfaced without crying wolf on every nightly run is install time, right here.
# Left unsaid, a destination backs itself up nightly and reports its failures to nobody, which is
# indistinguishable from being monitored right up until the day you need it. `sync` was in exactly
# that state between the accessory landing and this line being written.
missing=""
for d in $dests; do
  k="PING_$(printf '%s' "$d" | tr '[:lower:]' '[:upper:]')"
  grep -q "^$k=" ping.env 2>/dev/null || missing="${missing:+$missing }$d"
done
if [ -n "$missing" ]; then
  echo "    !! NO HEARTBEAT for: $missing"
  echo "       These back up nightly and report failures to nothing. Create a push monitor in"
  echo "       Uptime Kuma for each, then re-run with e.g. PING_$(printf '%s' "${missing%% *}" | tr '[:lower:]' '[:upper:]')=<push-url> bin/backup-cron-install"
fi
REMOTE

echo "==> installing the crontab entry"
LINE="$AT * * * \$HOME/$OPS_DIR/backup-db.sh --to-volume $VOLUME --keep $KEEP $DESTS >> \$HOME/$OPS_DIR/backup.log 2>&1 $MARKER"
# Replace rather than append: a second run must not leave two entries racing each other over one
# set of volumes. grep -v then re-add is the whole update.
ssh "$HOST" "{ crontab -l 2>/dev/null | grep -v '$MARKER' || true; echo '$LINE'; } | crontab -"
ssh "$HOST" "crontab -l | sed 's/^/    /'"

echo
echo "==> proving it works: running the job once, now"
ssh "$HOST" "\$HOME/$OPS_DIR/backup-db.sh --to-volume $VOLUME --keep $KEEP $DESTS"

echo
echo "Check on it any time with:  bin/backup-status"
