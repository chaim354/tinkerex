#!/usr/bin/env bash
# Pull an ad-hoc backup of one deployment down to this Mac, right now.
#
#   bin/backup-db                 # share (the backend in daily use)
#   bin/backup-db chunk
#   BACKUP_DIR=/Volumes/x bin/backup-db s3
#
# For the unattended nightly that keeps copies ON the Unraid array, see bin/backup-cron-install.
#
# THIS SCRIPT DOES NOT KNOW HOW TO TAKE A BACKUP. ops/backup-db.sh does, and this pushes the
# current copy of it to the box on every run before calling it — so the ad-hoc backup and the
# nightly cannot drift into two implementations with two sets of bugs. Everything interesting
# (the WAL-safe snapshot, the --anchored excludes, why the Active Storage blobs are in the
# archive) is documented there, once.
#
# IT PUSHES TO A PER-RUN TEMP PATH, AND NEVER OVER ~/tinkerex-ops/backup-db.sh. That distinction
# is the whole of this comment: it used to scp straight onto the installed copy, which meant every
# ad-hoc run — including the pre-restore one inside bin/restore-db, fired in the middle of an
# incident — silently replaced the implementation cron would execute that night with whatever
# happened to be in that person's checkout. Two unsynchronised writers to one remote file is not
# "one implementation, two callers"; it is a way for an unrelated command to change the nightly.
# `bin/backup-cron-install` is the ONLY thing that writes the installed copy, and re-running it is
# how a change to ops/backup-db.sh reaches the nightly.

set -euo pipefail

DEST="${1:-share}"
HOST="${DEPLOY_HOST:-kamal1@192.168.1.95}"
OUTDIR="${BACKUP_DIR:-$HOME/tinkerex-backups}"
case "$DEST" in
  chunk|share|s3|sync) ;;
  *) echo "usage: bin/backup-db [chunk|share|s3|sync]" >&2; exit 64 ;;
esac

# Armed only AFTER the argument check, so a usage error does not open an ssh connection to delete
# a file that was never created.
REMOTE_IMPL="/tmp/tinkerex-backup-db-$$.sh"
# ONE trap for both temporaries. A second `trap ... EXIT` REPLACES the first rather than adding to
# it, so the local work directory and the remote script have to be cleaned by the same handler.
# if-block and an explicit `|| true`, not `[ -n "$WORK" ] && rm -rf "$WORK"` followed by a bare ssh:
# this runs under `set -e` on the way out of a run that may already be failing, and a handler that
# aborts partway leaves the remote copy behind and can rewrite the exit status on its way past.
WORK=""
cleanup() {
  if [ -n "$WORK" ]; then rm -rf "$WORK"; fi
  ssh "$HOST" "rm -f $REMOTE_IMPL" >/dev/null 2>&1 || true
  return 0
}
trap cleanup EXIT

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
ARCHIVE="$OUTDIR/tinkerex-$DEST-$STAMP.tar.gz"
mkdir -p "$OUTDIR"

echo "==> $DEST on $HOST"
scp -q "$(dirname "$0")/../ops/backup-db.sh" "$HOST:$REMOTE_IMPL"

# Only the tarball may reach stdout here — the archive IS this command's stdout. The remote
# script keeps its progress on stderr for exactly this reason.
ssh "$HOST" "bash $REMOTE_IMPL --to-stdout $DEST" > "$ARCHIVE"

# ---- verify what actually LANDED, not what we believe was sent -------------------------------
echo "--> verifying $ARCHIVE"
WORK="$(mktemp -d)"
tar -xzf "$ARCHIVE" -C "$WORK" ./db-snapshot/production.sqlite3
PRIMARY="$WORK/db-snapshot/production.sqlite3"

echo "    integrity_check          $(sqlite3 "$PRIMARY" 'PRAGMA integrity_check;' | head -1)"

# THE INVENTORY IS PER-DESTINATION BECAUSE `sync` IS A DIFFERENT APPLICATION'S DATABASE, and the
# maker query does not merely return uninteresting numbers against it — it ABORTS. Found by
# rehearsing rather than reading: `bin/backup-db sync` took a perfectly good archive, verified its
# integrity_check as ok, and then died on `Parse error near line 3: no such table:
# active_storage_blobs` — sqlite3 stops at the first unknown table, so `users` and `nodes` never
# printed either and a successful backup reported as a failure. The sync server (chaim354/
# tinkerex-sync) has no maker layer and no Active Storage; what it holds is the chunk catalog.
#
# TABLE NAMES, NOT MODEL NAMES. The engine's models are namespaced (`Sync::Version`) while its
# TABLES are bare — `versions`, `chunks`, `manifest_chunks`, `changelog_entries` — which is CLAUDE
# .md §14j's `isolate_namespace` rule (`Sync::Version.table_name` must read `"versions"`, not
# `"sync_versions"`). Querying sqlite means the bare names are the correct spelling here; a reader
# porting this to `bin/rails runner` would need the namespaced ones instead.
if [ "$DEST" = sync ]; then
  sqlite3 "$PRIMARY" <<'SQL' | sed 's/^/    /'
.mode list
.separator '  '
SELECT 'users', count(*) FROM users
UNION ALL SELECT 'devices', count(*) FROM devices
UNION ALL SELECT 'nodes', count(*) FROM nodes
UNION ALL SELECT 'versions', count(*) FROM versions
UNION ALL SELECT 'chunks', count(*) FROM chunks
UNION ALL SELECT 'manifest_chunks', count(*) FROM manifest_chunks
UNION ALL SELECT 'changelog_entries', count(*) FROM changelog_entries;
SQL
  # For the maker app the loose files are preview blobs. Here they are THE CHUNK BYTES THEMSELVES
  # (STORAGE_BACKEND=local puts the content-addressed store on this same volume), so this line is
  # not a footnote on the sync leg — it is the count of the actual file content the catalog above
  # resolves to, and a catalog restored without them resolves every file to nothing.
  echo "    chunk bytes (files)      $(tar -tzf "$ARCHIVE" | awk '!/\/$/ && !/^\.\/db-snapshot\//' | wc -l | tr -d ' ')"
else
  sqlite3 "$PRIMARY" <<'SQL' | sed 's/^/    /'
.mode list
.separator '  '
SELECT 'users', count(*) FROM users
UNION ALL SELECT 'nodes', count(*) FROM nodes
UNION ALL SELECT 'maker_projects', count(*) FROM maker_projects
UNION ALL SELECT 'maker_models', count(*) FROM maker_models
UNION ALL SELECT 'maker_previews', count(*) FROM maker_previews
UNION ALL SELECT 'blobs (rows)', count(*) FROM active_storage_blobs;
SQL
  echo "    blobs (files)            $(tar -tzf "$ARCHIVE" | awk '!/\/$/ && !/^\.\/db-snapshot\//' | wc -l | tr -d ' ')"
fi
echo "    size                     $(du -h "$ARCHIVE" | cut -f1)"

echo
echo "==> $ARCHIVE"
echo
echo "Restore:  bin/restore-db $DEST $ARCHIVE --into rehearsal   # throwaway volume, live untouched"
echo "          bin/restore-db $DEST $ARCHIVE                    # the real thing"
