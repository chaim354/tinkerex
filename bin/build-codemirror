#!/usr/bin/env bash
# Rebuild vendor/javascript/codemirror.js from vendor/javascript/codemirror-entry.js.
#
# ONE BUNDLE, NEVER PER-PACKAGE IMPORTMAP PINS. Two reasons, and the second is the one that bites:
#
#   1. `bin/importmap pin @codemirror/view` resolves through jspm, which splits packages into
#      internal `../_/<hash>.js` chunks that `pin` does not vendor and Propshaft's flat /assets
#      serving could not satisfy anyway. config/importmap.rb documents that failure twice already
#      (JSZip, Three.js).
#   2. TWO COPIES OF @codemirror/state BREAK CODEMIRROR SILENTLY. Facets and StateFields have
#      OBJECT identity, so an extension built against copy A is simply ignored by a view built on
#      copy B — no error, no console warning, the editor just renders without the feature. That is
#      this repo's dominant failure shape (a green everything over something that never worked),
#      which is why test/ci_hygiene_test.rb forbids the pins rather than a comment asking nicely.
#
# This differs from every other file in vendor/javascript/, which are unmodified upstream bytes
# fetched from a CDN. That is what this script buys back: the artifact is reproducible from pinned
# versions by anyone, rather than being bytes of unknown provenance.
#
# THE PIN LIST BELOW IS THE WHOLE TREE, NOT JUST THE DIRECT DEPENDENCIES, AND THAT IS WHAT MAKES
# "reproducible" TRUE RATHER THAN ASPIRATIONAL. The plan's original list named only the 15 direct
# packages; measured, that leaves 25 transitive ones resolving through `^6.0.0`-style ranges to
# whatever is newest AT INSTALL TIME — @codemirror/state, @codemirror/view, every @lezer parser.
# So the day any of those publishes a patch, this script emits different bytes from the same
# source, and the commit message still says "reproduces the artifact from pinned versions".
#
# NOTE WHAT DOES *NOT* DETECT THAT: rebuilding twice in one sitting and comparing digests. The
# registry does not move in the two minutes between runs, so an unpinned tree passes that check
# perfectly. Only enumerating the resolved versions shows it, which is how this list was built —
# not by hand, and not from memory. To re-derive it after bumping a direct dependency:
#
#     npm install --no-audit --no-fund   # in a scratch dir holding only the direct pins
#     node -e 'const l=require("./package-lock.json"); for (const [p,v] of
#       Object.entries(l.packages)) if (p.startsWith("node_modules/"))
#       console.log(`    "${p.slice(13)}": "${v.version}",`)'
#
# and drop the @esbuild/* platform binaries, which esbuild already pins to its own version and
# which never enter the artifact. Every package in the resolved tree is MIT (§9), verified against
# each package.json at the versions pinned here.
set -euo pipefail

cd "$(dirname "$0")/.."
ROOT="$PWD"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# The 15 DIRECT packages first, then the 25 TRANSITIVE ones the first block pulls in. Blank line
# rather than a comment because JSON has none; the split is worth keeping visible, since bumping a
# direct pin is a decision and the block below it is then re-derived rather than edited.
cat > "$WORK/package.json" <<'JSON'
{
  "name": "tinkerex-codemirror-bundle",
  "private": true,
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/legacy-modes": "6.5.3",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",

    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/common": "1.5.2",
    "@lezer/cpp": "1.1.6",
    "@lezer/css": "1.3.6",
    "@lezer/go": "1.0.1",
    "@lezer/highlight": "1.2.3",
    "@lezer/html": "1.3.13",
    "@lezer/javascript": "1.5.4",
    "@lezer/json": "1.0.3",
    "@lezer/lr": "1.4.10",
    "@lezer/markdown": "1.7.2",
    "@lezer/python": "1.1.19",
    "@lezer/rust": "1.0.2",
    "@lezer/xml": "1.0.6",
    "@lezer/yaml": "1.0.4",
    "@marijn/find-cluster-break": "1.0.4",
    "crelt": "1.0.7",
    "style-mod": "4.1.3",
    "w3c-keyname": "2.2.8"
  }
}
JSON

cp "$ROOT/vendor/javascript/codemirror-entry.js" "$WORK/entry.js"

echo "installing pinned CodeMirror packages…"
(cd "$WORK" && npm install --silent --no-audit --no-fund)

# ONE COPY OF EACH IDENTITY-SENSITIVE PACKAGE — checked here because this is the ONLY place that
# can see it. test/ci_hygiene_test.rb forbids a second copy arriving by IMPORTMAP PIN; a second
# copy can also arrive by NESTED INSTALL, when some package's range stops overlapping a pin above
# and npm resolves it a private copy under its own node_modules/. esbuild then bundles both into
# the one file and the failure is the identical silent one — a facet that never matches, no error
# anywhere. @codemirror/state is the headline case; @lezer/common and @lezer/lr have the same
# object-identity property for NodeType/NodeProp, so the whole of both families is checked rather
# than one name that would have to be kept current.
# Every directory one level under a `@codemirror`/`@lezer` scope dir, ANYWHERE in the tree,
# reduced to its `scope/package` name. A nested install shows up as the same name twice, which is
# what `uniq -d` reports. `${d##*/node_modules/}` strips through the LAST /node_modules/, so a
# private copy at a/node_modules/@codemirror/state reduces to the same key as the top-level one.
DUPES=$(find "$WORK/node_modules" -type d \( -name '@codemirror' -o -name '@lezer' \) \
        -exec sh -c 'for d in "$1"/*/; do d=${d%/}; printf "%s\\n" "${d##*/node_modules/}"; done' \
        _ {} \; | sort | uniq -d)
if [ -n "$DUPES" ]; then
  echo "REFUSING TO BUILD: these packages resolved to MORE THAN ONE copy:" >&2
  echo "$DUPES" >&2
  echo "Two copies of @codemirror/state (or @lezer/common) make CM6 ignore extensions SILENTLY." >&2
  echo "Reconcile the pins in this script." >&2
  exit 1
fi

echo "bundling…"
(cd "$WORK" && npx esbuild entry.js \
  --bundle --format=esm --minify --target=es2020 \
  --legal-comments=none \
  --outfile=codemirror.js)

cp "$WORK/codemirror.js" "$ROOT/vendor/javascript/codemirror.js"

SIZE=$(wc -c < "$ROOT/vendor/javascript/codemirror.js")
GZIP=$(gzip -9 -c "$ROOT/vendor/javascript/codemirror.js" | wc -c)
printf 'wrote vendor/javascript/codemirror.js — %d bytes (%d gzipped)\n' "$SIZE" "$GZIP"
