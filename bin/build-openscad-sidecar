#!/usr/bin/env bash
# Build + push the OpenSCAD Python sidecar image (sidecar/openscad) to ghcr. This is a SEPARATE,
# GPL-2.0 image from the Rails app — the app never links it (see sidecar/openscad/README.md, and
# CLAUDE.md §9).
#
# The ghcr token comes from 1Password via bin/secret — no export needed. Export
# KAMAL_REGISTRY_PASSWORD first if you want to override it. Unlike kamal (whose backticks discard
# exit status, hence bin/secrets-preflight), `set -e` aborts here if the read fails.
# Then boot/update the accessory on the box:  bin/kamal accessory reboot openscad
set -euo pipefail

KAMAL_REGISTRY_PASSWORD="$(bin/secret KAMAL_REGISTRY_PASSWORD 'op://tinkerex/ghcr.io/password')"
CONTEXT="sidecar/openscad"
REPO="ghcr.io/chaim354/openscad-sidecar"
IMAGE="$REPO:latest"

# PROVENANCE — the source commit is baked in as an OCI label, so a RUNNING accessory can name the
# build it came from, offline, with no registry access and no tag enumeration:
#
#   docker inspect tinkerex-openscad \
#     --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
#
# A SHA TAG ALONE CANNOT ANSWER THAT, which is why the extra -t below is registry inventory and not
# the fix. Tags say which builds EXIST in the registry, never which one is on the box: the OCI
# distribution API has no digest->tag reverse lookup, and `kamal accessory details` shells out to
# `docker ps` (kamal 2.12.0, lib/kamal/commands/accessory.rb), which prints the RUN REFERENCE —
# `:latest` — not a digest. The label rides inside the image, so it also survives tag GC or a moved
# `:latest`. Keep the label; the tag is optional beside it, never instead of it.
#
# DO NOT SPELL THE VALUE `git describe --dirty`. `--dirty` consults TRACKED files only — probed: an
# untracked `?? NEW_SOURCE.py` still reports a clean SHA — while this image's Dockerfile does
# `COPY *.py ./` FROM THE WORKING TREE. So `--dirty` would name a clean commit over an image built
# from uncommitted source: a label that READS as provenance and is not, which is the exact defect
# this label exists to close. `git status --porcelain` DOES list untracked files, so it decides.
REVISION="$(git rev-parse HEAD)"
if [ -n "$(git status --porcelain -- "$CONTEXT")" ]; then
  REVISION="$REVISION-dirty"
fi

echo "$KAMAL_REGISTRY_PASSWORD" | docker login ghcr.io -u chaim354 --password-stdin
# The box is amd64; build for it (buildx emulates on an arm64 Mac, like the app image). The build
# runs the six capability assertions (openscad runs / --backend parsed / manifold actually used /
# 3MF wrote real bytes / --export-format=param / -p-P injection reaches the geometry), so a push
# implies they passed — Manifold and 3MF are compile-time optional and fail INVISIBLY at runtime.
# That promise is only auditable AFTER the fact because of the revision label above: `bin/ci` never
# runs assert-capabilities.sh (its one executor is this Dockerfile's own RUN), so the assertions are
# this image's ONLY gate and "which build ran them" has to be answerable from the container itself.
docker buildx build --platform linux/amd64 \
  --label "org.opencontainers.image.revision=$REVISION" \
  -t "$IMAGE" -t "$REPO:$REVISION" --push "$CONTEXT"
echo "pushed $IMAGE (revision $REVISION)"
