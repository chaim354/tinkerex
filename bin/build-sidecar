#!/usr/bin/env bash
# Build + push ANY sidecar image (sidecar/<name>) to ghcr. Each is a SEPARATE GPL image from the Rails
# app — the app never links it (see sidecar/<name>/README.md, and CLAUDE.md §9). Replaces the
# per-sidecar copies this repo used to carry, which differed only in three names and their comments.
#
#   bin/build-sidecar <name>              build + push sidecar/<name> as ghcr.io/chaim354/<name>-sidecar
#   bin/build-sidecar --revision <name>   print the revision it WOULD stamp, and nothing else
#
# Deploying it is bin/publish-sidecar <name> (which calls this). By hand it is
# `bin/kamal accessory boot <name>` the first time and `bin/kamal accessory reboot <name>` after.
#
# The ghcr token comes from 1Password via bin/secret — no export needed. Export
# KAMAL_REGISTRY_PASSWORD first if you want to override it. Unlike kamal (whose backticks discard
# exit status, hence bin/secrets-preflight), `set -e` aborts here if the read fails. --revision
# exits before the read, so it touches no secret at all.
#
# PROVENANCE — the source commit is baked in, so a RUNNING accessory can name the build it came
# from, offline, with no registry access and no tag enumeration. Once as an OCI label, read on the
# host:
#
#   docker inspect tinkerex-<name> \
#     --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
#
# and once as /revision inside the image, which every sidecar Dockerfile writes from the
# SIDECAR_REVISION build arg, so it reads through `kamal accessory exec` with no host IP at all —
# that is the one bin/publish-sidecar checks after every boot or reboot. Both carry the SAME value.
#
# EVERY SIDECAR NEEDS IT, NOT ONLY OPENSCAD, and the reason it looks otherwise is worth stating:
# openscad's Dockerfile RUNs assert-capabilities.sh, so people reach for the label there first. But
# `bin/ci` builds no image at all, so NO sidecar has a gate in this repo — whatever confidence there
# is in a running accessory comes from the build that produced it, and until this label there was
# nothing on the box that could name that build. Skipping it for a sidecar because "this one asserts
# nothing" (boxes, today) reintroduces exactly the finding.
#
# A SHA TAG ALONE CANNOT ANSWER IT, which is why the extra -t below is registry inventory and not
# the fix. Tags say which builds EXIST in the registry, never which one is on the box: the OCI
# distribution API has no digest->tag reverse lookup, and `kamal accessory details` shells out to
# `docker ps` (kamal 2.12.0, lib/kamal/commands/accessory.rb), which prints the RUN REFERENCE —
# `:latest` — not a digest. The label rides inside the image, so it also survives tag GC or a moved
# `:latest`. Keep the label; the tag is optional beside it, never instead of it.
#
# DO NOT SPELL THE VALUE `git describe --dirty`. `--dirty` consults TRACKED files only — probed: an
# untracked `?? NEW_SOURCE.py` still reports a clean SHA — while every sidecar's Dockerfile COPYs
# its source FROM THE WORKING TREE (boxes `COPY app.py ./`, openscad `COPY *.py ./`). So `--dirty`
# would name a clean commit over an image built from uncommitted source: a label that READS as
# provenance and is not, which is the exact defect this label exists to close. `git status
# --porcelain` DOES list untracked files, so it decides.
set -euo pipefail
cd "$(dirname "$0")/.."

usage() { echo "usage: bin/build-sidecar <name> | bin/build-sidecar --revision <name>" >&2; exit 2; }
mode=build
if [ "${1:-}" = "--revision" ]; then mode=revision; shift; fi
[ $# -eq 1 ] || usage
NAME="$1"
[[ "$NAME" =~ ^[a-z][a-z0-9-]*$ ]] || { echo "build-sidecar: bad name '$NAME'" >&2; exit 2; }
CONTEXT="sidecar/$NAME"
[ -f "$CONTEXT/Dockerfile" ] || { echo "build-sidecar: no $CONTEXT/Dockerfile" >&2; exit 1; }

# ONE definition of the revision: this script stamps it, and bin/publish-sidecar asks for it with
# --revision and verifies the running container's /revision against it.
REVISION="$(git rev-parse HEAD)"
if [ -n "$(git status --porcelain -- "$CONTEXT")" ]; then
  REVISION="$REVISION-dirty"
fi
if [ "$mode" = revision ]; then echo "$REVISION"; exit 0; fi

REPO="ghcr.io/chaim354/${NAME}-sidecar"
# Xtrace off before the secret: under `bash -x` an assignment is traced AFTER expansion.
{ set +x; } 2>/dev/null
KAMAL_REGISTRY_PASSWORD="$(bin/secret KAMAL_REGISTRY_PASSWORD 'op://tinkerex/ghcr.io/password')"
echo "$KAMAL_REGISTRY_PASSWORD" | docker login ghcr.io -u chaim354 --password-stdin
# The box is amd64; build for it (buildx emulates on an arm64 Mac, like the app image).
docker buildx build --platform linux/amd64 \
  --build-arg "SIDECAR_REVISION=$REVISION" \
  --label "org.opencontainers.image.revision=$REVISION" \
  -t "$REPO:latest" -t "$REPO:$REVISION" --push "$CONTEXT"
echo "pushed $REPO:latest (revision $REVISION)"
