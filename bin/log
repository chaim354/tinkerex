#!/usr/bin/env ruby
# frozen_string_literal: true

# THE SINGLE WRITE DOOR onto the Kaneo that replaces docs/STATUS.md.
# `bin/log --help` lists the subcommands; they are defined once, in SUBCOMMANDS.
#
# WHY ONE DOOR. An MCP write path plus a CLI write path is one verb with two answers — the shape
# CLAUDE.md §14a forbids and the shape §14d spent five copies of the `port_writable?` branch
# learning to avoid. MCP stays available for READING and browsing; it is never required, and it
# never writes. A CLI also works everywhere MCP does not: CI, cloud sessions, subagents, worktrees.
#
# NO BUNDLER, NO RAILS, STDLIB ONLY. §14j records that a bundled Ruby process exports
# BUNDLE_GEMFILE and a RUBYOPT force-requiring bundler/setup process-wide, and every child
# inherits both. Loading no gem means this script never needs `bundle install` — a fresh clone, a
# worktree and a cloud session all run it. It is NOT full immunity: an inherited RUBYOPT is applied
# by the ruby binary before line 1, so a caller launching this from inside a bundled process must
# clear those names itself, exactly as test/log_cli_test.rb's BUNDLER_ENV does.
#
# NOTHING BELOW CALLS `exit`. Helpers raise; Log.main decides the code in ONE place. A helper that
# exited raised SystemExit — not a StandardError, not Unreachable — so it sailed straight past the
# rescue that spools, losing the record on the likeliest outage there is (a 502 from a dead
# container behind a live proxy) while the docs promised a spool file.
require "fileutils"
require "json"
require "net/http"
require "open3"
require "openssl"
require "uri"

# CAPTURED SUBPROCESS OUTPUT IS TAGGED WITH THE DEFAULT EXTERNAL ENCODING, which is US-ASCII
# whenever LANG/LC_ALL is unset — cron, systemd, Docker, a bare CI runner. bin/secret's own
# diagnostics carry a UTF-8 ellipsis, so `err.strip` raised Encoding::CompatibilityError and the
# CREDENTIAL path exited 1 with a stack trace instead of 3. Reproduced against this file; no
# developer shell shows it, which is why the test for it unsets LANG explicitly.
Encoding.default_external = Encoding::UTF_8

module Log
  module_function

  EXIT_OK          = 0
  EXIT_USAGE       = 2   # the caller spelled the command wrong
  EXIT_UNREACHABLE = 3   # Kaneo or the vault could not be reached; any write is spooled
  # DELIBERATELY NOT 1. Ruby's own uncaught-exception status IS 1 — measured — so a crash that no
  # rescue can reach (SyntaxError from a bad edit, LoadError, NoMemoryError) would be
  # indistinguishable from "there is unfiled work" to /finish-branch, which reads this code.
  EXIT_UNFILED     = 4   # `status` found a backlog. Loud on purpose, like bin/backup-status.

  # A BUG IS NOT AN OUTAGE. Exit 3 means "unreachable, and a write was spooled"; a NoMethodError is
  # neither spooled nor a network problem, and treating it as non-blocking lets /finish-branch
  # proceed past a broken bin/log as though it were a blip.
  EXIT_BUG = 5

  # ONE TABLE, NOT FOUR LISTS. USAGE is DERIVED from this and `main` dispatches on it, so a
  # subcommand cannot exist in one place and be missing from another. §14d's "ONE file-type
  # vocabulary": EXT_FAMILIES is derived from ROLE_BY_EXT precisely because the second inline list
  # had already drifted. This file's own first draft drifted between its header and its usage text
  # before it was 62 lines old.
  SUBCOMMANDS = {
    "setup"  => [ "",               "Create the labels, idempotently" ],
    "arc"    => [ "--from-pr|--from-file", "Arc from a PR, or --from-file PATH to import (add --closed)" ],
    "open"   => [ '"<title>"',      "File an open item" ],
    "deploy" => [ "--image SHA",    "Record a deploy" ],
    "note"   => [ 'ISSUE "<text>"', "Append a comment to a past issue" ],
    "close"  => [ "ISSUE [ISSUE...]", "Close issues that are done" ],
    "show"   => [ "ISSUE",          "Print one issue" ],
    "search" => [ '"<query>"',      "Search issues" ],
    "status" => [ "",               "Report anything unfiled" ]
  }.freeze

  # THE VAULT ITEM IS TITLED "kaneo" AND THE TOKEN LIVES IN ITS `credential` FIELD, because the item
  # is an API_CREDENTIAL and that is where such an item keeps its key — not a field named "token".
  # CLAUDE.md §13 must name THIS reference and no other: under the previous record the doc named an
  # item and a field the code did not read, and only one of the two could ever have been right.
  TOKEN_REF = "op://tinkerex/kaneo/credential"

  LABELS = %w[arc open-work deploy blocked deliberate
              filelayer library-scan addons previews maker-web ci].freeze

  # STATUSES ARE KEBAB-CASE, FIXED PER PROJECT, AND MEASURED — to-do, in-progress, in-review, done,
  # planned, archived. A POST carrying "To Do" is refused with a 400 that names the whole set, so
  # these are not a spelling choice. There is no open/closed flag anywhere in Kaneo: the board
  # COLUMN is the state, which is why `close` moves a column and why every created task must name
  # one of the six.
  OPEN_STATUS   = "to-do"
  CLOSED_STATUS = "done"

  # THE PAYLOAD RIDES ON THE EXCEPTION, never on a module-level accumulator. `api` knows both what
  # failed and what was being sent, so it attaches the payload at the ONE raise site. Two things
  # fall out that a shared accumulator could not give: a GET carries no payload, so a READ verb
  # spools nothing BY CONSTRUCTION rather than by a rule someone remembers to apply; and nothing
  # accumulates across calls, so a loop failing on its Nth write cannot re-spool the N-1 already
  # filed. (PR 2's import is exactly that loop.)
  class Unreachable < StandardError
    attr_reader :payload, :path

    def initialize(message, payload: nil, path: nil)
      super(message)
      @payload = payload
      @path = path
    end
  end

  class UsageError < StandardError; end

  def kaneo_url      = ENV.fetch("KANEO_URL", "http://kaneo.home")
  def workspace_slug = ENV.fetch("KANEO_WORKSPACE", "tinkerex")
  def project_slug   = ENV.fetch("KANEO_PROJECT", "tinkerex")

  # THE SLUGS ARE CONFIG; THE IDS ARE RESOLVED. Every Kaneo path takes an opaque id, but putting one
  # in an env default would mean a fresh clone cannot run bin/log at all — which is exactly what the
  # old human-readable owner/repo defaults bought. Both lookups are memoized for the process,
  # mirroring label_index's existing shape.
  #
  # TWO LOOKUPS, NOT ONE, AND THE ORDER IS FORCED. The obvious design reads GET /api/project once
  # and takes `workspaceId` off the project record — but GET /api/project REFUSES TO ANSWER WITHOUT
  # A workspaceId QUERY PARAM (measured: 400, "Invalid key: Expected \"workspaceId\" but received
  # undefined"). So the project list cannot be the thing that tells you the workspace; the workspace
  # must be resolved first, from better-auth's own organization list. A workspace in Kaneo IS a
  # better-auth organization — there is no /api/workspace collection to list.
  def workspace_id
    @workspace_id ||= begin
      path = "/api/auth/organization/list"
      orgs = parse(api(:get, path), path)
      found = orgs.find { |o| o["slug"] == workspace_slug }
      raise Unreachable, "no workspace with slug #{workspace_slug.inspect} (set KANEO_WORKSPACE)" unless found

      found.fetch("id")
    end
  end

  def project_id
    @project_id ||= begin
      path = "/api/project?workspaceId=#{workspace_id}"
      body = parse(api(:get, path), path)
      list = body.is_a?(Array) ? body : body.fetch("projects", [])
      found = list.find { |p| p["slug"] == project_slug }
      raise Unreachable, "no project with slug #{project_slug.inspect} (set KANEO_PROJECT)" unless found

      found.fetch("id")
    end
  end

  # REJECT, NEVER NORMALIZE — §14a's key_for rule. **THE ORIGINAL REASON NO LONGER HOLDS AND THE
  # GUARD STILL MUST STAY.** Under the previous record a number was interpolated straight into the
  # request path, so a `..` segment reached the wire verbatim and a normalising proxy could resolve
  # it outside the repo scope. Kaneo addresses every task by an opaque id: a validated number now
  # dead-ends in `task_index[number.to_i]`, a Hash lookup, and every path is built from
  # `task.fetch("id")` — so traversal has no route to the wire at all, and a reader who checks that
  # claim finds it false and deletes this as dead weight.
  #
  # WHAT IT PROTECTS NOW IS THE EXIT CODE. Without it `bin/log show <garbage>` resolves to
  # `task_index[0]`, misses, and raises Unreachable — exit 3, "unreachable, and a write was
  # spooled". /finish-branch reads these codes and would treat a typo as an outage it can wait out.
  # A malformed argument is a usage error: exit 2, said by this method and nowhere else.
  def issue_number!(value)
    raise UsageError, "not an issue number: #{value.inspect}" unless value.to_s.match?(/\A\d+\z/)

    value
  end

  # THROUGH bin/secret, NEVER `op read` DIRECTLY. That file is this repo's single definition of
  # where a credential comes from, and it is what makes an exported value win over the vault.
  # capture3 keeps the streams apart: bin/secret sends the value only on fd1 and its diagnostics
  # only on fd2, so forwarding err cannot leak. Any rewrite that merges them re-opens the
  # 2026-07-29 leak. `.chomp` because nothing else asserts bin/secret's --no-newline contract, and
  # a trailing newline is an ArgumentError inside the header assignment.
  def token
    @token ||= begin
      out, err, status = Open3.capture3(File.expand_path("secret", __dir__), "KANEO_TOKEN", TOKEN_REF)
      raise Unreachable, "could not resolve KANEO_TOKEN from #{TOKEN_REF}: #{err.strip}" if !status.success? || out.empty?

      out.chomp
    end
  end

  def api(method, path, body = nil)
    perform(method, path, body)
  rescue Unreachable => e
    # Attach what was being sent, and to what path, at the one place that knows all three. A
    # failure raised from `token` carries neither payload nor path of its own, and a WRITE must
    # still be spooled with enough context to refile it. `note` used to depend on this entirely —
    # its target lived in the PATH (/issues/128/comments) and nowhere else. It no longer does: Kaneo
    # addresses a comment by an opaque id, so `note` carries its own rescue that puts the number in
    # the message. This line still matters for every OTHER write, whose payload is the whole record.
    raise Unreachable.new(e.message, payload: e.payload || body, path: e.path || path)
  rescue SystemCallError, SocketError, EOFError, IOError, Timeout::Error,
         Net::OpenTimeout, Net::ReadTimeout, Net::ProtocolError,
         OpenSSL::SSL::SSLError => e
    raise Unreachable.new("#{kaneo_url}: #{e.class}: #{e.message}", payload: body, path: path)
  end

  # URI.join DROPS A PATH PREFIX — URI.join("http://host/git", "/api/x") is "http://host/api/x".
  # Kaneo behind a subpath is an ordinary self-host shape, so the URL is built by concatenation
  # instead.
  def perform(method, path, body)
    uri = URI.parse("#{kaneo_url.chomp('/')}#{path}")
    # A scheme-less KANEO_URL parses to host=nil, and Net::HTTP.start(nil, nil) then reports
    # "connection refused for nil port 80" — a misleading answer to a malformed env var.
    raise UsageError, "KANEO_URL has no scheme or host: #{kaneo_url.inspect}" unless uri.host

    request = case method
    when :get   then Net::HTTP::Get.new(uri)
    when :post  then Net::HTTP::Post.new(uri)
    # PUT, NOT PATCH. The old instance closed an issue by PATCHing its state; Kaneo has no issue to
    # edit — it moves a task to a column with PUT /task/status/:id. Keeping the verb here rather
    # than in `close` keeps every request in this one method, which is what makes the Authorization
    # header, the timeouts and the Unreachable mapping impossible to bypass by adding a subcommand.
    when :put   then Net::HTTP::Put.new(uri)
    else raise ArgumentError, "unsupported method #{method.inspect}"
    end

    # BEARER, NOT `token <t>`. Kaneo takes an ordinary Bearer credential; the old instance's own
    # scheme was `token <t>`, which Kaneo answers 401 to — and a 401 is a non-2xx, so it arrives as
    # Unreachable and SPOOLS every write rather than failing loudly.
    request["Authorization"] = "Bearer #{token}"
    request["Content-Type"]  = "application/json"
    request.body = JSON.generate(body) if body

    response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https",
                                                   open_timeout: 5, read_timeout: 15) do |http|
      http.request(request)
    end

    # A NON-2xx IS UNREACHABLE TOO, AND THAT IS THE POINT OF THIS METHOD. A dead container behind
    # a live proxy answers 502 and a rotated token answers 401 — both are HTTP RESPONSES, so a
    # handler that only caught connection errors would let the LIKELIEST outage exit without
    # spooling, which is how an arc gets lost while the docs promise otherwise.
    code = response.code.to_i
    unless code.between?(200, 299)
      raise Unreachable, "HTTP #{response.code} from #{path}: #{response.body.to_s[0, 200]}"
    end

    response
  end

  # A 2xx WHOSE BODY IS NOT JSON IS AN OUTAGE, NOT A CRASH. A proxy error page and Kaneo's own
  # login page on a session redirect both arrive as 200 text/html. Unwrapped, JSON::ParserError
  # escaped to Ruby's default handler and exited 1.
  def parse(response, path)
    JSON.parse(response.body)
  rescue JSON::ParserError => e
    raise Unreachable, "#{path} returned #{response.code} with a non-JSON body: #{e.message}"
  end

  # THE MAP IS FETCHED ONCE PER PROCESS, not once per lookup — `close` takes several numbers and the
  # unit of work is "this branch is done", so a per-number GET would be one full board per issue.
  #
  # THIS ENDPOINT RETURNS A BOARD, NOT A LIST, and its OpenAPI response type is a bare
  # `{"type":"object"}` with no properties — so the shape below was OBSERVED against the live
  # instance on 2026-08-31, never read. Tasks live in `data.columns[].tasks`, and TWO MORE BUCKETS
  # SIT BESIDE THEM: `archivedTasks` and `plannedTasks` are off-board and appear in neither column.
  # Miss them and the affected issues resolve to "no issue #N" while sitting in the record perfectly
  # intact. A resolver reading a flat array, or `body.fetch("tasks", [])`, builds an EMPTY index in
  # SILENCE — and every stub test still passes, because the stub models nothing.
  #
  # IT ALSO PAGINATES, AND THE LIMIT IS CAPPED. A request for `limit=200` came back with
  # `pageSize: 100`, so one call sees roughly half of the 193 imported tasks — a well-formed lie,
  # the same shape as a 50-capped list endpoint answering an exporter that trusts one page.
  def task_index
    @task_index ||= begin
      tasks = []
      page = 1
      loop do
        path = "/api/task/tasks/#{project_id}?page=#{page}&limit=100"
        body = parse(api(:get, path), path)
        data = body.fetch("data", {})
        tasks.concat(data.fetch("columns", []).flat_map { |c| c["tasks"] || [] })
        tasks.concat(data["archivedTasks"] || [])
        tasks.concat(data["plannedTasks"] || [])
        break if page >= body.dig("pagination", "totalPages").to_i

        page += 1
      end
      tasks.to_h { |t| [ t["number"], t ] }
    end
  end

  # THE CITABLE NUMBER IS NOT ADDRESSABLE. Every Kaneo path takes the opaque `id`, so a number the
  # record cites — `tinkerex#178`, and 21 such citations in app/ lib/ test/ config/ — has to be
  # resolved through the board before any addressed call can be made.
  #
  # RAISES Unreachable, NOT UsageError. The number is well-formed — issue_number! already rejected a
  # traversal attempt — so this is "the record does not have that", which is the same class of
  # answer as a 404 from an issue endpoint and must spool nothing on a read.
  def task_for(number)
    task_index[number.to_i] or raise Unreachable, "no issue ##{number} in #{project_slug}"
  end

  def show(argv)
    number = argv.shift or raise UsageError, "show needs an issue number"
    number = issue_number!(number)
    task = task_for(number)

    puts "##{task['number']} #{task['title']} [#{task['status']}]"
    puts
    puts task["description"]
    EXIT_OK
  end

  # FOUR CORRECTIONS IN ONE VERB, ALL MEASURED against the live instance on 2026-08-31. The record
  # this replaced needed none of them: its search path named the repo, and its response was a list
  # of issues.
  #
  #   1. workspaceId IS REQUIRED. Without it: 400, "Workspace ID could not be determined".
  #   2. projectId DOES NOT FILTER. Passing it changed nothing — totalCount stayed identical — so
  #      the scoping this verb needs has to happen HERE. Unfiltered, a query returns tasks from
  #      every other project in the workspace as though they were part of the record.
  #   3. THE ENVELOPE IS `results`, NOT `tasks`, and results are mixed `type`: task, project,
  #      activity, comment. A comment matching the query would print as though it were an issue.
  #   4. A TASK ROW CARRIES `taskNumber`, NOT `number`. Reading `number` yields nil, so every line
  #      would print `#` and nothing else — for results that are otherwise correct.
  #
  # The two client-side filters look redundant against a server that takes a projectId. They are
  # not: it takes it and ignores it. Both were probed, not reasoned about.
  #
  # NOTHING HERE ASKS FOR A STATE, and that is not an omission. Kaneo's search spans every column,
  # so a finished arc is found by default — the previous record needed an explicit state=all to get
  # the same answer, and hid every closed arc without it.
  #
  # THE QUERY IS PERCENT-ENCODED, NOT INTERPOLATED. A bare `&` starts a new query parameter and a
  # bare `#` starts a fragment, so either one silently searches for something else.
  def search(argv)
    query = argv.shift or raise UsageError, "search needs a query"
    # THE SEARCH LIMIT IS 50 AND THE BOARD LIMIT IS 100 — TWO CAPS, MEASURED, AND NOT INTERCHANGEABLE.
    # /api/search REFUSES limit=100 outright: 400, `{"kind":"validation","expected":"<=50"}`. The board
    # endpoint task_index walks accepts 100 happily. Neither cap is in Kaneo's OpenAPI, and NO STUB
    # TEST CAN FIND EITHER — the stub records what we send and validates nothing, so a green suite
    # said this verb worked right up until it was pointed at the real server.
    path = "/api/search?q=#{URI.encode_www_form_component(query)}&workspaceId=#{workspace_id}&limit=50"
    body = parse(api(:get, path), path)
    tasks = body.fetch("results", [])
                .select { |r| r["type"] == "task" && r["projectId"] == project_id }

    if tasks.empty?
      puts "bin/log: no issues matching #{query.inspect}."
    else
      tasks.each { |t| puts "##{t['taskNumber']} [#{t['status']}] #{t['title']}" }
    end
    EXIT_OK
  end

  # THE VOCABULARY IS THE ROWS WITH `taskId` NULL, AND THAT FILTER IS LOAD-BEARING. Kaneo keeps
  # label DEFINITIONS and label ATTACHMENTS in ONE table: `POST /label` with a taskId stores an
  # attached row, without one stores a free row, and `GET /label/workspace/:id` returns BOTH.
  # Measured. Unfiltered, every labelled arc in the record contributes an `arc` row, so `setup`
  # would report the vocabulary complete purely because 135 tasks carry attachments — and would keep
  # reporting it after someone deleted the definition, which is the one thing it exists to notice.
  #
  # NOTHING RESOLVES A NAME TO AN ID ANY MORE. The record this replaced refused label NAMES on
  # issue-create and demanded int64 ids; Kaneo takes the name on `POST /label` and attaches in that
  # same call, so this index exists only for `setup`, and a create never consults it.
  def label_index
    @label_index ||= begin
      path = "/api/label/workspace/#{workspace_id}"
      rows = parse(api(:get, path), path)
      rows.select { |l| l["taskId"].nil? }.to_h { |l| [ l["name"], l["id"] ] }
    end
  end

  # TWO CALLS, AND THE SECOND ONE CAN FAIL ON ITS OWN. `POST /task/:projectId` has no labels field,
  # so creation is not atomic the way a single issue POST was: the task can exist with no label.
  #
  # THE PAYLOAD IS BUILT BEFORE ANY WIRE CALL, and that ordering is load-bearing. Resolving the
  # project makes a GET the FIRST wire call of every write verb, so a payload built after it would
  # still be nil when that GET failed — and the rescue below would report "nothing to file" for what
  # is unambiguously a write. An `open` against a dead server would silently become a no-record.
  # Measured as a regression the moment id resolution landed, and true again for a different reason
  # now that the resolution is the workspace and the project rather than the labels.
  #
  # THE STATUS IS ALWAYS SENT, AND THE DEFAULT IS THE LIVE ONE. There is no "omit it when false"
  # option here the way there was for a `closed:` flag — a task must name a column — so the same
  # verb serving a live arc and a historical import turns entirely on this default being OPEN.
  def create_task(title, body:, labels:, closed: false)
    payload = {
      title: title,
      description: body,
      priority: "no-priority",
      status: closed ? CLOSED_STATUS : OPEN_STATUS
    }
    # Through `parse`, not JSON.parse — a WRITE against a broken proxy answers 200 text/html just
    # as readily as a read does, and an unwrapped JSON::ParserError exits 1 instead of spooling.
    task = parse(api(:post, "/api/task/#{project_id}", payload), "/api/task")

    labels.each do |name|
      api(:post, "/api/label", { name: name, color: "#666666",
                                 workspaceId: workspace_id, taskId: task.fetch("id") })
    rescue Unreachable => e
      # REPORTED, NAMING THE TASK THAT DID GET CREATED — never swallowed. An arc with no `arc` label
      # is invisible to every search that filters by kind, and silently so.
      #
      # IT CARRIES THE LABEL PAYLOAD FORWARD, NOT THE CREATE'S. What is unfiled at this point is the
      # ATTACHMENT; the task exists, at the number named in this message. Letting the create payload
      # reach the spool instead — which the rescue below does for anything arriving with no payload
      # of its own — invites a refile that files a SECOND arc at a new number, which no citation
      # points at and nothing would flag.
      raise Unreachable.new(
        "##{task['number']} was created but the #{name.inspect} label failed: #{e.message}",
        payload: e.payload, path: e.path
      )
    end

    task
  rescue Unreachable => e
    # `parse` RAISES WITH NO PAYLOAD OF ITS OWN — it only ever sees the response, never what was
    # sent. That is fine for a GET (show, search), which has no payload to lose, but `create_task`
    # calls `parse` AFTER `api` has already returned successfully — outside api's own rescue, which
    # only wraps the `perform` call inside IT. A 2xx with a garbled body (the exact shape a broken
    # proxy produces) therefore failed here with payload: nil, was reported as "nothing to file",
    # and the task being created was silently lost. `e.payload || payload` only fills the gap;
    # a failure `api` already payloaded (a connection error, a non-2xx) passes through unchanged.
    raise Unreachable.new(e.message, payload: e.payload || payload, path: e.path || "/api/task")
  end

  # NOT `open` — inside this module that name would resolve ahead of Kernel#open for every other
  # method here, and File.open is one edit away from being needed.
  def open_item(argv)
    title = argv.shift or raise UsageError, "open needs a title"
    task = create_task(title, body: argv.shift.to_s, labels: [ "open-work" ])

    puts "##{task['number']} #{task['title']}"
    EXIT_OK
  end

  # GH_BIN is an override, not a convenience — it is what lets the suite drive this path with no
  # network and no GitHub credential. Defaulting to the PATH lookup keeps normal use unchanged.
  def pull_request(number)
    out, err, status = Open3.capture3(ENV.fetch("GH_BIN", "gh"), "pr", "view", number.to_s,
                                      "--json", "title,body,url")
    raise Unreachable, "could not read PR #{number}: #{err.strip}" unless status.success?

    # Not `parse` — that takes a Kaneo response. gh answering non-JSON (an auth prompt, a
    # rate-limit notice) would otherwise surface through the catch-all as "unexpected failure",
    # which names neither gh nor the PR.
    JSON.parse(out)
  rescue JSON::ParserError => e
    raise Unreachable, "gh returned non-JSON for PR #{number}: #{e.message}"
  end

  def arc(argv)
    flag = argv.shift
    title, body = nil

    case flag
    when "--from-pr"
      number = argv.shift or raise UsageError, "arc needs --from-pr N"
      pr = pull_request(number)
      title = pr["title"]
      body = "#{pr['body']}\n\n---\nPR: #{pr['url']}\n"
    when "--from-file"
      path = argv.shift or raise UsageError, "arc needs --from-file PATH"
      title, body = section(path)
    else
      raise UsageError, "arc needs --from-pr N or --from-file PATH"
    end

    task = create_task(title, body: body, labels: [ "arc" ], closed: argv.include?("--closed"))

    puts "##{task['number']} #{task['title']}"
    EXIT_OK
  end

  # THE FIRST HEADING IS THE TITLE, and its absence is a refusal rather than a guess. 112 sections
  # import unattended; one silently titled "" is one nobody ever finds again.
  def section(path)
    text = File.read(path, encoding: Encoding::UTF_8)
    heading = text[/\A\s*#+\s*(.+)$/, 1] or
      raise UsageError, "#{path}: no leading heading — cannot title the issue"

    [ heading.strip, text.sub(/\A\s*#+\s*.+$\n?/, "").strip ]
  end

  # IDEMPOTENT BY ASKING WHAT EXISTS, NOT BY TOLERATING A REFUSAL — the rule survives the move
  # unchanged, and so does what it cost. The record this replaced ALLOWED DUPLICATE LABEL NAMES:
  # measured, a second `setup` run created a second copy of all eleven and reported "11 labels
  # present" both times, leaving 22. The design before that tolerated a 422 the server never sent,
  # and a test could not have caught it — the stub answered 422 because the test said to. Nothing
  # observed says Kaneo refuses a duplicate name either, so `setup` still asks first.
  #
  # It VERIFIES rather than assuming its POSTs worked. "I sent eleven requests" is not the claim
  # this command makes; "eleven labels exist" is.
  #
  # A LABEL POSTED WITH NO taskId IS A DEFINITION, and that is the whole difference between this
  # call and the one `create_task` makes — see label_index.
  def setup
    already = LABELS & label_index.keys

    (LABELS - already).each do |name|
      api(:post, "/api/label", { name: name, color: "#666666", workspaceId: workspace_id })
    end

    @label_index = nil
    missing = LABELS - label_index.keys
    raise Unreachable, "labels missing after setup: #{missing.join(', ')}" if missing.any?

    puts "bin/log: #{LABELS.size} labels present (#{LABELS.size - already.size} created, #{already.size} already there)."
    EXIT_OK
  end

  # A DEPLOY IS AN ISSUE, WHICH IS WHAT DELETES CLAUDE.md §15's PUSH-TO-MAIN EXCEPTION. Today a
  # deploy record is the one sanctioned direct commit to main, because a deploy happens after the
  # merge and its record cannot live in the work's own PR. As an issue that reasoning evaporates.
  #
  # AND IT IS FILED CLOSED, unlike every other thing this script creates. A deploy record is
  # HISTORY: `bin/log deploy` is the last step of a deploy that has already rolled and been
  # verified, so there is no later event for an open state to be waiting on. An arc is filed open
  # because its close tracks the merge; a deploy has no merge. Left open it simply accumulated —
  # measured 2026-09-01, six open deploy records, while all twelve closed ones turned out to be
  # Forgejo-migration imports rather than closures anyone made. One false entry in the record's
  # open list per deploy is the stale-open-list failure §14e calls worse than no list at all.
  DEFAULT_DESTS = %w[chunk_remote share s3].freeze

  def deploy(argv)
    image = nil
    dests = DEFAULT_DESTS

    until argv.empty?
      flag = argv.shift
      case flag
      when "--image" then image = argv.shift or raise UsageError, "--image needs a value"
      when "--dest"  then dests = (argv.shift or raise UsageError, "--dest needs a value").split(",")
      # REFUSE, NEVER GUESS. A typo'd flag used to fall through to the three defaults silently,
      # filing a deploy record naming destinations nobody deployed.
      else raise UsageError, "deploy: unrecognised argument #{flag.inspect}"
      end
    end

    raise UsageError, "deploy needs --image SHA" if image.nil?

    body = "Image: `#{image}`\n\nDestinations:\n#{dests.map { |d| "- #{d}" }.join("\n")}\n"
    # FILED CLOSED, AND THE `closed: true` IS EXPLICIT FOR THE SAME REASON `arc` PASSES A BOOLEAN:
    # it leaves `open` as the ONLY caller riding the keyword default, which is what keeps that
    # default's guard honest. See the two tests in test/log_cli_test.rb.
    task = create_task("Deploy #{image}", body: body, labels: [ "deploy" ], closed: true)

    puts "##{task['number']} #{task['title']}"
    EXIT_OK
  end

  # A CORRECTION IS A COMMENT, NOT AN EDIT — never rewrite the task description. Unchanged in intent
  # from the previous record; only the endpoint and the payload key moved (`body` became `content`).
  #
  # THE PAYLOAD IS BUILT BEFORE THE RESOLUTION, for the same reason `create_task`'s is.
  def note(argv)
    # TWO LINES, NOT `issue_number!(argv.shift or raise ...)`. `or` binds looser than an argument
    # list, so the one-line form is a SyntaxError, not a style choice — `show` reads this way for
    # the same reason.
    number = argv.shift or raise UsageError, "note needs an issue number"
    number = issue_number!(number)
    text = argv.shift or raise UsageError, "note needs text"
    payload = { content: text }
    task = task_for(number)
    api(:post, "/api/comment/#{task.fetch('id')}", payload)

    puts "noted on ##{number}"
    EXIT_OK
  rescue Unreachable => e
    # THE ISSUE NUMBER IS NOW IN NEITHER THE PAYLOAD NOR THE PATH, WHICH IS WHY THIS RESCUE EXISTS.
    # The previous record's path carried it (/issues/128/comments), so spooling path + payload was
    # enough. Kaneo addresses a comment by the task's opaque id, and resolving that id is this
    # verb's FIRST wire call — so an outage fails inside task_for, whose path names the board and
    # not the issue. A correction spooled without the number is unrefilable: the text says what was
    # wrong, and nothing says about what.
    raise Unreachable.new(e.message, payload: e.payload || payload,
                                     path: "#{e.path || '/api/comment'} (issue ##{number})")
  end

  # CLOSING IS A WRITE, SO IT COMES THROUGH THIS DOOR TOO. It exists because nothing else closes an
  # issue here: the arc header's "it closes when the PR merges" describes a linkage that does not
  # exist in this setup — the PRs are on GitHub and the record is self-hosted, and nothing bridges
  # them. tinkerex#154 merged and deployed with its arc, its deploy record and both issues it
  # resolved still showing open. Before this, the only ways to close one were the web UI (fine for a
  # person, unavailable to CI, a cloud session or a subagent) or a raw curl, which is precisely the
  # SECOND write path the single-door rule exists to forbid.
  #
  # CLOSING IS A COLUMN MOVE NOW, not a state change — Kaneo has no open/closed flag, only the
  # board column, so this is `PUT /task/status/:id` carrying the Done slug. Three properties of
  # the verb survive that move unchanged:
  #
  # SEVERAL NUMBERS IN ONE CALL, BECAUSE THE UNIT OF WORK IS "this branch is done" and that
  # routinely resolves an arc plus the issues it answers. Each is its own request; a failure part
  # way through leaves the earlier ones closed and says which, rather than pretending the batch
  # was atomic.
  #
  # ALREADY-CLOSED IS REPORTED, NOT RE-SENT. A redundant status write is accepted happily, so the
  # naive version is silently idempotent — which reads as "I closed it" for an issue somebody else
  # closed for a different reason. The board this reads is already fetched, so the check is free.
  def close(argv)
    numbers = argv.map { |a| issue_number!(a) }
    raise UsageError, "close needs at least one issue number" if numbers.empty?

    numbers.each do |number|
      task = task_for(number)

      if task["status"] == CLOSED_STATUS
        puts "##{number} was already closed"
        next
      end

      api(:put, "/api/task/status/#{task.fetch('id')}", { status: CLOSED_STATUS })
      puts "closed ##{number} #{task['title']}"
    end
    EXIT_OK
  end

  def spool_dir = ENV.fetch("LOG_SPOOL_DIR", File.expand_path("../tmp/log-pending", __dir__))

  # THE BRANCH NAMES THE SPOOL FILE, so two branches cannot overwrite each other's unfiled record.
  #
  # A DETACHED HEAD REPORTS AN EMPTY BRANCH, AND AN EMPTY NAME MADE THE SPOOL FILE A DOTFILE — which
  # `status` then could not see. `git branch --show-current` prints "" when HEAD is detached, so the
  # file became `<spool>/.md`, and `Dir.glob("<spool>/*.md")` does NOT match a leading dot. The record
  # was written, `status` answered "nothing unfiled", and exit 4 — which exists to make a backlog
  # loud — could never fire. Silent, and in exactly the environments §13 says this script must work
  # in: GitHub Actions checks out a SHA, and so does `git bisect`.
  #
  # THE SHA IS THE FALLBACK RATHER THAN A LITERAL, because a spooled record you cannot attribute is
  # most of the way to a lost one — "detached" alone would collide across every such run. Two
  # detached checkouts of the SAME commit sharing one file is correct: it is the same work.
  def current_branch
    name = ENV["LOG_BRANCH"] || Open3.capture2("git", "branch", "--show-current").first.strip
    return name unless name.empty?

    sha = Open3.capture2("git", "rev-parse", "--short", "HEAD").first.strip
    sha.empty? ? "detached" : "detached-#{sha}"
  end

  def spool!(command, payload, path = nil)
    FileUtils.mkdir_p(spool_dir)
    file = File.join(spool_dir, "#{current_branch.tr('/', '-')}.md")
    File.open(file, "a") do |f|
      f.puts("# unfiled: #{command}")
      # THE ENDPOINT IS RECORDED BECAUSE A PAYLOAD ALONE IS OFTEN NOT ENOUGH TO REFILE. It used to
      # be `note`'s only link to its issue (/issues/128/comments); under Kaneo `note` names the
      # number in its own message instead, because the id is opaque and resolving it is the verb's
      # first wire call. Keep this line: it is what tells a label attachment from a task create when
      # both are sitting in the same spool file.
      f.puts("# endpoint: #{path}") if path
      f.puts("", JSON.pretty_generate(payload), "")
    end
    file
  end

  def status
    pending = Dir.glob(File.join(spool_dir, "*.md")).sort

    if pending.empty?
      puts "bin/log: nothing unfiled."
      return EXIT_OK
    end

    puts "bin/log: #{pending.size} unfiled record(s) — these are NOT in Kaneo:"
    pending.each { |path| puts "    #{path}" }
    EXIT_UNFILED
  end

  def usage_text
    rows = SUBCOMMANDS.map do |name, (args, description)|
      "    " + "bin/log #{name} #{args}".rstrip.ljust(34) + description
    end

    ([ "bin/log — record work in Kaneo. The single write door.", "" ] + rows + [
      "",
      "Env: KANEO_URL (default http://kaneo.home), KANEO_WORKSPACE and KANEO_PROJECT " \
      "(both default tinkerex), " \
      "LOG_SPOOL_DIR (default tmp/log-pending), LOG_BRANCH"
    ]).join("\n")
  end

  def main(argv)
    command = argv.shift

    # AN ASKED-FOR USAGE IS NOT AN ERROR: stdout, exit 0, so `bin/log --help | less` works.
    # A no-argument invocation IS one, so it goes to stderr and exits 2.
    if [ "--help", "-h", "help" ].include?(command)
      puts usage_text
      return EXIT_OK
    end

    if command.nil?
      warn usage_text
      return EXIT_USAGE
    end

    unless SUBCOMMANDS.key?(command)
      warn "bin/log: unknown command #{command.inspect}"
      warn usage_text
      return EXIT_USAGE
    end

    dispatch(command, argv)
  rescue UsageError => e
    warn "bin/log: #{e.message}"
    warn usage_text
    EXIT_USAGE
  rescue Unreachable => e
    warn "bin/log: Kaneo is unreachable — #{e.message}"

    if e.payload.nil?
      warn "bin/log: nothing to file (#{command} sends no payload)."
      return EXIT_UNREACHABLE
    end

    # THE SPOOL NEEDS ITS OWN RESCUE. Ruby does NOT route an exception raised inside a `rescue`
    # clause to that begin's SIBLING rescues — measured: it escapes straight to the caller. So a
    # failing spool skipped main's catch-all entirely and exited 1 with a raw FileUtils trace,
    # having already printed the recoverable "unreachable" message. The record was simply gone.
    # Ordinary triggers here: a read-only filesystem, a container without git (current_branch
    # shells out to it), tmp/ owned by another user after one sudo run, ENOSPC.
    begin
      path = spool!(command, e.payload, e.path)
      warn "bin/log: the entry was NOT filed. It is spooled at #{path}"
      warn "bin/log: `bin/log status` will keep reporting it until you file it."
    rescue StandardError => spool_error
      warn "bin/log: THE SPOOL ALSO FAILED (#{spool_error.class}: #{spool_error.message})."
      warn "bin/log: the entry is LOST unless you copy it from here:"
      warn JSON.pretty_generate(e.payload)
    end

    EXIT_UNREACHABLE
  rescue StandardError => e
    # THE CATCH-ALL IS STRUCTURAL, NOT A CONVENIENCE. Enumerating transport exception classes never
    # closes the gap — JSON::ParserError, Net::HTTPBadResponse, OpenSSL::SSL::SSLError and EOFError
    # all escaped the first list at one point, and every one of them exited 1. This arm exists so an
    # unanticipated exception still gets a controlled exit rather than Ruby's own crash handler.
    #
    # A BUG IS NOT AN OUTAGE. Whatever lands here was never wrapped in `Unreachable`, so it was
    # never spooled — reporting it as EXIT_UNREACHABLE claimed a write had been queued when nothing
    # had. EXIT_BUG says plainly that this is neither spooled nor a network problem, so a caller
    # like /finish-branch does not treat a broken bin/log as a blip it can sail past.
    warn "bin/log: unexpected failure — #{e.class}: #{e.message}"
    warn "bin/log: THIS WAS NOT SPOOLED. Nothing has been recorded."
    warn e.backtrace.first(3).join("\n") if e.backtrace
    EXIT_BUG
  end

  # EVERY SUBCOMMAND DECLARED IN SUBCOMMANDS NOW HAS AN ARM HERE — the table and the dispatch
  # cannot drift apart, because the `else` below raises rather than reading as a quiet "not
  # implemented yet" the way it did while this file was still being built arm by arm.
  #
  # EVERY ARM ENDS IN AN EXPLICIT EXIT_* CONSTANT. `puts` returns nil, and exit(nil) is a
  # TypeError whose status is 1 — Ruby's own uncaught-exception status, and no longer any of our
  # EXIT_* constants now that EXIT_UNFILED has moved off 1 (see its comment above). An arm that
  # forgets would report a successful file as an opaque crash. The guard at the bottom of the
  # file makes that loud instead of silent.
  def dispatch(command, argv)
    case command
    when "show" then show(argv)
    when "open" then open_item(argv)
    when "arc" then arc(argv)
    when "status" then status
    when "setup" then setup
    when "deploy" then deploy(argv)
    when "note" then note(argv)
    when "close" then close(argv)
    when "search" then search(argv)
    else
      # Every subcommand in SUBCOMMANDS is now implemented, so this arm is unreachable. Raising
      # loudly means a future subcommand added to SUBCOMMANDS without a dispatch arm fails loudly
      # instead of silently exiting 2, which is what the old "not implemented yet" warning did.
      raise "unreachable: #{command}"
    end
  end
end

# ARGV IS TAGGED BEFORE LINE 1 RUNS, so the default_external set above cannot retag it. Under a
# locale-less shell an argument containing any non-ASCII byte — an em dash, which this repo's titles
# use constantly — arrives as ASCII-8BIT, and JSON.generate warns today and RAISES in json 3.0.
# Measured: `ARGV[0].encoding` is ASCII-8BIT for "smoke test — safe" with LANG unset.
code = Log.main(ARGV.map { |arg| arg.dup.force_encoding(Encoding::UTF_8) })
code = "not-an-integer" if ENV["LOG_FORCE_BAD_RETURN"]   # exercises the guard below; see the test

raise "bin/log: main returned #{code.inspect}, not an exit code" unless code.is_a?(Integer)

exit code
