#!/usr/bin/env ruby
# frozen_string_literal: true

# ONE-TIME MIGRATION TOOL: Forgejo -> Kaneo. Deleted once the cutover is verified; it is committed
# in between so the import is reviewable and, if a step has to be redone, re-runnable.
# Plan: docs/superpowers/plans/2026-08-31-forgejo-to-kaneo.md
#
# NO BUNDLER, NO RAILS, STDLIB ONLY — the rule bin/log carries, for the same reason (CLAUDE.md
# §14j): a bundled parent exports BUNDLE_GEMFILE and a RUBYOPT force-requiring bundler/setup
# process-wide, and every child inherits both. Loading no gem means a fresh clone, a worktree and a
# cloud session all run this.
#
# NOTHING HERE CALLS `exit`. Helpers raise; the caller decides. Same shape as bin/log, and for the
# same reason — a helper that exited raised SystemExit, which is not a StandardError and sails past
# any rescue meant to catch it.
require "fileutils"
require "json"
require "net/http"
require "open3"
require "uri"

# Captured subprocess output is tagged with the default external encoding, which is US-ASCII
# whenever LANG/LC_ALL is unset — cron, Docker, a bare CI runner. bin/secret's diagnostics carry a
# UTF-8 ellipsis and this record's titles are full of em dashes, so without this a perfectly good
# credential read raises Encoding::CompatibilityError. Measured in bin/log before this file existed.
Encoding.default_external = Encoding::UTF_8

module Migrate
  module_function

  FORGEJO_URL   = ENV.fetch("FORGEJO_URL", "http://forgejo.home")
  FORGEJO_OWNER = ENV.fetch("FORGEJO_OWNER", "chaim354")
  FORGEJO_REPO  = ENV.fetch("FORGEJO_REPO", "tinkerex")
  KANEO_URL     = ENV.fetch("KANEO_URL", "http://kaneo.home")

  FORGEJO_TOKEN_REF = "op://tinkerex/forgejo key/credential"

  # THE ITEM IS "kaneo", NOT "kaneo key" — it does not match the forgejo item's convention and that
  # is fine; what matters is that the title carries no trailing space. It was created as "kaneo "
  # and renamed on 2026-08-31, because an invisible character in this reference would have been
  # copied into bin/log's TOKEN_REF *and* into CLAUDE.md §13, where no reviewer could see it. This
  # repo already carries one doc/code mismatch on exactly this reference under Forgejo.
  # bin/log must name this same string when Phase D lands.
  KANEO_TOKEN_REF = "op://tinkerex/kaneo/credential"

  class Failed < StandardError; end

  # THROUGH bin/secret, NEVER `op read` DIRECTLY — that file is this repo's single definition of
  # where a credential comes from, and it is what makes an exported value win over the vault.
  # capture3 keeps the streams apart: bin/secret sends the value only on fd1 and its diagnostics only
  # on fd2, so forwarding `err` cannot leak the value. Any rewrite that merges them re-opens the
  # 2026-07-29 leak.
  def secret(name, ref)
    out, err, status = Open3.capture3(File.expand_path("secret", __dir__), name, ref)
    raise Failed, "could not resolve #{name} from #{ref}: #{err.strip}" if !status.success? || out.empty?

    out.chomp
  end

  def forgejo_token = @forgejo_token ||= secret("FORGEJO_TOKEN", FORGEJO_TOKEN_REF)

  def kaneo_token = @kaneo_token ||= secret("KANEO_TOKEN", KANEO_TOKEN_REF)

  # ONE REQUEST METHOD FOR BOTH SERVERS, differing only in the Authorization header — Forgejo takes
  # `token <t>`, Kaneo takes `Bearer <t>`. Keeping them in one place is what stops a later edit from
  # sending a Forgejo-shaped header to Kaneo and reading the resulting 401 as a bad key.
  #
  # A NON-2xx RAISES. This tool's failure mode is a half-finished import, so every call has to fail
  # loudly at the point it goes wrong rather than return nil and let the loop carry on.
  def request(base, auth, method, path, body = nil)
    uri = URI.parse("#{base.chomp('/')}#{path}")
    klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, put: Net::HTTP::Put,
              patch: Net::HTTP::Patch, delete: Net::HTTP::Delete }.fetch(method)
    req = klass.new(uri)
    req["Authorization"] = auth
    req["Content-Type"] = "application/json"
    req.body = JSON.generate(body) if body

    res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https",
                                              open_timeout: 5, read_timeout: 30) { |h| h.request(req) }
    code = res.code.to_i
    unless code.between?(200, 299)
      raise Failed, "HTTP #{res.code} from #{method.to_s.upcase} #{path}: #{res.body.to_s[0, 300]}"
    end

    res.body.to_s.empty? ? nil : JSON.parse(res.body)
  end

  def forgejo(method, path, body = nil)
    request(FORGEJO_URL, "token #{forgejo_token}", method,
            "/api/v1/repos/#{FORGEJO_OWNER}/#{FORGEJO_REPO}#{path}", body)
  end

  def kaneo(method, path, body = nil)
    request(KANEO_URL, "Bearer #{kaneo_token}", method, "/api#{path}", body)
  end

  # The workspace, measured 2026-08-31: a Kaneo workspace IS a better-auth organization, and there is
  # no /api/workspace collection to list. GET /api/project REFUSES to answer without a workspaceId
  # query param (400), so this must resolve first — the project list cannot be what tells you the
  # workspace.
  def workspace_id(slug = "tinkerex")
    @workspace_id ||= begin
      orgs = kaneo(:get, "/auth/organization/list")
      found = orgs.find { |o| o["slug"] == slug }
      raise Failed, "no workspace with slug #{slug.inspect}: saw #{orgs.map { |o| o['slug'] }.inspect}" unless found

      found.fetch("id")
    end
  end

  # ---------------------------------------------------------------------------------------------
  # EXPORT. Runs before anything is created and is the only safety net this migration has: Forgejo
  # was never covered by ops/backup-db.sh, which knows only chunk|share|s3|sync, so until this file
  # exists the live instance is the sole copy of the record. Everything downstream is redoable from
  # it, which is what makes "delete the project and re-run the import" a cheap recovery.
  # ---------------------------------------------------------------------------------------------

  EXPORT_PATH = "tmp/forgejo-export.json"

  # PAGINATED AT 50, NOT 200. Forgejo CLAMPS `limit` to 50 and returns a full-looking page —
  # measured: limit=200 answered with exactly 50 of 186 and nothing indicating it had truncated. A
  # loop that trusts one page exports 27% of the record and reports success.
  def export(path = EXPORT_PATH)
    issues = []
    page = 1
    loop do
      batch = forgejo(:get, "/issues?state=all&type=issues&limit=50&page=#{page}")
      break if batch.nil? || batch.empty?

      issues.concat(batch)
      page += 1
    end
    issues.uniq! { |i| i["number"] }

    # COMMENTS ONLY WHERE THE ISSUE SAYS IT HAS SOME. `comments` is a COUNT on the issue object, so
    # this costs 21 round trips rather than 186.
    wanted = issues.count { |i| i["comments"].to_i.positive? }
    warn "fetching comments for #{wanted} issues that report having any"
    issues.each do |issue|
      issue["_comments"] = issue["comments"].to_i.zero? ? [] : forgejo(:get, "/issues/#{issue['number']}/comments")
    end

    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, JSON.pretty_generate(issues))
    warn "wrote #{path}: #{issues.size} issues, #{issues.sum { |i| i['_comments'].size }} comments"
    issues
  end

  # X-Total-Count IS A HEADER, so it cannot come through `request`, which returns parsed JSON and
  # throws the response away. A raw call is the honest way to read it rather than bending the shared
  # helper into returning two different things.
  def forgejo_issue_count
    uri = URI.parse(FORGEJO_URL)
    Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https") do |http|
      req = Net::HTTP::Get.new("/api/v1/repos/#{FORGEJO_OWNER}/#{FORGEJO_REPO}/issues?state=all&type=issues&limit=1")
      req["Authorization"] = "token #{forgejo_token}"
      http.request(req)["x-total-count"].to_i
    end
  end

  # VERIFIES AGAINST THE SERVER, NOT AGAINST THE FILE'S OWN CONTENTS. "The file holds 186 entries" is
  # a claim the file makes about itself and cannot fail; "the server says 186 and the file has those
  # same 186 numbers" is a fact. §15: a guard that cannot fail has not been shown to work.
  def verify_export(path = EXPORT_PATH)
    issues = JSON.parse(File.read(path, encoding: Encoding::UTF_8))
    numbers = issues.map { |i| i["number"] }.sort
    live = forgejo_issue_count

    problems = []
    problems << "count: file has #{issues.size}, server reports #{live}" unless issues.size == live
    problems << "duplicate issue numbers in the file" unless numbers.uniq.size == numbers.size
    blank = issues.select { |i| i["title"].to_s.strip.empty? }
    problems << "#{blank.size} issues with an empty title" if blank.any?
    # A COMMENT COUNT THAT DISAGREES WITH ITS OWN ISSUE means a fetch silently returned short, and
    # corrections are the one thing in this record with no other copy.
    short = issues.select { |i| i["_comments"].to_a.size != i["comments"].to_i }
    problems << "#{short.size} issues whose fetched comments != their reported count" if short.any?

    raise Failed, problems.join("; ") if problems.any?

    warn "export verified against the server: #{issues.size} issues, numbers #{numbers.first}-#{numbers.last}, " \
         "gaps #{((numbers.first..numbers.last).to_a - numbers).inspect}, " \
         "#{issues.sum { |i| i['_comments'].size }} comments"
    issues
  end

  # ---------------------------------------------------------------------------------------------
  # IMPORT. Everything below writes to the real project and is redoable from the export: the
  # recovery for any failure is "delete the project, re-run from Task 7", which is why the export
  # comes first and why nothing here tries to resume a half-finished run.
  # ---------------------------------------------------------------------------------------------

  IDS_PATH = "tmp/kaneo-ids.json"

  LABELS = %w[arc open-work deploy blocked deliberate
              filelayer library-scan addons previews maker-web ci].freeze

  # ONE PROJECT, AND THAT IS FORCED RATHER THAN CHOSEN. Kaneo's task counter is PER PROJECT
  # (measured: it starts at 1, increments by one, and does not reuse a deleted number), so splitting
  # arcs / open-work / deploys into three projects would shatter tinkerex#N into three sequences and
  # break all 129 citations in the tree. The slug is what bin/log will resolve by.
  def create_project(slug: "tinkerex")
    project = kaneo(:post, "/project", { name: "tinkerex", workspaceId: workspace_id,
                                         icon: "Wrench", slug: slug })
    warn "project #{project['slug']} id=#{project['id']}"
    project
  end

  # THE VOCABULARY IS A LABEL ROW WITH A NULL taskId. Kaneo keeps label DEFINITIONS and label
  # ATTACHMENTS in the same table: POST /label with a taskId stores an attached row, without one
  # stores a free row, and GET /label/workspace/:id returns BOTH. So the index has to filter
  # taskId.nil? — unfiltered, 135 attached `arc` rows would read as "the vocabulary is complete"
  # even after someone deleted the definition.
  def vocabulary = kaneo(:get, "/label/workspace/#{workspace_id}").select { |l| l["taskId"].nil? }

  def create_labels
    already = vocabulary.map { |l| l["name"] }
    (LABELS - already).each { |name| kaneo(:post, "/label", { name: name, color: "#666666", workspaceId: workspace_id }) }

    missing = LABELS - vocabulary.map { |l| l["name"] }
    raise Failed, "labels missing after setup: #{missing.join(', ')}" if missing.any?

    warn "vocabulary: #{LABELS.size} labels present (#{(LABELS - already).size} created)"
  end

  # THE PLACEHOLDERS ARE THE WHOLE TRICK. Forgejo numbers 6-193 with holes at 116 and 117; Kaneo
  # counts from 1. Creating a throwaway task for each number the record does not use lands every real
  # issue on its own number, so all 129 tinkerex#N citations in the tree and the 50 inside issue
  # bodies keep resolving with no rewrite at all.
  #
  # PLACEHOLDERS ARE NEVER DELETED. The counter probe measured that a deleted number is NOT reused,
  # so deleting them would leave a hole rather than a shift — but it would also turn a visible,
  # explained gap into an invisible one, and the next reader who "tidies up" a junk task has no way
  # to know that was ever load-bearing. A hole you can see is safer than one you cannot.
  #
  # STRICTLY SEQUENTIAL, NEVER CONCURRENT. The counter is atomic but the ORDER of concurrent creates
  # is not, and this loop's entire correctness is "the Nth create gets number N".
  def import(project_id, path = EXPORT_PATH)
    issues = JSON.parse(File.read(path, encoding: Encoding::UTF_8)).sort_by { |i| i["number"] }
    by_number = issues.to_h { |i| [ i["number"], i ] }
    last = issues.last["number"]
    created = {}

    (1..last).each do |n|
      issue = by_number[n]
      payload = if issue
        { title: issue["title"], description: issue["body"].to_s, priority: "no-priority",
          status: issue["state"] == "closed" ? CLOSED_STATUS : OPEN_STATUS }
      else
        { title: "(reserved ##{n})", priority: "no-priority", status: CLOSED_STATUS,
          description: "Placeholder. Forgejo had no issue ##{n}; this task exists so every later " \
                       "issue keeps its original number. Do not delete." }
      end

      task = kaneo(:post, "/task/#{project_id}", payload)

      # FAIL AT THE FIRST DRIFT, NOT AT THE END. If number N did not come back as N, every task after
      # it is wrong too — carrying on would produce 193 wrong rows and one confusing report. Stopping
      # here costs a delete-and-retry, which the export makes cheap.
      got = task["number"]
      raise Failed, "drift at #{n}: Kaneo assigned #{got.inspect} (delete the project and re-run)" unless got == n

      created[n] = task["id"]
      warn "  #{n}/#{last}" if (n % 25).zero?
    end

    FileUtils.mkdir_p(File.dirname(IDS_PATH))
    File.write(IDS_PATH, JSON.pretty_generate(created))
    warn "imported #{created.size} tasks (#{issues.size} real, #{created.size - issues.size} placeholders)"
    created
  end

  # LABELS ARE A SEPARATE PASS, not folded into the import loop. The import's correctness is that the
  # Nth create gets number N; interleaving a second kind of write into that loop adds a failure mode
  # in the middle of the one sequence that must not be interrupted. Every issue in this record
  # carries exactly one label (measured: 0 issues with more than one), but the loop does not assume it.
  def attach_labels(path = EXPORT_PATH, ids = IDS_PATH)
    issues = JSON.parse(File.read(path, encoding: Encoding::UTF_8))
    created = JSON.parse(File.read(ids, encoding: Encoding::UTF_8))
    failures = []
    count = 0

    issues.each do |issue|
      task_id = created.fetch(issue["number"].to_s)
      issue["labels"].each do |label|
        kaneo(:post, "/label", { name: label["name"], color: "#666666",
                                 workspaceId: workspace_id, taskId: task_id })
        count += 1
      rescue Failed => e
        failures << "##{issue['number']} #{label['name']}: #{e.message[0, 120]}"
      end
    end

    failures.each { |f| warn "!! #{f}" }
    raise Failed, "#{failures.size} label attachments failed" if failures.any?

    warn "attached #{count} labels across #{issues.size} tasks"
  end

  # READ-BACK VERIFICATION, NOT A REPORT ON WHAT WE SENT. The import already checked each number as it
  # went; this asks the server, independently, what it now holds. The two can disagree — a task
  # altered afterwards, a partial run resumed by hand — and only this would notice.
  def verify_import(project_id, path = EXPORT_PATH)
    issues = JSON.parse(File.read(path, encoding: Encoding::UTF_8))
    by_number = all_tasks(project_id).to_h { |t| [ t["number"], t ] }

    problems = []
    issues.each do |issue|
      task = by_number[issue["number"]]
      next problems << "##{issue['number']} missing from Kaneo" if task.nil?

      problems << "##{issue['number']} title differs" unless task["title"] == issue["title"]
      want = issue["state"] == "closed" ? CLOSED_STATUS : OPEN_STATUS
      problems << "##{issue['number']} status #{task['status'].inspect} != #{want.inspect}" unless task["status"] == want
    end

    if problems.any?
      problems.first(20).each { |p| warn "!! #{p}" }
      raise Failed, "#{problems.size} problems"
    end

    warn "verified #{issues.size} issues present at their original numbers, with matching titles and states"
  end

  # COMMENTS LAST, because they need the task ids the import produced. A correction is a comment and
  # never an edit (bin/log's own rule), so the record's corrections only survive if this runs.
  def import_comments(path = EXPORT_PATH, ids = IDS_PATH)
    issues = JSON.parse(File.read(path, encoding: Encoding::UTF_8))
    created = JSON.parse(File.read(ids, encoding: Encoding::UTF_8))
    count = 0

    issues.each do |issue|
      issue["_comments"].to_a.each do |comment|
        kaneo(:post, "/comment/#{created.fetch(issue['number'].to_s)}", { content: comment["body"].to_s })
        count += 1
      end
    end
    warn "imported #{count} comments"
    count
  end

  # ---------------------------------------------------------------------------------------------
  # PROBES. These write nothing that survives: each makes a throwaway project, and the whole point
  # is to measure the server rather than reason about it. bin/log carries a shipped bug where a wire
  # format was ASSERTED and the stub agreed with the assertion — §14e's FakeS3 rule guards the code
  # and the fake sharing a misunderstanding of EACH OTHER, not both misunderstanding the SERVER.
  # ---------------------------------------------------------------------------------------------

  def throwaway_project(name, stamp)
    kaneo(:post, "/project", { name: name, workspaceId: workspace_id,
                               icon: "Beaker", slug: "#{name.tr(' ', '-')}-#{stamp}" })
  end

  # THE ASSUMPTION UNDER THE WHOLE MIGRATION, MEASURED RATHER THAN ARGUED. Creates a throwaway
  # project, makes three tasks, deletes the middle one, makes a fourth. The number-preserving import
  # is only safe if this reports 1, 2, 3 and then 4: a reused number means a placeholder could be
  # silently consumed and every issue after it shifted by one, which would break all 129 tinkerex#N
  # citations in the tree while looking like it worked.
  def probe_counter(stamp)
    project = throwaway_project("counter probe", stamp)
    pid = project.fetch("id")
    warn "probe project: #{project['slug']} (#{pid})"

    made = (1..3).map do |i|
      t = kaneo(:post, "/task/#{pid}", { title: "probe #{i}", description: "",
                                         priority: "no-priority", status: OPEN_STATUS })
      warn "  created #{t['title']}: number=#{t['number'].inspect} id=#{t['id']}"
      t
    end

    kaneo(:delete, "/task/#{made[1].fetch('id')}")
    warn "  deleted the second task (number #{made[1]['number'].inspect})"

    fourth = kaneo(:post, "/task/#{pid}", { title: "probe 4", description: "",
                                            priority: "no-priority", status: OPEN_STATUS })
    warn "  created #{fourth['title']}: number=#{fourth['number'].inspect} id=#{fourth['id']}"

    numbers = made.map { |t| t["number"] }
    pass = numbers == [ 1, 2, 3 ] && fourth["number"] == 4
    warn ""
    warn "VERDICT: first three #{numbers.inspect}, fourth #{fourth['number'].inspect} -> #{pass ? 'PASS' : 'FAIL'}"
    warn pass ? "The number-preserving import is viable." : "STOP. Do not import; fall back to renumbering."
    { pass: pass, project_id: pid, numbers: numbers, fourth: fourth["number"] }
  end

  # SIX CONTRACTS, OBSERVED. Each block below is the evidence a Phase D implementation is written
  # against. The list endpoint matters most: its OpenAPI response type is a bare {"type":"object"}
  # with no properties, so its envelope is genuinely unknown until seen.
  def probe_verbs(stamp)
    project = throwaway_project("verb probe", stamp)
    pid = project.fetch("id")
    ws = workspace_id
    warn "probe project: #{project['slug']} (#{pid})"

    show = ->(label, value) { warn "\n== #{label}\n#{JSON.pretty_generate(value)}" }

    show.call("columns — what `status` strings does a fresh project have?", kaneo(:get, "/column/#{pid}"))

    task = kaneo(:post, "/task/#{pid}", { title: "verb probe", description: "body text",
                                          priority: "no-priority", status: OPEN_STATUS })
    tid = task.fetch("id")
    show.call("create task", task)
    show.call("LIST TASKS — the untyped one. What is the envelope?",
              kaneo(:get, "/task/tasks/#{pid}?limit=200"))
    show.call("label create with taskId — does it attach in one call?",
              kaneo(:post, "/label", { name: "arc", color: "#666666", workspaceId: ws, taskId: tid }))
    show.call("labels on the task", kaneo(:get, "/label/task/#{tid}"))
    show.call("labels in the workspace — reusable, or one row per task?",
              kaneo(:get, "/label/workspace/#{ws}"))
    show.call("comment", kaneo(:post, "/comment/#{tid}", { content: "a correction" }))
    show.call("status change (this is what `close` will do)",
              kaneo(:put, "/task/status/#{tid}", { status: CLOSED_STATUS }))
    show.call("search", kaneo(:get, "/search?q=verb+probe&projectId=#{pid}"))

    pid
  end

  # THE STATUS VOCABULARY IS KEBAB-CASE AND FIXED PER PROJECT, measured 2026-08-31: a POST carrying
  # "To Do" is refused with a 400 naming the whole set. So a fresh Kaneo project ships six columns,
  # not the two this migration needs — the record maps onto `to-do` and `done` and leaves the other
  # four unused rather than inventing columns Kaneo would not accept.
  OPEN_STATUS   = "to-do"
  CLOSED_STATUS = "done"
  STATUSES = %w[to-do in-progress in-review done planned archived].freeze

  # ONE WALK OF THE BOARD, SHARED BY EVERY READER HERE. GET /task/tasks/:projectId returns a BOARD,
  # not a list: tasks sit in `data.columns[].tasks`, with `archivedTasks` and `plannedTasks` as two
  # off-board buckets beside them. Its OpenAPI response type is a bare {"type":"object"} with no
  # properties, so this shape was observed, never read.
  #
  # THE PAGE SIZE IS CAPPED AT 100 HOWEVER LARGE A `limit` YOU ASK FOR — measured: limit=200 answered
  # pageSize=100. With 193 tasks a single un-paginated call sees roughly half and reports no error,
  # which is the same well-formed lie Forgejo's 50-cap tells the export.
  def all_tasks(project_id)
    tasks = []
    page = 1
    loop do
      body = kaneo(:get, "/task/tasks/#{project_id}?page=#{page}&limit=100")
      data = body.fetch("data", {})
      tasks.concat(data.fetch("columns", []).flat_map { |c| c["tasks"] || [] })
      tasks.concat(data["archivedTasks"] || [])
      tasks.concat(data["plannedTasks"] || [])
      break if page >= body.dig("pagination", "totalPages").to_i

      page += 1
    end
    tasks
  end

  def delete_project(project_id) = kaneo(:delete, "/project/#{project_id}")
end
