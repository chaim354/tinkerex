#!/usr/bin/env ruby
# frozen_string_literal: true

# Verify every secret a destination needs resolves to a NON-EMPTY value, before kamal runs.
#
#   bin/secrets-preflight            # base (chunk, Unraid)
#   bin/secrets-preflight s3         # -d s3
#   bin/secrets-preflight share      # -d share
#   bin/secrets-preflight ovh        # -d ovh
#   bin/secrets-preflight --all      # every destination
#
# WHY THIS EXISTS AT ALL — KAMAL CANNOT NOTICE AN UNREADABLE SECRET.
# Kamal expands `$(…)` in .kamal/secrets* through Ruby BACKTICKS
# (Kamal::Secrets::Dotenv::InlineCommandSubstitution), and backticks discard exit status. So a
# locked vault makes `bin/secret` exit 1, the substitution yields "", and `Kamal::Secrets#[]`
# hands that "" straight to the deploy WITHOUT RAISING — verified against kamal 2.12.0, where a
# deliberately-failing substitution parsed to {"EMPTY" => ""} and `#[]` returned "" rather than
# the KeyError a MISSING key would get. (`key?` says false while `[]` says "": the two disagree,
# and kamal reads `[]`.) An empty KAMAL_REGISTRY_PASSWORD then reaches `docker login`, which is
# how a hard failure once got reported as exit 0 in this repo. Missing is loud; EMPTY is silent,
# and empty is exactly what a locked vault produces.
#
# NO SECOND LIST OF SECRET NAMES — BUT THE LIST OF PLACES KAMAL LOOKS IS HAND-MAINTAINED HERE, AND
# CLAIMING OTHERWISE IS HOW IT DRIFTED. This block used to say the keys come from "env.secret +
# registry.password … so this cannot drift from what kamal itself will do". The parenthetical was
# honest and the claim was not: kamal 2.12.0 resolves a secret at NINE sites and those were two of
# them. IT IS ALSO LIVE NOW, not merely latent as this block used to say ("all four destinations
# collect the same three keys either way"). The `sync` accessory's env.secret is one of the seven
# sites the old version missed, so it would report base as needing 3 keys where the merged config
# needs 4, and ovh/s3/share as needing 2-3 where they need 4-5 — SECRET_KEY_BASE unchecked on every
# destination and SYNC_ADMIN_TOKEN unchecked on three of the four. Measured against the merged
# config, not reasoned. Stage deploy.yml's own commented-out `builder: secrets:` block and give the
# `addons` accessory an `env.secret` and it gets worse: the old version printed "All secrets
# resolved … Safe to deploy." on every destination while GITHUB_TOKEN and ADDONS_PULL_TOKEN went
# unchecked.
# Only the NAMES are gathered below; every one is still resolved through the real Kamal::Secrets.
#
# Values are never printed — only names, byte lengths, and pass/fail.

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "kamal"

# `remote` WAS A FIFTH ENTRY and is gone: Arc D Part 2 folded that destination into the base,
# which now carries LIBRARY_BACKEND=chunk_remote itself. Four again -- base, s3, share, ovh.
DESTINATIONS = [ nil, "s3", "share", "ovh" ].freeze
SECRETS_PATH = ".kamal/secrets"
CONFIG_FILE  = Pathname.new("config/deploy.yml")

def label(destination) = destination || "base"

# env.secret is an ARRAY that kamal REPLACES wholesale on merge (deep_merge unions hashes but
# replaces arrays), which is why each overlay re-declares RAILS_MASTER_KEY. Reading the MERGED
# config means this reflects that replacement rather than a union we invented.
def required_keys(destination)
  config = Kamal::Configuration.create_from(config_file: CONFIG_FILE, destination: destination)
  keys = secret_key_names(config.raw_config)
  raise "no secret keys resolved for #{label(destination)} — raw_config shape changed?" if keys.empty?

  keys
end

# STRING keys throughout — raw_config is an ActiveSupport::InheritableOptions, so `dig(:env,
# :secret)` returns nil while `dig("env", "secret")` returns the list (the nesting below it is
# plain string-keyed Hashes). A symbol-keyed version of this reports "0 secrets, all fine" for
# every destination, which is the one wrong answer a preflight must never give.
#
# Reads the config only — no secret is resolved here. Verified by fencing Dotenv.parse and
# Kamal::Secrets#[]/#key?/#to_h to raise and building all four destinations: the fence never trips.
def at(node, *path)
  path.reduce(node) { |value, key| value.is_a?(Hash) ? value[key] : nil }
end

# EVERY PLACE KAMAL 2.12.0 RESOLVES A SECRET, each arm named for the file it mirrors. Add an arm
# when kamal grows a site — nothing else in this repo will notice that it has. Every traversal
# tolerates the member being absent, because a destination need not declare a role, an accessory,
# a proxy or a builder at all.
#
# THIS WALK HAS A TWIN in test/deploy_hygiene_test.rb — that file's guards must stay STATIC and
# vault-free (they run under bin/ci on a bare runner), so they cannot execute this script, whose
# whole job is to hit the vault. Its "secret_key_names covers every site kamal reads a secret
# from" plants a name at every arm below and is the mutation-checked half. WIDEN BOTH TOGETHER.
def secret_key_names(raw)
  roles       = at(raw, "servers").is_a?(Hash)     ? at(raw, "servers").values     : []
  accessories = at(raw, "accessories").is_a?(Hash) ? at(raw, "accessories").values : []

  # env.secret — root (env.rb:35), per env tag (configuration.rb:286), per role (role.rb:20),
  # per accessory (accessory.rb:126). An entry may be `VAR:SECRET`, and kamal looks up the part
  # AFTER the colon (Env#extract_alias) — the first half names the container's env var, not a key.
  envs = [ at(raw, "env"), *at(raw, "env", "tags").to_h.values,
           *roles.map { |role| at(role, "env") }, *accessories.map { |acc| at(acc, "env") } ]
  keys = envs.flat_map { |env| Array(at(env, "secret")) }.map { |key| key.to_s.split(":", 2).last }

  # registry password AND username — root (registry.rb:35) and per accessory (accessory.rb:141).
  # ONLY the Array form is a secret reference (Registry#lookup); a bare String is the literal
  # value, which `username: chaim354` in deploy.yml is. Collecting that would report a MISSING
  # secret named "chaim354" and block every deploy — over-collection fails LOUD but it fails.
  registries = [ at(raw, "registry"), *accessories.map { |acc| at(acc, "registry") } ]
  keys += registries.flat_map { |reg| [ at(reg, "password"), at(reg, "username") ] }
                    .grep(Array).map(&:first)

  # Custom proxy TLS material — root and per role (proxy.rb:41,47), per accessory
  # (accessory.rb:135). A role's `proxy:` specialization can be `true`/`false` rather than a hash.
  proxies = [ at(raw, "proxy"), *roles.map { |role| at(role, "proxy") },
              *accessories.map { |acc| at(acc, "proxy") } ]
  keys += proxies.flat_map { |p| [ at(p, "ssl", "certificate_pem"), at(p, "ssl", "private_key_pem") ] }

  # builder.secrets (builder.rb:73) — read the raw key LIST. Never call `config.builder.secrets`,
  # which eagerly resolves each one through `config.secrets[key]`: that moves the vault hit into
  # collection, where a failure has nothing to report it against.
  keys += Array(at(raw, "builder", "secrets"))

  # ssh.key_data (ssh.rb:43-44). Kamal falls back to treating an entry as an INLINE literal key
  # when the secrets do not define it, so a deploy still using that deprecated spelling is
  # reported MISSING here. Deliberate: loud beats an empty key reaching an ssh handshake, and
  # kamal 3 removes the inline form outright.
  keys += Array(at(raw, "ssh", "key_data"))

  keys.compact.uniq
end

def check(destination)
  puts "\n#{label(destination)}"
  puts "  config      config/deploy.yml#{" + config/deploy.#{destination}.yml" if destination}"

  begin
    keys = required_keys(destination)
  rescue Kamal::ConfigurationError => e
    puts "  CONFIG ERROR  #{e.message}"
    return false
  end

  secrets = Kamal::Secrets.new(destination: destination, secrets_path: SECRETS_PATH)
  files = secrets.secrets_files
  puts "  secrets     #{files.empty? ? "(none found)" : files.join(", ")}"

  ok = true
  keys.each do |key|
    value =
      begin
        secrets[key]
      rescue Kamal::ConfigurationError
        nil
      end

    if value.nil?
      puts "  MISSING     #{key} — declared in the deploy config, defined in no secrets file"
      ok = false
    elsif value.empty?
      puts "  EMPTY       #{key} — resolved to nothing (locked vault? wrong field name?)"
      ok = false
    else
      puts "  ok          #{key} (#{value.bytesize} bytes)"
    end
  end
  ok
end

# Which 1Password auth path is in play. An unattended run that never set the token is the most
# common reason a preflight passes on a laptop and fails on a runner, so say it up front.
if ENV["OP_SERVICE_ACCOUNT_TOKEN"].to_s.empty?
  puts "1Password: desktop-app integration (OP_SERVICE_ACCOUNT_TOKEN not set)."
  puts "           Unattended runs need that token — see docs/DEPLOY.md."
else
  puts "1Password: service account (OP_SERVICE_ACCOUNT_TOKEN is set)."
end

requested = ARGV.include?("--all") ? DESTINATIONS : [ ARGV.first ]
unknown = requested.reject { |d| DESTINATIONS.include?(d) }
unless unknown.empty?
  abort "\nUnknown destination(s): #{unknown.join(", ")}. Known: base (omit), s3, share, ovh."
end

results = requested.to_h { |destination| [ label(destination), check(destination) ] }

failed = results.reject { |_, ok| ok }.keys
if failed.empty?
  puts "\nAll secrets resolved for: #{results.keys.join(", ")}. Safe to deploy."
else
  puts "\nFAILED: #{failed.join(", ")}"
  puts "Fix the above before deploying — kamal would otherwise deploy an EMPTY credential"
  puts "and fail somewhere less obvious (an empty registry password surfaces at docker login)."
  exit 1
end
