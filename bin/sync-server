#!/usr/bin/env bash
# BOOT A STANDALONE tinkerex-sync HOST, for local chunk_remote work and for sync-contract.yml.
#
# WHY A SIBLING CHECKOUT RATHER THAN THE INSTALLED GEM. The gem currently ships host/, so
# `bundle show tinkerex-sync`/host would work today -- and stops working the moment Stage 5 Arc D
# removes the gem, which is the whole direction of travel. A sibling checkout is the durable
# answer and matches the ../tinkerex-client convention this repo already uses
# (scripts/r2-cutover/smoke.sh, .github/workflows/client-contract.yml).
#
# TWO SUBCOMMANDS, because CI has to background the boot and still know the token:
#   prepare  migrate the host DB, mint a device token AND a fresh SYNC_ADMIN_TOKEN (Arc C's
#            admin-provisioning credential, distinct from the device token -- see the `prepare`
#            case's own comment), write both into tmp/sync-server.env, print it
#   start    run the server in the FOREGROUND on $SYNC_PORT (the caller backgrounds it)
#
# THE HOST DOES HAVE /up (tinkerex-sync host/config/routes.rb), added after this plan was
# drafted -- and it is not a static 200: it runs User.count and answers 503 on an empty schema,
# because that host's first real deploy reported healthy with no tables. A caller waiting on this
# server should probe BOTH /up and an authenticated GET /v1/devices/whoami, because they answer
# different questions -- /up says "there is a schema and I can reach it," whoami says "and the
# credential I just minted is accepted." A bare port check says neither. THIS SCRIPT IMPLEMENTS
# NEITHER PROBE -- prepare and start do not curl anything. This paragraph is guidance for the
# CALLER (CI, and a human), which is exactly why it has to stay true.
set -euo pipefail

PORT="${SYNC_PORT:-3002}"
EMAIL="${SYNC_EMAIL:-maker@example.com}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
SYNC_DIR="${TINKEREX_SYNC_DIR:-$REPO_ROOT/../tinkerex-sync}"
HOST_DIR="$SYNC_DIR/host"
# WHICH IMPLEMENTATION OF THE SYNC SERVER (tinkerex-sync's own plan,
# docs/superpowers/plans/2026-09-30-rust-rewrite.md §8.1): `ruby` boots host/ under bin/rails as
# this script always has; `rust` builds and boots the crates/tinkerex-sync binary from the same
# checkout. Default `ruby` until the cutover flips it; the switch goes away with the Ruby host.
# The Rust arm keeps its OWN database and chunk directory under tmp/ rather than the host's
# development.sqlite3, so switching implementations never hands one a file the other wrote.
IMPL="${SYNC_IMPL:-ruby}"
RUST_BIN="${TINKEREX_SYNC_BIN:-$SYNC_DIR/target/release/tinkerex-sync}"
RUST_DB="$REPO_ROOT/tmp/sync-server-rust.sqlite3"
RUST_CHUNKS="$REPO_ROOT/tmp/sync-server-rust-chunks"
# A FIXED DEV SECRET, deliberately: SECRET_KEY_BASE only signs this ephemeral server's own local
# blob URLs (an HMAC the client never needs to know), exactly as the Ruby arm's Rails development
# secret is fixed per checkout. It guards nothing a real deployment guards.
RUST_SECRET_KEY_BASE="sync-server-local-development-secret"
# Overridable so the hermetic happy-path test in test/bin_sync_server_test.rb can point this at
# an isolated tmpdir path instead of the real repo file. A save-and-restore of the real file was
# tried first and rejected: Ruby's `ensure` runs on a normal return or on SIGINT, but NOT on
# SIGKILL, and this suite runs on a PERSISTENT self-hosted macOS box, not a throwaway CI VM -- a
# test run killed at the wrong moment would leave tmp/sync-server.env corrupted for every run
# after it, not just that one. The default below is unchanged, so an unset var changes nothing.
ENV_FILE="${SYNC_SERVER_ENV_FILE:-$REPO_ROOT/tmp/sync-server.env}"

usage() {
  echo "usage: [SYNC_IMPL=ruby|rust] bin/sync-server {prepare|start}" >&2
  echo "  prepare  migrate the sync host DB, mint a device token, write tmp/sync-server.env" >&2
  echo "  start    boot the sync host in the foreground on \$SYNC_PORT (default $PORT)" >&2
  echo "  SYNC_IMPL=rust builds and boots tinkerex-sync's Rust binary instead of host/ (default ruby)" >&2
}

require_checkout() {
  case "$IMPL" in
    ruby|rust) ;;
    *)
      echo "SYNC_IMPL must be ruby or rust, not '$IMPL'" >&2
      exit 64
      ;;
  esac
  if [ ! -d "$HOST_DIR" ]; then
    echo "tinkerex-sync host app not found at $HOST_DIR" >&2
    echo "" >&2
    echo "The sync engine lives in chaim354/tinkerex-sync. Clone it as a sibling:" >&2
    echo "    gh repo clone chaim354/tinkerex-sync $SYNC_DIR" >&2
    echo "or point this script at an existing checkout:" >&2
    echo "    TINKEREX_SYNC_DIR=/path/to/tinkerex-sync $0 ${1:-prepare}" >&2
    exit 1
  fi
}

# UNPINS THE SYNC HOST FROM WHATEVER BUNDLE INVOKED THIS SCRIPT -- found by diagnosis, not
# theory, while proving Arc C's provisioning route end to end: `bin/ci` (config/boot.rb) sets
# BUNDLE_GEMFILE to THIS repo's own Gemfile and injects a RUBYOPT that force-requires
# bundler/setup into every child process it spawns. `tinkerex-sync/host/config/boot.rb` -- the
# ordinary Rails-generated one -- does `ENV["BUNDLE_GEMFILE"] ||= ...`, and that `||=` means an
# INHERITED value wins: the sync host silently boots against MAKER's Gemfile.lock instead of its
# own. Reproduced directly: exporting exactly these three vars (BUNDLE_GEMFILE, RUBYOPT, RUBYLIB)
# and nothing else turned a working `POST /v1/admin/libraries` into a bare 404
# (ActionController::RoutingError) on an otherwise-identical boot -- /up and /v1/devices/whoami
# kept answering fine, because that much of Rails/ActionController is close enough between the
# two repos' locked versions to boot either way; the two apps' Gemfile.locks had simply diverged
# enough, by the time this route existed, for ROUTE DRAWING specifically to differ. This would
# bite ANY two-Rails-app caller shape, not just this one -- `bin/ci test-chunk-remote` is simply
# the first thing that made it visible, because it is the first caller that both goes through a
# bundled Ruby process (bin/ci itself) AND exercises a route added after the two repos' locked
# gems drifted apart.
#
# THE FULL LIST BUNDLER OWNS IS LONGER (bundler/environment_preserver.rb, EnvironmentPreserver
# ::BUNDLER_KEYS: also PATH, GEM_HOME, GEM_PATH, MANPATH, RB_USER_INSTALL) -- deliberately NOT
# unset here. Those are how the shell finds `ruby`/`bundle`/`bin/rails` AT ALL; clearing them
# would trade a silently-wrong bundle for a script that cannot run. The seven unset below are
# exactly the ones that PIN a Ruby process to one specific Gemfile rather than letting it resolve
# its own -- unsetting them makes the sync host's own `config/boot.rb` (which only ever sets
# BUNDLE_GEMFILE with `||=`) free to choose correctly.
unset_inherited_bundler_env() {
  unset BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_LOCKFILE BUNDLER_VERSION BUNDLER_SETUP RUBYOPT RUBYLIB
}

# THE RUST ARM'S BUILD: `cargo build --release` in the sibling checkout, unless TINKEREX_SYNC_BIN
# names a binary already built (CI's cache, or a downloaded release). A missing cargo fails
# loudly and names the fix, the same shape require_checkout uses for a missing clone.
build_rust_binary() {
  if [ -n "${TINKEREX_SYNC_BIN:-}" ]; then
    [ -x "$RUST_BIN" ] || { echo "TINKEREX_SYNC_BIN=$RUST_BIN is not an executable" >&2; exit 1; }
    return
  fi
  command -v cargo >/dev/null 2>&1 || {
    echo "SYNC_IMPL=rust needs cargo on PATH to build tinkerex-sync (rustup.rs), or" >&2
    echo "TINKEREX_SYNC_BIN=/path/to/tinkerex-sync pointing at a built binary" >&2
    exit 1
  }
  ( cd "$SYNC_DIR" && cargo build --release --quiet -p tinkerex-sync )
}

# The env every Rust-arm invocation shares: prepare's migrate + device issue, and start's serve.
rust_env() {
  env STORAGE_BACKEND=local \
      SQLITE_DATABASE="$RUST_DB" \
      CHUNK_LOCAL_DIR="$RUST_CHUNKS" \
      SECRET_KEY_BASE="$RUST_SECRET_KEY_BASE" \
      "$RUST_BIN" "$@"
}

case "${1:-}" in
  prepare)
    require_checkout prepare
    mkdir -p "$REPO_ROOT/tmp"
    if [ "$IMPL" = rust ]; then
      build_rust_binary
      rust_env migrate >/dev/null
      # The SAME lines the rake task prints (user_id:/device_id:/device_token:), so the awk
      # below is shared -- the binary's `device issue` was written to be parsed by this script.
      token="$(rust_env device issue --email "$EMAIL" | awk '/^device_token:/ { print $2 }')"
    else
    ( cd "$HOST_DIR" && unset_inherited_bundler_env && bundle install --quiet && bin/rails db:prepare )
    # The token is printed ONCE by the task (only a SHA256 digest is stored), so capture it here.
    #
    # THIS DEVICE TOKEN IS A LOCAL/CI ARTIFACT, NOT A DEPLOYMENT CREDENTIAL. It exists so
    # config/ci.rb's readiness probe can prove sync:device:issue actually minted something this
    # ephemeral server accepts (GET /v1/devices/whoami) -- a narrower question than "can a real
    # deployment run." A real chunk_remote deployment's boot guard
    # (lib/library_backend_check.rb's CHUNK_REMOTE_REQUIRED) does NOT require this any more: Arc C
    # moved ordinary traffic to per-user `users.sync_device_token`, provisioned lazily via
    # SYNC_ADMIN_TOKEN below, and the guard now names that instead -- see CHUNK_REMOTE_REQUIRED's
    # own comment for the full history. Keep minting it here anyway: it is still the one thing that
    # proves this specific `sync:device:issue` invocation works end to end.
    token="$(cd "$HOST_DIR" && unset_inherited_bundler_env && EMAIL="$EMAIL" bin/rails sync:device:issue \
             | awk '/^device_token:/ { print $2 }')"
    fi
    if [ -z "$token" ]; then
      echo "sync:device:issue printed no device_token -- refusing to write a blank credential" >&2
      exit 1
    fi

    # SYNC_ADMIN_TOKEN (Arc C): a shared secret BOTH sides of the admin door need to agree on --
    # the sync server's own authenticate_admin! compares an inbound bearer against
    # ENV["SYNC_ADMIN_TOKEN"] on ITS side, and FileLayer::ChunkRemote::Provisioning sends one from
    # ENV["SYNC_ADMIN_TOKEN"] on THIS app's side. Unlike CHUNK_REMOTE_TOKEN above, no sync-host rake
    # task mints this one -- admin/libraries_controller.rb just string-compares against ENV, nothing
    # issues or digests it -- so `prepare` generates the shared value itself, once per boot cycle,
    # the same way a real deployment would generate one and put it in both apps' Kamal secrets
    # (not this script's concern -- see docs/DEPLOY.md for that story once it exists).
    admin_token="$(openssl rand -hex 32)"
    if [ -z "$admin_token" ]; then
      echo "openssl rand produced no output -- refusing to write a blank admin credential" >&2
      exit 1
    fi
    {
      echo "CHUNK_REMOTE_URL=http://127.0.0.1:$PORT"
      echo "CHUNK_REMOTE_TOKEN=$token"
      echo "SYNC_ADMIN_TOKEN=$admin_token"
    } > "$ENV_FILE"
    # Tokens live only on the box, chmod 600, never in git -- same rule, same words, as
    # ping.env in bin/backup-cron-install: this file holds a live device credential too.
    chmod 600 "$ENV_FILE"
    cat "$ENV_FILE"
    ;;
  start)
    require_checkout start
    if [ "$IMPL" = rust ]; then
      # SYNC_ADMIN_TOKEN reaches the binary by the same env inheritance the Ruby arm relies on
      # (see below); the binary reads a blank one as "admin door answers 503", never a refusal.
      build_rust_binary
      exec env STORAGE_BACKEND=local \
               SQLITE_DATABASE="$RUST_DB" \
               CHUNK_LOCAL_DIR="$RUST_CHUNKS" \
               SECRET_KEY_BASE="$RUST_SECRET_KEY_BASE" \
               "$RUST_BIN" serve --bind 127.0.0.1 --port "$PORT"
    fi
    cd "$HOST_DIR"
    # SYNC_ADMIN_TOKEN REACHES THIS SERVER PROCESS BY ORDINARY ENV INHERITANCE, NOT A LINE HERE --
    # worth stating because every OTHER var this script writes is read by the CLIENT, and this one
    # is the first that the SERVER also needs in its own environment. `env VAR=val cmd` (below)
    # only OVERRIDES the vars it names; everything else, including SYNC_ADMIN_TOKEN, passes through
    # from whatever shell invoked `bin/sync-server start` -- which is why the documented sequence
    # is `set -a; . tmp/sync-server.env; set +a` BEFORE this command, in the SAME shell. Skip that
    # step and this still boots fine: authenticate_admin! (tinkerex-sync) reads a blank
    # SYNC_ADMIN_TOKEN as "admin provisioning disabled" and 503s just that one door, exactly as
    # designed -- it does not fail the boot.
    #
    # unset_inherited_bundler_env RUNS DIRECTLY HERE, NOT IN A SUBSHELL LIKE `prepare`'S CALLS --
    # deliberately: this is the LAST thing the script does before `exec`, which replaces this
    # process outright, so there is no "after" for a subshell to protect the outer script's env
    # from. See that function's own comment for the full diagnosis this line closes.
    unset_inherited_bundler_env
    exec env STORAGE_BACKEND=local bin/rails server -p "$PORT" -b 127.0.0.1
    ;;
  *)
    usage
    exit 64
    ;;
esac
