#!/usr/bin/env bash
# BOOT A LOCAL tinkerex-sync SERVER -- the Rust binary (crates/tinkerex-sync in the sibling
# checkout), its one implementation since Phase 6 deleted the Ruby host (2026-10-14) -- for local
# chunk_remote work and for `bin/ci test-chunk-remote`.
#
# WHY A SIBLING CHECKOUT: the binary is built from source with cargo, and a checkout is where the
# source is -- the same ../tinkerex-client convention scripts/r2-cutover/smoke.sh already uses.
#
# TWO SUBCOMMANDS, because CI has to background the boot and still know the token:
#   prepare  build the binary, migrate its DB, mint a device token AND a fresh SYNC_ADMIN_TOKEN
#            (Arc C's admin-provisioning credential, distinct from the device token -- see the
#            `prepare` case's own comment), write both into tmp/sync-server.env, print it redacted
#   start    run the server in the FOREGROUND on $SYNC_PORT (the caller backgrounds it)
#
# THE SERVER HAS /up (crates/tinkerex-sync/src/http/handlers.rs `up`) -- and it is not a static
# 200: it counts the users table and answers 503 when it cannot, because this server's first real
# deploy reported healthy with no tables. A caller waiting on this server should probe BOTH /up and
# an authenticated GET /v1/devices/whoami, because they answer different questions -- /up says
# "there is a schema and I can reach it," whoami says "and the credential I just minted is
# accepted." A bare port check says neither. THIS SCRIPT IMPLEMENTS NEITHER PROBE -- prepare and
# start do not curl anything. This paragraph is guidance for the CALLER (CI, and a human), which is
# exactly why it has to stay true.
set -euo pipefail

PORT="${SYNC_PORT:-3002}"
EMAIL="${SYNC_EMAIL:-maker@example.com}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
SYNC_DIR="${TINKEREX_SYNC_DIR:-$REPO_ROOT/../tinkerex-sync}"
# ONE IMPLEMENTATION. SYNC_IMPL chose between the binary and the Ruby host/ until Phase 6 deleted
# the Ruby; there is nothing left to choose. `rust`, the cutover-era spelling, still means the
# binary. Anything else is REFUSED, not ignored: the one other value anyone would type is `ruby`,
# and ignoring it would grade the Rust server while the caller believed they were testing the Ruby
# one. tinkerex-sync's own bin/build-and-push refuses it the same way, for the same reason.
case "${SYNC_IMPL:-rust}" in
  rust) ;;
  *)
    echo "SYNC_IMPL='$SYNC_IMPL': bin/sync-server boots only the Rust binary since Phase 6 deleted the Ruby host (2026-10-14); unset SYNC_IMPL." >&2
    exit 64
    ;;
esac
# WHERE CARGO PUTS THE BINARY: under $CARGO_TARGET_DIR when it is set -- relative to the directory
# cargo runs in, the checkout, which is cargo's own rule -- else under the checkout's target/.
# ci.yml's test-chunk-remote job sets it to a directory the runner keeps, and a developer may export
# one for every project; ignoring it builds the binary in one place and runs it from another. (A
# `build.target-dir` in a cargo config file is not read here -- use the variable.)
CARGO_OUT="${CARGO_TARGET_DIR:-target}"
case "$CARGO_OUT" in /*) ;; *) CARGO_OUT="$SYNC_DIR/$CARGO_OUT" ;; esac
RUST_BIN="${TINKEREX_SYNC_BIN:-$CARGO_OUT/release/tinkerex-sync}"
# The server's own database and chunk directory, under THIS repo's tmp/. The `-rust` in the names
# dates from when two implementations shared this script and had to be kept off each other's files.
RUST_DB="$REPO_ROOT/tmp/sync-server-rust.sqlite3"
RUST_CHUNKS="$REPO_ROOT/tmp/sync-server-rust-chunks"
# A FIXED DEV SECRET, deliberately: SECRET_KEY_BASE only signs this ephemeral server's own local
# blob URLs (an HMAC the client never needs to know), and the binary refuses to boot without one.
# It guards nothing a real deployment guards.
RUST_SECRET_KEY_BASE="sync-server-local-development-secret"
# Overridable so the hermetic happy-path test in test/bin_sync_server_test.rb can point this at
# an isolated tmpdir path instead of the real repo file. A save-and-restore of the real file was
# tried first and rejected: Ruby's `ensure` runs on a normal return or on SIGINT, but NOT on
# SIGKILL, and this suite runs on a PERSISTENT self-hosted runner, not a throwaway CI VM -- a
# test run killed at the wrong moment would leave tmp/sync-server.env corrupted for every run
# after it, not just that one. The default below is unchanged, so an unset var changes nothing.
ENV_FILE="${SYNC_SERVER_ENV_FILE:-$REPO_ROOT/tmp/sync-server.env}"

usage() {
  echo "usage: bin/sync-server {prepare|start}" >&2
  echo "  prepare  build tinkerex-sync, migrate its DB, mint a device token, write tmp/sync-server.env" >&2
  echo "  start    boot the sync server in the foreground on \$SYNC_PORT (default $PORT)" >&2
  echo "  TINKEREX_SYNC_DIR=<checkout> (default ../tinkerex-sync), or TINKEREX_SYNC_BIN=<a built binary>" >&2
}

# ASKS FOR WHAT THE BUILD USES AND NOTHING ELSE: the checkout's Cargo workspace -- or nothing at
# all, when TINKEREX_SYNC_BIN names a built binary.
require_checkout() {
  if [ -n "${TINKEREX_SYNC_BIN:-}" ]; then return; fi
  local needed="$SYNC_DIR/Cargo.toml"
  if [ ! -e "$needed" ]; then
    echo "tinkerex-sync checkout not found: there is no $needed" >&2
    echo "" >&2
    echo "The sync server lives in chaim354/tinkerex-sync. Clone it as a sibling:" >&2
    echo "    gh repo clone chaim354/tinkerex-sync $SYNC_DIR" >&2
    echo "or point this script at an existing checkout:" >&2
    echo "    TINKEREX_SYNC_DIR=/path/to/tinkerex-sync $0 ${1:-prepare}" >&2
    exit 1
  fi
}

# THE BUILD: `cargo build --release` in the sibling checkout, unless TINKEREX_SYNC_BIN names a
# binary already built (CI's cache, or a downloaded release). A missing cargo fails loudly and
# names the fix, the same shape require_checkout uses for a missing clone.
build_rust_binary() {
  if [ -n "${TINKEREX_SYNC_BIN:-}" ]; then
    [ -x "$RUST_BIN" ] || { echo "TINKEREX_SYNC_BIN=$RUST_BIN is not an executable" >&2; exit 1; }
    return
  fi
  command -v cargo >/dev/null 2>&1 || {
    echo "bin/sync-server needs cargo on PATH to build tinkerex-sync (rustup.rs), or" >&2
    echo "TINKEREX_SYNC_BIN=/path/to/tinkerex-sync pointing at a built binary" >&2
    exit 1
  }
  ( cd "$SYNC_DIR" && cargo build --release --quiet -p tinkerex-sync )
}

# The env every run of the binary shares: prepare's migrate and device issue, and start's serve.
rust_env() {
  env STORAGE_BACKEND=local \
      SQLITE_DATABASE="$RUST_DB" \
      CHUNK_LOCAL_DIR="$RUST_CHUNKS" \
      SECRET_KEY_BASE="$RUST_SECRET_KEY_BASE" \
      "$RUST_BIN" "$@"
}

case "${1:-}" in
  prepare)
    require_checkout prepare
    mkdir -p "$REPO_ROOT/tmp"
    build_rust_binary
    rust_env migrate >/dev/null
    # `device issue` prints the token ONCE (only a SHA256 digest is stored), on a `device_token:`
    # line written to be parsed by this awk, so it is captured here or never.
    #
    # THIS DEVICE TOKEN IS A LOCAL/CI ARTIFACT, NOT A DEPLOYMENT CREDENTIAL. It exists so
    # config/ci.rb's readiness probe can prove `device issue` actually minted something this
    # ephemeral server accepts (GET /v1/devices/whoami) -- a narrower question than "can a real
    # deployment run." A real chunk_remote deployment's boot guard
    # (lib/library_backend_check.rb's CHUNK_REMOTE_REQUIRED) does NOT require this any more: Arc C
    # moved ordinary traffic to per-user `users.sync_device_token`, provisioned lazily via
    # SYNC_ADMIN_TOKEN below, and the guard now names that instead -- see CHUNK_REMOTE_REQUIRED's
    # own comment for the full history.
    token="$(rust_env device issue --email "$EMAIL" | awk '/^device_token:/ { print $2 }')"
    if [ -z "$token" ]; then
      echo "tinkerex-sync device issue printed no device_token -- refusing to write a blank credential" >&2
      exit 1
    fi

    # SYNC_ADMIN_TOKEN (Arc C): a shared secret BOTH sides of the admin door need to agree on --
    # the sync server compares an inbound bearer against its own SYNC_ADMIN_TOKEN (authorize_admin,
    # crates/tinkerex-sync/src/auth.rs), and FileLayer::ChunkRemote::Provisioning sends one from
    # ENV["SYNC_ADMIN_TOKEN"] on THIS app's side. Unlike CHUNK_REMOTE_TOKEN above, nothing on the
    # server mints this one -- it is a constant-time string compare, nothing issues or digests it --
    # so `prepare` generates the shared value itself, once per boot cycle, the same way a real
    # deployment generates one and puts it in both apps' Kamal secrets (docs/DEPLOY.md §2b).
    admin_token="$(openssl rand -hex 32)"
    if [ -z "$admin_token" ]; then
      echo "openssl rand produced no output -- refusing to write a blank admin credential" >&2
      exit 1
    fi
    {
      echo "CHUNK_REMOTE_URL=http://127.0.0.1:$PORT"
      # The address a signing-in device is handed (D1); chunk_remote refuses to boot without it.
      # This leg is one box, so both addresses are the local server -- on a deployment they differ.
      echo "SYNC_PUBLIC_URL=http://127.0.0.1:$PORT"
      echo "CHUNK_REMOTE_TOKEN=$token"
      echo "SYNC_ADMIN_TOKEN=$admin_token"
    } > "$ENV_FILE"
    # Tokens live only on the box, chmod 600, never in git -- same rule, same words, as
    # ping.env in bin/backup-cron-install: this file holds a live device credential too.
    chmod 600 "$ENV_FILE"
    # PRINTED REDACTED, NOT `cat`: the file is the interface (config/ci.rb sources it), and CI run
    # logs are readable by anyone once the repository is public. Under GitHub Actions the values are
    # also registered as masks, so a later accidental echo is starred out too.
    if [ "${GITHUB_ACTIONS:-}" = "true" ]; then
      echo "::add-mask::$token"
      echo "::add-mask::$admin_token"
    fi
    echo "wrote $ENV_FILE:"
    sed -E 's/^([A-Z_]*TOKEN)=.*/\1=[redacted]/' "$ENV_FILE"
    ;;
  start)
    require_checkout start
    build_rust_binary
    # SYNC_ADMIN_TOKEN REACHES THE SERVER BY ORDINARY ENV INHERITANCE, NOT A LINE HERE -- worth
    # stating because every OTHER var prepare writes is read by the CLIENT, and this one the server
    # needs in its own environment too. `env VAR=val cmd` (below) only OVERRIDES the vars it names;
    # everything else, SYNC_ADMIN_TOKEN included, passes through from the shell that invoked
    # `bin/sync-server start` -- which is why the documented sequence is
    # `set -a; . tmp/sync-server.env; set +a` BEFORE this command, in the SAME shell. Skip that step
    # and the server still boots: it reads a blank SYNC_ADMIN_TOKEN as "the admin door answers 503"
    # (crates/tinkerex-sync/src/config.rs), never as a reason to refuse the boot.
    exec env STORAGE_BACKEND=local \
             SQLITE_DATABASE="$RUST_DB" \
             CHUNK_LOCAL_DIR="$RUST_CHUNKS" \
             SECRET_KEY_BASE="$RUST_SECRET_KEY_BASE" \
             "$RUST_BIN" serve --bind 127.0.0.1 --port "$PORT"
    ;;
  *)
    usage
    exit 64
    ;;
esac
