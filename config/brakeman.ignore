      "code": "current_user.nodes.present.where(:kind => \"file\").where(\"#{exts.size} OR LOWER(name) LIKE ? ESCAPE '\\\\'\", *exts.map do\n like_pattern(e)\n end)",
      "render_path": null,
      "location": {
        "type": "method",
        "class": "FilesController",
        "method": "flat_ext_scope"
