<?xml version="1.0" encoding="UTF-8"?>
<!-- A PLATE WITH A HOLE THROUGH IT — the one shape of document that can test hit-test paint order.
     In the dialect real LightBurn writes (see real-export.lbrn2).

     Both contours are CLOSED and share a centre, so a click at the middle lands inside BOTH:
       plate   Rect 60 x 40 at the origin  -> x -30..30, y -20..20   area 2400 mm^2
       hole    bezier circle r=5, same centre -> x  -5..5, y  -5..5   area  100 mm^2

     That containment is the entire point, and it is what bezier-circle.lbrn2 cannot provide: its
     circle and square are equal-area AND disjoint, so neither ever covers the other and the paint
     order that decides which one a click selects is unobservable. measure_controller.js
     appends contours in DESCENDING bbox-area order precisely so the browser's own topmost-wins
     dispatch picks the SMALLEST shape containing the pointer — sort the other way and a hole
     inside a plate becomes unclickable, silently, with every existing test still green.

     Deliberately very different areas (24x) so the ordering is unambiguous rather than a tie-break. -->
<LightBurnProject AppVersion="1.6.00" FormatVersion="1" MaterialHeight="0">
    <CutSetting type="Cut">
        <index Value="0"/>
        <name Value="C00"/>
        <speed Value="20"/>
        <maxPower Value="80"/>
    </CutSetting>
    <!-- The hole is on a DIFFERENT layer, and index 2 specifically: LightBurn paints C02 red,
         so a drawing that fell back to a default stroke instead of consulting the palette is
         distinguishable. On C00 it would not be — that layer is black, the same as the
         fallback, and a test written against it passes either way. -->
    <CutSetting type="Cut">
        <index Value="2"/>
        <name Value="C02"/>
        <speed Value="35"/>
        <maxPower Value="60"/>
    </CutSetting>
    <Shape Type="Rect" CutIndex="0" W="60" H="40" Cr="0">
        <XForm>1 0 0 1 0 0</XForm>
    </Shape>
    <Shape Type="Path" CutIndex="2" VertID="1" PrimID="1">
        <XForm>1 0 0 1 0 0</XForm>
        <VertList>V5 0c0x5c0y2.7615c1x5c1y-2.7615V0 5c0x-2.7615c0y5c1x2.7615c1y5V-5 0c0x-5c0y-2.7615c1x-5c1y2.7615V0 -5c0x2.7615c0y-5c1x-2.7615c1y-5</VertList>
        <PrimList>B0 1B1 2B2 3B3 0</PrimList>
    </Shape>
</LightBurnProject>
