<?xml version="1.0" encoding="UTF-8"?>
<!-- A MillMage export in the dialect the application ACTUALLY writes (verified against a real
     0.8.01 file, catan5-21-26-v1.mage: 62 Shape / 62 XForm / 59 VertList / 15 PrimList).

     THE GEOMETRY DIALECT IS THE SAME ONE LIGHTBURN WRITES — <XForm> as a child element,
     "V<x> <y>c0x.." vert lists, L/B/LineClosed prims, VertID/PrimID instancing. Measured on
     that file: XForm-as-element 62 / as-attribute 0, real-dialect vert lists 59 / old-style 0.
     So `Lbrn2`'s walker parses a .mage byte-for-byte; see the note in mage.rb.

     What DIFFERS is everything around the geometry:
       * shapes carry `OpIndex` / `LayerIndex`, never LightBurn's `CutIndex`;
       * settings live in <Operation type=".." Shapes="..">, not <CutSetting>, and each holds a
         <ToolDef> (an endmill) plus operation-level values that OVERRIDE the tool's defaults;
       * `finalDepth` has no LightBurn analogue at all — it is the total cut depth, and with
         passDepth it is what tells you how many passes the job takes.

     Geometry is chosen so the bounding box is exactly 100 x 60 mm:
       Path     x 0..100, y 0..40
       Ellipse  x 40..60,  y 40..60
-->
<MillMageProject AppVersion="0.8.01" DeviceName="lowrider v4" FormatVersion="1" MaterialHeight="12" MirrorX="False" MirrorY="False">
    <Operation type="Pocket" Shapes="0 1">
        <ToolDef>
            <name Value="1.5 mm endmil"/>
            <type Value="End Mill"/>
            <index Value="0"/>
            <diameter Value="1.5000000000000000"/>
            <fluteCount Value="2"/>
            <feedRate Value="14.8000001907348633"/>
            <plungeRate Value="8.0000000000000000"/>
            <spindleSpeed Value="20000.0000000000000000"/>
            <passDepth Value="1.0000000000000000"/>
            <stepOver Value="0.6000000238418579"/>
        </ToolDef>
        <coolant Value="0"/>
        <cutDirection Value="1"/>
        <feedRate Value="14.8"/>
        <finalDepth Value="2"/>
        <name Value="Pocket"/>
        <passDepth Value="1"/>
        <plungeRate Value="8"/>
        <spindleSpeed Value="20000"/>
    </Operation>
    <Shape Type="Path" OpIndex="0" LayerIndex="0" VertID="3" PrimID="1">
        <XForm>1 0 0 1 0 0</XForm>
        <VertList>V0 0c0x1c1x1V100 0c0x1c1x1V100 40c0x1c1x1</VertList>
        <PrimList>L0 1L1 2</PrimList>
    </Shape>
    <Shape Type="Ellipse" OpIndex="0" LayerIndex="0" Rx="10" Ry="10">
        <XForm>1 0 0 1 50 50</XForm>
    </Shape>
</MillMageProject>
